@model List<SupportTicketSysterm.Models.MessageViewModel>
@{
    string currentUserRole = (string)(ViewData["CurrentUserRole"] ?? "");
    DateTime? lastDate = null;
}

@if (Model == null || !Model.Any())
{
    <div class="chat-empty-state py-5 text-center my-auto d-flex flex-column align-items-center justify-content-center h-100">
        <div class="empty-icon-wrap mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle shadow-xs" style="width: 64px; height: 64px; background: rgba(215, 25, 32, 0.08); color: #D71920;">
            <i class="bi bi-chat-dots-fill fs-2"></i>
        </div>
        <h5 class="fw-bold text-dark mb-1">Chưa có tin nhắn nào</h5>
        <p class="text-muted small mb-0" style="max-width:360px;">Bắt đầu cuộc trò chuyện bằng cách nhập nội dung tin nhắn bên dưới.</p>
    </div>
}
else
{
    @foreach (var msg in Model)
    {
        var msgDate = msg.ThoiGian.Date;
        if (!lastDate.HasValue || lastDate.Value != msgDate)
        {
            string dateLabel = msgDate == DateTime.Today ? "Hôm nay" : (msgDate == DateTime.Today.AddDays(-1) ? "Hôm qua" : msgDate.ToString("dd/MM/yyyy"));
            <div class="chat-date-separator text-center my-3">
                <span class="chat-date-text px-3 py-1 bg-white border rounded-pill text-muted small fw-semibold shadow-xs" style="font-size:0.75rem; color:#64748B;">@dateLabel</span>
            </div>
            lastDate = msgDate;
        }

        bool isOutgoing = (currentUserRole == "KhachHang" && msg.LoaiNguoiGui == "KhachHang") ||
                          (currentUserRole != "KhachHang" && msg.LoaiNguoiGui == "NhanVien");
        bool isAi = msg.LoaiNguoiGui == "AI";

        string senderTitle = isAi ? "Trợ lý Kỹ Thuật AI" : (msg.LoaiNguoiGui == "NhanVien" ? "Kỹ thuật viên Viettel" : "Khách hàng");

        if (isOutgoing)
        {
            <!-- Outgoing Customer Message (Right side - Zalo Viettel Red Gradient) -->
            <div class="chat-message-row client animate-message-appear d-flex justify-content-end mb-3" data-id="@msg.IdTinNhan" style="width:100%;">
                <div class="chat-message-wrapper d-flex flex-column align-items-end" style="max-width: 70%;">
                    <div class="chat-message-item text-white shadow-sm" 
                         style="background: linear-gradient(135deg, #E60012 0%, #FF4D4F 100%) !important; color: #FFFFFF !important; border-radius: 18px 18px 4px 18px !important; padding: 11px 18px !important; font-size: 0.92rem !important; line-height: 1.5 !important; word-break: break-word !important; box-shadow: 0 4px 14px rgba(230, 0, 18, 0.18) !important;">
                        @if (msg.Files != null && msg.Files.Any())
                        {
                            @foreach (var file in msg.Files)
                            {
                                var ext = System.IO.Path.GetExtension(file.TenFile ?? "").ToLower();
                                var isImg = file.LoaiFile.StartsWith("image/") || ext == ".jpg" || ext == ".png" || ext == ".jpeg" || ext == ".gif" || ext == ".webp";
                                if (isImg)
                                {
                                    <div class="chat-message-image mb-2">
                                        <img src="@file.DuongDan" alt="@file.TenFile" class="rounded-3 border border-light shadow-sm" style="max-width:280px; max-height: 240px; object-fit: cover;" />
                                    </div>
                                }
                                else
                                {
                                    <div class="border-0 rounded-3 p-2.5 bg-white bg-opacity-25 text-white mb-2 d-flex align-items-center gap-2" style="min-width:210px;">
                                        <i class="bi bi-file-earmark-arrow-down-fill fs-3"></i>
                                        <div class="text-truncate flex-grow-1">
                                            <span class="fw-semibold small d-block text-truncate">@file.TenFile</span>
                                            <a href="@file.DuongDan" class="text-white text-decoration-underline" download="@file.TenFile" style="font-size:0.75rem;">Tải về <i class="bi bi-download ms-1"></i></a>
                                        </div>
                                    </div>
                                }
                            }
                        }
                        @if (!string.IsNullOrEmpty(msg.NoiDung) && !msg.NoiDung.StartsWith("[Đính kèm tệp:"))
                        {
                            <div class="message-text">@FormatMessageContent(msg.NoiDung)</div>
                        }
                    </div>
                    
                    <!-- Timestamp & Seen Status below bubble -->
                    <div class="chat-message-meta text-end mt-1 d-flex align-items-center justify-content-end gap-1.5" style="font-size: 11.5px; color: #94A3B8;">
                        <span>@msg.ThoiGian.ToString("HH:mm")</span>
                        <span class="seen-indicator fw-bold" style="color:#22C55E;">✓✓ Đã nhận</span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <!-- Incoming Staff / AI Message (Left side - Zalo Crisp White Card) -->
            <div class="chat-message-row staff animate-message-appear d-flex justify-content-start align-items-start gap-2.5 mb-3" data-id="@msg.IdTinNhan" style="width:100%;">
                <!-- Staff Avatar Icon -->
                <div class="chat-avatar flex-shrink-0 text-white fw-bold shadow-xs mt-1" 
                     style="background: @(isAi ? "#F59E0B" : "linear-gradient(135deg, #E60012 0%, #FF4D4F 100%)"); width:36px; height:36px; border-radius:50%; display:grid; place-items:center; font-size:0.85rem; border:1px solid #FFFFFF;">
                    @if (isAi)
                    {
                        <i class="bi bi-robot"></i>
                    }
                    else
                    {
                        <i class="bi bi-headset"></i>
                    }
                </div>
                
                <div class="chat-message-wrapper d-flex flex-column align-items-start" style="max-width: @(isAi ? "78%" : "70%");">
                    <div class="chat-message-sender-name fw-bold mb-1 text-secondary" style="font-size:0.75rem;">
                        @(isAi ? "Trợ lý Kỹ Thuật AI" : "Kỹ thuật viên Viettel")
                    </div>
                    
                    <div class="chat-message-item shadow-sm" 
                         style="background-color: @(isAi ? "#FFF6E8" : "#FFFFFF") !important; color: #1E293B !important; border: 1px solid @(isAi ? "#FDE68A" : "#ECECEC") !important; border-radius: 18px 18px 18px 4px !important; padding: 11px 18px !important; font-size: 0.92rem !important; line-height: 1.5 !important; word-break: break-word !important; box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03) !important;">
                        @if (msg.Files != null && msg.Files.Any())
                        {
                            @foreach (var file in msg.Files)
                            {
                                var ext = System.IO.Path.GetExtension(file.TenFile ?? "").ToLower();
                                var isImg = file.LoaiFile.StartsWith("image/") || ext == ".jpg" || ext == ".png" || ext == ".jpeg" || ext == ".gif" || ext == ".webp";
                                if (isImg)
                                {
                                    <div class="chat-message-image mb-2">
                                        <img src="@file.DuongDan" alt="@file.TenFile" class="rounded-3 border shadow-sm" style="max-width:280px; max-height: 240px; object-fit: cover;" />
                                    </div>
                                }
                                else
                                {
                                    <div class="border rounded-3 p-2.5 bg-light text-dark mb-2 d-flex align-items-center gap-2" style="min-width:210px;">
                                        <i class="bi bi-file-earmark-zip-fill fs-3 text-danger"></i>
                                        <div class="text-truncate flex-grow-1">
                                            <span class="fw-semibold small d-block text-truncate">@file.TenFile</span>
                                            <a href="@file.DuongDan" class="text-danger fw-bold text-decoration-none" download="@file.TenFile" style="font-size:0.75rem;">Tải về <i class="bi bi-download ms-1"></i></a>
                                        </div>
                                    </div>
                                }
                            }
                        }
                        @if (!string.IsNullOrEmpty(msg.NoiDung) && !msg.NoiDung.StartsWith("[Đính kèm tệp:"))
                        {
                            @FormatMessageContent(msg.NoiDung)
                        }
                    </div>

                    <!-- Timestamp below bubble -->
                    <div class="chat-message-meta text-start mt-1" style="font-size: 11.5px; color: #94A3B8;">
                        <span>@msg.ThoiGian.ToString("HH:mm")</span>
                    </div>
                </div>
            </div>
        }
    }
}

@functions {
    public Microsoft.AspNetCore.Html.IHtmlContent FormatMessageContent(string? content)
    {
        if (string.IsNullOrEmpty(content))
        {
            return Microsoft.AspNetCore.Html.HtmlString.Empty;
        }

        // 1. HTML encode first to prevent XSS
        var encoded = System.Net.WebUtility.HtmlEncode(content);

        // 2. Parse custom action ticket card tag: [XEM_CHI_TIET_PHIEU|IdPhieu=X|MaPhieu=Y]
        var ticketMarker = "[XEM_CHI_TIET_PHIEU|";
        if (encoded.Contains(ticketMarker))
        {
            int tIndex = encoded.IndexOf(ticketMarker);
            int eIndex = encoded.IndexOf("]", tIndex);
            if (eIndex > tIndex)
            {
                var fullTag = encoded.Substring(tIndex, eIndex - tIndex + 1);
                var inner = fullTag.Replace("[XEM_CHI_TIET_PHIEU|", "").Replace("]", "");
                var tokens = inner.Split('|');
                
                string idPhieu = "";
                string maPhieu = "";
                foreach (var token in tokens)
                {
                    var kv = token.Split('=');
                    if (kv.Length == 2)
                    {
                        if (kv[0].Trim() == "IdPhieu") idPhieu = kv[1].Trim();
                        else if (kv[0].Trim() == "MaPhieu") maPhieu = kv[1].Trim();
                    }
                }

                var cardHtml = $@"
<div class='ticket-success-card border-0 rounded-4 p-3 mt-3 bg-white shadow-sm' style='border-left: 4px solid #D71920 !important;'>
    <div class='d-flex align-items-center mb-2'>
        <i class='bi bi-patch-check-fill text-danger fs-4 me-2'></i>
        <h6 class='m-0 fw-bold text-dark' style='font-size:0.9rem;'>Tạo Phiếu Thành Công</h6>
    </div>
    <p class='small text-muted mb-2' style='font-size:0.75rem;'>Hệ thống đã tự động tạo phiếu hỗ trợ kỹ thuật và phân công kỹ sư xử lý.</p>
    <div class='mb-2 small bg-light p-2 rounded-3' style='font-size:0.78rem;'>
        <div class='d-flex justify-content-between mb-1'>
            <span class='text-secondary'>Mã Phiếu:</span>
            <strong class='text-danger'>{maPhieu}</strong>
        </div>
        <div class='d-flex justify-content-between'>
            <span class='text-secondary'>Trạng thái:</span>
            <span class='badge bg-warning-subtle text-warning fw-bold rounded-pill'>Chờ tiếp nhận</span>
        </div>
    </div>
    <a href='/Ticket/ChiTietPhieu/{idPhieu}' class='btn btn-danger btn-sm rounded-pill w-100 fw-bold text-white text-decoration-none d-block text-center py-2 shadow-sm' style='background: linear-gradient(135deg, #D71920 0%, #E53E3E 100%); border:none; font-size:0.8rem;' target='_blank'>
        <i class='bi bi-file-earmark-text-fill me-1'></i> Xem Chi Tiết Phiếu
    </a>
</div>";
                encoded = encoded.Replace(fullTag, cardHtml);
            }
        }

        // 2.5 Parse redirect to create ticket tag: [REDIRECT:CREATE_TICKET|Title=X|Content=Y|CategoryId=C|ServiceId=S|Priority=P]
        var redirectMarker = "[REDIRECT:CREATE_TICKET|";
        if (encoded.Contains(redirectMarker))
        {
            int rIndex = encoded.IndexOf(redirectMarker);
            int rEnd = encoded.IndexOf("]", rIndex);
            if (rEnd > rIndex)
            {
                var fullTag = encoded.Substring(rIndex, rEnd - rIndex + 1);
                var inner = fullTag.Replace("[REDIRECT:CREATE_TICKET|", "").Replace("]", "");
                var tokens = inner.Split('|');
                string title = "", contentTxt = "", catId = "", srvId = "", prio = "";
                foreach (var token in tokens)
                {
                    var kv = token.Split('=');
                    if (kv.Length >= 2)
                    {
                        var k = kv[0].Trim();
                        var v = string.Join("=", kv.Skip(1)).Trim();
                        if (k == "Title") title = v;
                        else if (k == "Content") contentTxt = v;
                        else if (k == "CategoryId") catId = v;
                        else if (k == "ServiceId") srvId = v;
                        else if (k == "Priority") prio = v;
                    }
                }

                string displayTitle = System.Net.WebUtility.HtmlDecode(title ?? "");
                string displayContent = System.Net.WebUtility.HtmlDecode(contentTxt ?? "");
                string encTitle = Uri.EscapeDataString(displayTitle);
                string encContent = Uri.EscapeDataString(displayContent);
                var redirectUrl = $"/Ticket/TaoPhieu?title={encTitle}&content={encContent}&categoryId={catId}&serviceId={srvId}&priority={prio}";
                var btnHtml = $@"
<div class='ticket-creation-card d-block w-100 p-3 rounded-4 mt-3 bg-white border border-danger-subtle shadow-sm' style='clear:both; box-sizing:border-box;'>
    <div class='d-flex align-items-center mb-2'>
        <i class='bi bi-ticket-perforated-fill text-danger fs-4 me-2'></i>
        <h6 class='m-0 fw-bold text-dark' style='font-size:0.88rem;'>Đề Xuất Tạo Phiếu Hỗ Trợ</h6>
    </div>
    <p class='small text-muted mb-3' style='font-size:0.75rem;'>Hệ thống sẽ điền sẵn thông tin bạn vừa trao đổi vào mẫu phiếu hỗ trợ.</p>
    <a href='{redirectUrl}' class='btn btn-danger btn-sm rounded-pill w-100 fw-bold text-white text-decoration-none d-block text-center py-2 shadow-sm' style='background: linear-gradient(135deg, #D71920 0%, #E53E3E 100%); border:none; font-size:0.8rem;'>
        <i class='bi bi-plus-circle-fill me-1'></i> Chuyển Sang Trang Tạo Phiếu
    </a>
</div>";
                encoded = encoded.Replace(fullTag, btnHtml);
            }
        }

        // 2.6 Parse Intent Detection Tag: [INTENT_TAG|{json}]
        var intentMarker = "[INTENT_TAG|";
        if (encoded.Contains(intentMarker))
        {
            int iIndex = encoded.IndexOf(intentMarker);
            int iEnd = encoded.IndexOf("]", iIndex);
            if (iEnd > iIndex)
            {
                var fullTag = encoded.Substring(iIndex, iEnd - iIndex + 1);
                var jsonStr = fullTag.Replace("[INTENT_TAG|", "").Replace("]", "");
                var scriptInject = $"<script>try {{ window.dispatchEvent(new CustomEvent('ai_intent_detected', {{ detail: {jsonStr} }})); }} catch(e){{}}</script>";
                encoded = encoded.Replace(fullTag, scriptInject);
            }
        }

        // 2.7 Parse Service Card Tag: [SHOW_SERVICE_CARD|ServiceId=X]
        var serviceCardMarker = "[SHOW_SERVICE_CARD|";
        if (encoded.Contains(serviceCardMarker))
        {
            int scIndex = encoded.IndexOf(serviceCardMarker);
            int scEnd = encoded.IndexOf("]", scIndex);
            if (scEnd > scIndex)
            {
                var fullTag = encoded.Substring(scIndex, scEnd - scIndex + 1);
                var sIdStr = fullTag.Replace("[SHOW_SERVICE_CARD|ServiceId=", "").Replace("]", "").Trim();
                var cardHtml = $@"
<div class='ai-service-card-slot d-block w-100 p-3 rounded-4 mt-3 bg-white border border-danger-subtle shadow-sm' data-service-id='{sIdStr}' style='clear:both; box-sizing:border-box;'>
    <div class='d-flex align-items-center mb-2'>
        <i class='bi bi-hdd-network-fill text-danger fs-4 me-2'></i>
        <h6 class='m-0 fw-bold text-dark' style='font-size:0.9rem;'>Thông Tin Dịch Vụ Viettel</h6>
    </div>
    <div class='service-card-loading text-center py-3 text-muted small'>
        <i class='fa-solid fa-circle-notch fa-spin me-2 text-danger'></i>Đang tải thông tin dịch vụ từ SQL Server...
    </div>
</div>";
                encoded = encoded.Replace(fullTag, cardHtml);
            }
        }

        // 2.8 Parse Appointment Slots Tag: [SHOW_APPOINTMENT_SLOTS|ServiceId=X]
        var slotMarker = "[SHOW_APPOINTMENT_SLOTS|";
        if (encoded.Contains(slotMarker))
        {
            int slIndex = encoded.IndexOf(slotMarker);
            int slEnd = encoded.IndexOf("]", slIndex);
            if (slEnd > slIndex)
            {
                var fullTag = encoded.Substring(slIndex, slEnd - slIndex + 1);
                var slotsHtml = @"
<div class='ai-appointment-slots-card p-3 bg-white border border-danger-subtle rounded-4 mt-3 shadow-sm' style='clear:both;'>
    <div class='d-flex align-items-center mb-2'>
        <i class='bi bi-calendar-check-fill text-danger fs-4 me-2'></i>
        <h6 class='m-0 fw-bold text-dark' style='font-size:0.9rem;'>Đề Xuất Lịch Hẹn Kỹ Thuật Tại Nhà</h6>
    </div>
    <p class='small text-muted mb-2' style='font-size:0.78rem;'>Chọn khung giờ phù hợp để kỹ thuật viên Viettel đến kiểm tra tận nơi:</p>
    <div class='d-flex flex-wrap gap-2 my-2'>
        <button type='button' class='btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 fw-bold btn-slot-item' onclick='selectAiAppointmentSlot(""08:00"", this)'>08:00 Sáng</button>
        <button type='button' class='btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 fw-bold btn-slot-item' onclick='selectAiAppointmentSlot(""10:00"", this)'>10:00 Sáng</button>
        <button type='button' class='btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 fw-bold btn-slot-item' onclick='selectAiAppointmentSlot(""14:00"", this)'>14:00 Chiều</button>
        <button type='button' class='btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 fw-bold btn-slot-item' onclick='selectAiAppointmentSlot(""16:00"", this)'>16:00 Chiều</button>
    </div>
</div>";
                encoded = encoded.Replace(fullTag, slotsHtml);
            }
        }

        // 2.8.5 Parse Action Buttons Tag: [ACTION_BUTTONS]
        var actionButtonsMarker = "[ACTION_BUTTONS]";
        if (encoded.Contains(actionButtonsMarker))
        {
            var btnHtml = @"
<div class='mt-2.5 d-flex flex-wrap align-items-center gap-2 action-buttons-group'>
    <a href='/Ticket/TaoPhieu' class='btn btn-danger btn-sm rounded-pill fw-bold text-white px-3 py-1.5 text-center text-decoration-none shadow-xs' style='background: linear-gradient(135deg, #D71920 0%, #E53935 100%); border:none; font-size:0.8rem;'>
        <i class='bi bi-file-earmark-plus-fill me-1'></i> Tạo Phiếu Hỗ Trợ
    </a>
    <button type='button' class='btn btn-outline-danger btn-sm rounded-pill fw-bold px-3 py-1.5 text-center btn-transfer-staff shadow-xs' style='font-size:0.8rem; background-color:#FFFFFF; color:#D71920; border: 1px solid #D71920;' onclick='if(window.TechSupportChat && window.TechSupportChat.transferToStaff) window.TechSupportChat.transferToStaff();'>
        <i class='bi bi-headset me-1'></i> Chat Với Nhân Viên Kỹ Thuật
    </button>
</div>";
            encoded = encoded.Replace(actionButtonsMarker, btnHtml);
        }

        // 2.8.6 Parse Action Require Login Tag: [ACTION_REQUIRE_LOGIN]
        var actionRequireLoginMarker = "[ACTION_REQUIRE_LOGIN]";
        if (encoded.Contains(actionRequireLoginMarker))
        {
            var loginCardHtml = @"
<div class='card border-0 shadow-sm rounded-4 overflow-hidden bg-white p-3 border-danger-subtle mt-3' style='border: 1px solid #fee2e2 !important;'>
    <div class='d-flex align-items-center mb-2 text-danger fw-bold'>
        <i class='bi bi-lock-fill me-2 fs-5'></i> 🔒 Cần Đăng Nhập
    </div>
    <p class='small text-dark mb-3' style='font-size:0.85rem;'>Để tạo phiếu hỗ trợ và sắp xếp kỹ thuật viên, vui lòng đăng nhập tài khoản của bạn.</p>
    <div class='d-flex gap-2'>
        <a href='/Auth/DangNhap' class='btn btn-danger btn-sm rounded-pill fw-bold text-white px-3 py-2 text-decoration-none shadow-sm' style='background-color:#D71920; border-color:#D71920;'>
            <i class='bi bi-box-arrow-in-right me-1'></i> Đăng nhập
        </a>
        <a href='/Auth/DangKy' class='btn btn-outline-danger btn-sm rounded-pill fw-bold px-3 py-2 text-decoration-none shadow-sm'>
            <i class='bi bi-person-plus-fill me-1'></i> Đăng ký
        </a>
    </div>
</div>";
            encoded = encoded.Replace(actionRequireLoginMarker, loginCardHtml);
        }

        // 2.8.7 Parse Confirm Create Ticket Tag: [CONFIRM_CREATE_TICKET|...]
        var confirmTicketRegex = new System.Text.RegularExpressions.Regex(@"\[CONFIRM_CREATE_TICKET\|(.*?)\]", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        var confirmMatch = confirmTicketRegex.Match(encoded);
        if (confirmMatch.Success)
        {
            var fullTag = confirmMatch.Value;
            var innerContent = confirmMatch.Groups[1].Value;
            
            string title = "Sự cố kỹ thuật";
            string categoryIdStr = "1";
            string serviceIdStr = "1";
            string address = "";
            string ticketContent = "Cần hỗ trợ kiểm tra kỹ thuật";

            // Parse key-value parts separated by '|'
            var parts = innerContent.Split('|');
            foreach (var part in parts)
            {
                var trimmed = part.Trim();
                if (string.IsNullOrEmpty(trimmed)) continue;

                var eqIdx = trimmed.IndexOf('=');
                if (eqIdx > 0)
                {
                    var key = trimmed.Substring(0, eqIdx).Trim().ToLower();
                    var val = trimmed.Substring(eqIdx + 1).Trim();

                    if (key == "title" && !string.IsNullOrEmpty(val)) title = val;
                    else if (key == "categoryid" && !string.IsNullOrEmpty(val)) categoryIdStr = val;
                    else if (key == "serviceid" && !string.IsNullOrEmpty(val)) serviceIdStr = val;
                    else if (key == "address" && !string.IsNullOrEmpty(val)) address = val;
                    else if (key == "content" && !string.IsNullOrEmpty(val)) ticketContent = val;
                }
            }

            if (!int.TryParse(categoryIdStr, out int catId) || catId <= 0) categoryIdStr = "1";
            if (!int.TryParse(serviceIdStr, out int srvId) || srvId <= 0) serviceIdStr = "1";

            string encodedTitle = System.Net.WebUtility.HtmlEncode(title);
            string encodedAddress = System.Net.WebUtility.HtmlEncode(address);
            string displayAddress = string.IsNullOrWhiteSpace(address) ? "Tại địa chỉ đăng ký" : encodedAddress;
            string encodedTicketContent = System.Net.WebUtility.HtmlEncode(ticketContent);

            var cardHtml = $@"
<div class='ai-confirm-ticket-card card border-0 shadow-sm rounded-4 overflow-hidden bg-white p-3 border-danger-subtle mt-3' style='border: 1px solid #fee2e2 !important;'>
    <div class='d-flex align-items-center mb-2 text-danger fw-bold'>
        <i class='bi bi-file-earmark-plus-fill me-2 fs-5'></i> 📋 Xác Nhận Tạo Phiếu Hỗ Trợ
    </div>
    <div class='small text-dark mb-3' style='font-size:0.85rem; line-height: 1.6;'>
        <div>• <strong>Sự cố:</strong> <span class='text-danger fw-bold'>{encodedTitle}</span></div>
        <div>• <strong>Địa chỉ hỗ trợ:</strong> <span class='fw-bold'>{displayAddress}</span></div>
    </div>
    <div class='d-flex flex-wrap gap-2'>
        <button type='button' class='btn btn-danger btn-sm rounded-pill fw-bold text-white px-3 py-2 btn-confirm-create-ticket shadow-sm' style='background-color:#D71920; border-color:#D71920;' onclick='if(window.confirmCreateTicket) window.confirmCreateTicket(this, ""{encodedTitle}"", {categoryIdStr}, {serviceIdStr}, ""{encodedAddress}"", ""{encodedTicketContent}"");'>
            <i class='bi bi-check-circle-fill me-1'></i> Tạo phiếu hỗ trợ
        </button>
        <a href='/Ticket/TaoPhieu?serviceId={serviceIdStr}&categoryId={categoryIdStr}' class='btn btn-outline-secondary btn-sm rounded-pill px-3 py-2 text-decoration-none'>
            <i class='bi bi-pencil-square me-1'></i> Chỉnh sửa thông tin
        </a>
        <button type='button' class='btn btn-outline-danger btn-sm rounded-pill px-3 py-2' onclick='if(window.cancelConfirmTicket) window.cancelConfirmTicket(this);'>
            <i class='bi bi-x-circle me-1'></i> Hủy
        </button>
    </div>
</div>";
            encoded = encoded.Replace(fullTag, cardHtml);
        }

        // 3. Parse bold Markdown: **text** -> <strong>text</strong>
        encoded = System.Text.RegularExpressions.Regex.Replace(encoded, @"\*\*(.*?)\*\*", "<strong>$1</strong>");

        // 4. Parse Markdown links: [Text](URL) -> <a href="URL" target="_blank">Text</a>
        encoded = System.Text.RegularExpressions.Regex.Replace(encoded, @"\[(.*?)\]\((.*?)\)", "<a href=\"$2\" target=\"_blank\" class=\"fw-bold text-danger text-decoration-underline\">$1</a>");

        // 5. Convert line breaks
        encoded = encoded.Replace("\n", "<br />");

        return new Microsoft.AspNetCore.Html.HtmlString(encoded);
    }
}


