@model SupportTicketSysterm.Models.MessageViewModel
@*
    _SingleAiMessage.cshtml
    Renders a single AI response bubble for optimistic UI append.
    Used by ChatAI_GetAiResponse endpoint to return only the new AI message
    instead of the entire chat history.
*@

<div class="chat-message-item msg-row incoming received ai-message">
    <div class="message-avatar msg-avatar robot-avatar">
        <i class="bi bi-robot"></i>
    </div>
    <div class="message-content msg-bubble-wrapper">
        <div class="viettel-bubble msg-bubble">
            @if (!string.IsNullOrEmpty(Model.NoiDung))
            {
                <div class="message-text">@FormatMessageContent(Model.NoiDung)</div>
            }

            @if (Model.Files != null && Model.Files.Any())
            {
                <div class="message-files-grid mt-2" style="display: grid; gap: 8px;">
                    @foreach (var file in Model.Files)
                    {
                        var isImg = file.LoaiFile.StartsWith("image/") || file.TenFile.EndsWith(".jpg") || file.TenFile.EndsWith(".png") || file.TenFile.EndsWith(".jpeg");
                        <div class="message-file-card border rounded p-2 bg-white d-flex align-items-center gap-2">
                            <div class="file-icon-wrap @(isImg ? "image" : "document")">
                                @if (isImg)
                                {
                                    <i class="bi bi-file-image-fill text-danger fs-4"></i>
                                }
                                else
                                {
                                    <i class="bi bi-file-earmark-zip-fill text-primary fs-4"></i>
                                }
                            </div>
                            <div class="file-info text-truncate">
                                <div class="file-name text-truncate fw-semibold text-dark" title="@file.TenFile" style="font-size:0.82rem;">@file.TenFile</div>
                                <a href="@file.DuongDan" class="file-dl-link text-decoration-none" download="@file.TenFile" style="font-size:0.75rem; font-weight:700;">
                                    Tải về <i class="bi bi-download"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="time">
            @Model.ThoiGian.ToString("HH:mm")
        </div>
    </div>
</div>

@functions {
    public Microsoft.AspNetCore.Html.IHtmlContent FormatMessageContent(string? content)
    {
        if (string.IsNullOrEmpty(content))
        {
            return Microsoft.AspNetCore.Html.HtmlString.Empty;
        }

        // 1. HTML encode first to prevent XSS
        var encoded = System.Net.WebUtility.HtmlEncode(content);

        // 2. Parse custom action ticket card tag: [XEM_CHI_TIET_PHIEU|IdPhieu=X|MaPhieu=Y]
        var ticketMarker = "[XEM_CHI_TIET_PHIEU|";
        if (encoded.Contains(ticketMarker))
        {
            int tIndex = encoded.IndexOf(ticketMarker);
            int eIndex = encoded.IndexOf("]", tIndex);
            if (eIndex > tIndex)
            {
                var fullTag = encoded.Substring(tIndex, eIndex - tIndex + 1);
                var inner = fullTag.Replace("[XEM_CHI_TIET_PHIEU|", "").Replace("]", "");
                var tokens = inner.Split('|');
                
                string idPhieu = "";
                string maPhieu = "";
                foreach (var token in tokens)
                {
                    var kv = token.Split('=');
                    if (kv.Length == 2)
                    {
                        if (kv[0].Trim() == "IdPhieu") idPhieu = kv[1].Trim();
                        else if (kv[0].Trim() == "MaPhieu") maPhieu = kv[1].Trim();
                    }
                }

                var cardHtml = $@"
<div class='ticket-success-card border rounded-3 p-3 mt-3 bg-white shadow-sm' style='border-left: 4px solid #D71920 !important;'>
    <div class='d-flex align-items-center mb-2'>
        <i class='bi bi-patch-check-fill text-success fs-4 me-2'></i>
        <h6 class='m-0 fw-bold text-dark' style='font-size:0.9rem;'>Tạo Phiếu Thành Công</h6>
    </div>
    <p class='small text-muted mb-2' style='font-size:0.75rem;'>Hệ thống đã tự động tạo phiếu hỗ trợ kỹ thuật và phân công kỹ sư xử lý.</p>
    <div class='mb-2 small bg-light p-2 rounded' style='font-size:0.78rem;'>
        <div class='d-flex justify-content-between mb-1'>
            <span class='text-secondary'>Mã Phiếu:</span>
            <strong class='text-dark'>{maPhieu}</strong>
        </div>
        <div class='d-flex justify-content-between'>
            <span class='text-secondary'>Trạng thái:</span>
            <span class='badge bg-warning-subtle text-warning fw-bold'>Chờ tiếp nhận</span>
        </div>
    </div>
    <a href='/Ticket/ChiTietPhieu/{idPhieu}' class='btn btn-danger btn-sm rounded-pill w-100 fw-bold text-white text-decoration-none d-block text-center py-2' style='background-color:#D71920; border-color:#D71920; font-size:0.8rem;' target='_blank'>
        <i class='bi bi-file-earmark-text-fill me-1'></i> Xem Chi Tiết Phiếu
    </a>
</div>";
                encoded = encoded.Replace(fullTag, cardHtml);
            }
        }

        // 2.5 Parse redirect to create ticket tag
        var redirectMarker = "[REDIRECT:CREATE_TICKET|";
        if (encoded.Contains(redirectMarker))
        {
            int rIndex = encoded.IndexOf(redirectMarker);
            int erIndex = encoded.IndexOf("]", rIndex);
            if (erIndex > rIndex)
            {
                var fullTag = encoded.Substring(rIndex, erIndex - rIndex + 1);
                var inner = fullTag.Replace("[REDIRECT:CREATE_TICKET|", "").Replace("]", "");
                var tokens = inner.Split('|');
                
                string title = "";
                string contentText = "";
                string categoryId = "";
                string serviceId = "";
                string priority = "";
                foreach (var token in tokens)
                {
                    var kv = token.Split('=');
                    if (kv.Length >= 2)
                    {
                        var key = kv[0].Trim();
                        var val = string.Join("=", kv.Skip(1)).Trim();
                        if (key == "Title") title = val;
                        else if (key == "Content") contentText = val;
                        else if (key == "CategoryId") categoryId = val;
                        else if (key == "ServiceId") serviceId = val;
                        else if (key == "Priority") priority = val;
                    }
                }

                string displayTitle = System.Net.WebUtility.HtmlDecode(title);
                string displayContent = System.Net.WebUtility.HtmlDecode(contentText);
                string urlEncodedTitle = Uri.EscapeDataString(displayTitle);
                string urlEncodedContent = Uri.EscapeDataString(displayContent);

                bool isUserLoggedIn = (ViewData["CurrentUserId"] != null && Convert.ToInt32(ViewData["CurrentUserId"]) > 0);

                string cardHtml = "";
                if (isUserLoggedIn)
                {
                    cardHtml = $@"
<div class='ticket-creation-card d-block w-100 border rounded-3 p-3 mt-3 bg-white shadow-sm' style='border-left: 4px solid #D71920 !important; box-sizing: border-box; clear: both;'>
    <div class='d-flex align-items-center mb-2'>
        <i class='bi bi-info-circle-fill text-danger fs-4 me-2'></i>
        <h6 class='m-0 fw-bold text-dark' style='font-size:0.9rem;'>Gợi Ý Tạo Phiếu Hỗ Trợ</h6>
    </div>
    <p class='small text-muted mb-2' style='font-size:0.75rem;'>Dựa trên sự cố của bạn, tôi đề xuất tạo phiếu hỗ trợ kỹ thuật qua nhà sau đây:</p>
    <div class='mb-3 small bg-light p-2 rounded' style='font-size:0.78rem;'>
        <div class='mb-1'>
            <span class='text-secondary'>Tiêu đề:</span> <strong class='text-dark'>{displayTitle}</strong>
        </div>
        <div>
            <span class='text-secondary'>Mô tả:</span> <span class='text-dark'>{displayContent}</span>
        </div>
    </div>
    <a href='/Ticket/TaoPhieu?title={urlEncodedTitle}&content={urlEncodedContent}&categoryId={categoryId}&serviceId={serviceId}&priority={priority}' class='btn btn-danger btn-sm rounded-pill w-100 fw-bold text-white text-decoration-none d-block text-center py-2' style='background-color:#D71920; border-color:#D71920; font-size:0.8rem;'>
        <i class='bi bi-file-earmark-plus-fill me-1'></i> Tạo Phiếu Hỗ Trợ
    </a>
</div>";
                }
                else
                {
                    string targetTicketUrl = $"/Ticket/TaoPhieu?title={urlEncodedTitle}&content={urlEncodedContent}&categoryId={categoryId}&serviceId={serviceId}&priority={priority}";
                string safeReturnUrl = Uri.EscapeDataString(targetTicketUrl);

                cardHtml = $@"
<div class='ticket-creation-card d-block w-100 border rounded-3 p-3 mt-3 bg-white shadow-sm' style='border-left: 4px solid #D71920 !important; box-sizing: border-box; clear: both;'>
    <div class='d-flex align-items-center mb-2'>
        <i class='bi bi-info-circle-fill text-danger fs-4 me-2'></i>
        <h6 class='m-0 fw-bold text-dark' style='font-size:0.9rem;'>Gợi Ý Tạo Phiếu Hỗ Trợ</h6>
    </div>
    <p class='small text-muted mb-2' style='font-size:0.75rem;'>Dựa trên sự cố của bạn, tôi đề xuất tạo phiếu hỗ trợ kỹ thuật. Vui lòng đăng nhập để tiếp tục:</p>
    <div class='mb-3 small bg-light p-2 rounded' style='font-size:0.78rem;'>
        <div class='mb-1'>
            <span class='text-secondary'>Tiêu đề:</span> <strong class='text-dark'>{displayTitle}</strong>
        </div>
        <div>
            <span class='text-secondary'>Mô tả:</span> <span class='text-dark'>{displayContent}</span>
        </div>
    </div>
    <a href='/Auth/DangNhap?returnUrl={safeReturnUrl}' class='btn btn-danger btn-sm rounded-pill w-100 fw-bold text-white text-decoration-none d-block text-center py-2' style='background-color:#D71920; border-color:#D71920; font-size:0.8rem;'>
        <i class='bi bi-shield-lock-fill me-1'></i> Đăng Nhập Để Tạo Phiếu
    </a>
</div>";
                }
                encoded = encoded.Replace(fullTag, cardHtml);
            }
        }

        // 2.6 Parse Intent Detection Tag: [INTENT_TAG|{json}]
        var intentMarker = "[INTENT_TAG|";
        if (encoded.Contains(intentMarker))
        {
            int iIndex = encoded.IndexOf(intentMarker);
            int iEnd = encoded.IndexOf("]", iIndex);
            if (iEnd > iIndex)
            {
                var fullTag = encoded.Substring(iIndex, iEnd - iIndex + 1);
                var jsonStr = fullTag.Replace("[INTENT_TAG|", "").Replace("]", "");
                var scriptInject = $"<script>try {{ window.dispatchEvent(new CustomEvent('ai_intent_detected', {{ detail: {jsonStr} }})); }} catch(e){{}}</script>";
                encoded = encoded.Replace(fullTag, scriptInject);
            }
        }

        // 2.7 Parse Service Card Tag: [SHOW_SERVICE_CARD|ServiceId=X]
        var serviceCardMarker = "[SHOW_SERVICE_CARD|";
        if (encoded.Contains(serviceCardMarker))
        {
            int scIndex = encoded.IndexOf(serviceCardMarker);
            int scEnd = encoded.IndexOf("]", scIndex);
            if (scEnd > scIndex)
            {
                var fullTag = encoded.Substring(scIndex, scEnd - scIndex + 1);
                var sIdStr = fullTag.Replace("[SHOW_SERVICE_CARD|ServiceId=", "").Replace("]", "").Trim();
                var cardHtml = $@"
<div class='ai-service-card-slot d-block w-100 p-3 rounded-4 mt-3 bg-white border border-danger-subtle shadow-sm' data-service-id='{sIdStr}' style='clear:both; box-sizing:border-box;'>
    <div class='d-flex align-items-center mb-2'>
        <i class='bi bi-hdd-network-fill text-danger fs-4 me-2'></i>
        <h6 class='m-0 fw-bold text-dark' style='font-size:0.9rem;'>Thông Tin Dịch Vụ Viettel</h6>
    </div>
    <div class='service-card-loading text-center py-3 text-muted small'>
        <i class='fa-solid fa-circle-notch fa-spin me-2 text-danger'></i>Đang tải thông tin dịch vụ từ SQL Server...
    </div>
</div>";
                encoded = encoded.Replace(fullTag, cardHtml);
            }
        }

        // 2.8 Parse Appointment Slots Tag: [SHOW_APPOINTMENT_SLOTS|ServiceId=X]
        var slotMarker = "[SHOW_APPOINTMENT_SLOTS|";
        if (encoded.Contains(slotMarker))
        {
            int slIndex = encoded.IndexOf(slotMarker);
            int slEnd = encoded.IndexOf("]", slIndex);
            if (slEnd > slIndex)
            {
                var fullTag = encoded.Substring(slIndex, slEnd - slIndex + 1);
                var slotsHtml = @"
<div class='ai-appointment-slots-card p-3 bg-white border border-danger-subtle rounded-4 mt-3 shadow-sm' style='clear:both;'>
    <div class='d-flex align-items-center mb-2'>
        <i class='bi bi-calendar-check-fill text-danger fs-4 me-2'></i>
        <h6 class='m-0 fw-bold text-dark' style='font-size:0.9rem;'>Đề Xuất Lịch Hẹn Kỹ Thuật Tại Nhà</h6>
    </div>
    <p class='small text-muted mb-2' style='font-size:0.78rem;'>Chọn khung giờ phù hợp để kỹ thuật viên Viettel đến kiểm tra tận nơi:</p>
    <div class='d-flex flex-wrap gap-2 my-2'>
        <button type='button' class='btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 fw-bold btn-slot-item' onclick='selectAiAppointmentSlot(""08:00"", this)'>08:00 Sáng</button>
        <button type='button' class='btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 fw-bold btn-slot-item' onclick='selectAiAppointmentSlot(""10:00"", this)'>10:00 Sáng</button>
        <button type='button' class='btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 fw-bold btn-slot-item' onclick='selectAiAppointmentSlot(""14:00"", this)'>14:00 Chiều</button>
        <button type='button' class='btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 fw-bold btn-slot-item' onclick='selectAiAppointmentSlot(""16:00"", this)'>16:00 Chiều</button>
    </div>
</div>";
                encoded = encoded.Replace(fullTag, slotsHtml);
            }
        }

        // 2.8.5 Parse Action Buttons Tag: [ACTION_BUTTONS]
        var actionButtonsMarker = "[ACTION_BUTTONS]";
        if (encoded.Contains(actionButtonsMarker))
        {
            var btnHtml = @"
<div class='mt-3 d-flex flex-column gap-2 w-100 action-buttons-group'>
    <a href='/Ticket/TaoPhieu' class='btn btn-danger btn-sm rounded-pill fw-bold text-white py-2 text-center text-decoration-none shadow-sm' style='background-color:#D71920; border-color:#D71920;'>
        <i class='bi bi-file-earmark-plus-fill me-1'></i> Tạo Phiếu Hỗ Trợ
    </a>
    <button type='button' class='btn btn-outline-danger btn-sm rounded-pill fw-bold py-2 text-center btn-transfer-staff shadow-sm' onclick='if(window.TechSupportChat && window.TechSupportChat.transferToStaff) window.TechSupportChat.transferToStaff();'>
        <i class='bi bi-headset me-1'></i> Chat Với Nhân Viên Kỹ Thuật
    </button>
</div>";
            encoded = encoded.Replace(actionButtonsMarker, btnHtml);
        }

        // 2.8.6 Parse Action Require Login Tag: [ACTION_REQUIRE_LOGIN]
        var actionRequireLoginMarker = "[ACTION_REQUIRE_LOGIN]";
        if (encoded.Contains(actionRequireLoginMarker))
        {
            var loginCardHtml = @"
<div class='card border-0 shadow-sm rounded-4 overflow-hidden bg-white p-3 border-danger-subtle mt-3' style='border: 1px solid #fee2e2 !important;'>
    <div class='d-flex align-items-center mb-2 text-danger fw-bold'>
        <i class='bi bi-lock-fill me-2 fs-5'></i> 🔒 Cần Đăng Nhập
    </div>
    <p class='small text-dark mb-3' style='font-size:0.85rem;'>Để tạo phiếu hỗ trợ và sắp xếp kỹ thuật viên, vui lòng đăng nhập tài khoản của bạn.</p>
    <div class='d-flex gap-2'>
        <a href='/Auth/DangNhap' class='btn btn-danger btn-sm rounded-pill fw-bold text-white px-3 py-2 text-decoration-none shadow-sm' style='background-color:#D71920; border-color:#D71920;'>
            <i class='bi bi-box-arrow-in-right me-1'></i> Đăng nhập
        </a>
        <a href='/Auth/DangKy' class='btn btn-outline-danger btn-sm rounded-pill fw-bold px-3 py-2 text-decoration-none shadow-sm'>
            <i class='bi bi-person-plus-fill me-1'></i> Đăng ký
        </a>
    </div>
</div>";
            encoded = encoded.Replace(actionRequireLoginMarker, loginCardHtml);
        }

        // 2.8.7 Parse Confirm Create Ticket Tag: [CONFIRM_CREATE_TICKET|...]
        var confirmTicketRegex = new System.Text.RegularExpressions.Regex(@"\[CONFIRM_CREATE_TICKET\|(.*?)\]", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        var confirmMatch = confirmTicketRegex.Match(encoded);
        if (confirmMatch.Success)
        {
            var fullTag = confirmMatch.Value;
            var innerContent = confirmMatch.Groups[1].Value;
            
            string title = "Sự cố kỹ thuật";
            string categoryIdStr = "1";
            string serviceIdStr = "1";
            string address = "";
            string ticketContent = "Cần hỗ trợ kiểm tra kỹ thuật";

            // Parse key-value parts separated by '|'
            var parts = innerContent.Split('|');
            foreach (var part in parts)
            {
                var trimmed = part.Trim();
                if (string.IsNullOrEmpty(trimmed)) continue;

                var eqIdx = trimmed.IndexOf('=');
                if (eqIdx > 0)
                {
                    var key = trimmed.Substring(0, eqIdx).Trim().ToLower();
                    var val = trimmed.Substring(eqIdx + 1).Trim();

                    if (key == "title" && !string.IsNullOrEmpty(val)) title = val;
                    else if (key == "categoryid" && !string.IsNullOrEmpty(val)) categoryIdStr = val;
                    else if (key == "serviceid" && !string.IsNullOrEmpty(val)) serviceIdStr = val;
                    else if (key == "address" && !string.IsNullOrEmpty(val)) address = val;
                    else if (key == "content" && !string.IsNullOrEmpty(val)) ticketContent = val;
                }
            }

            if (!int.TryParse(categoryIdStr, out int catId) || catId <= 0) categoryIdStr = "1";
            if (!int.TryParse(serviceIdStr, out int srvId) || srvId <= 0) serviceIdStr = "1";

            string encodedTitle = System.Net.WebUtility.HtmlEncode(title);
            string encodedAddress = System.Net.WebUtility.HtmlEncode(address);
            string displayAddress = string.IsNullOrWhiteSpace(address) ? "Tại địa chỉ đăng ký" : encodedAddress;
            string encodedTicketContent = System.Net.WebUtility.HtmlEncode(ticketContent);

            var cardHtml = $@"
<div class='ai-confirm-ticket-card card border-0 shadow-sm rounded-4 overflow-hidden bg-white p-3 border-danger-subtle mt-3' style='border: 1px solid #fee2e2 !important;'>
    <div class='d-flex align-items-center mb-2 text-danger fw-bold'>
        <i class='bi bi-file-earmark-plus-fill me-2 fs-5'></i> 📋 Xác Nhận Tạo Phiếu Hỗ Trợ
    </div>
    <div class='small text-dark mb-3' style='font-size:0.85rem; line-height: 1.6;'>
        <div>• <strong>Sự cố:</strong> <span class='text-danger fw-bold'>{encodedTitle}</span></div>
        <div>• <strong>Địa chỉ hỗ trợ:</strong> <span class='fw-bold'>{displayAddress}</span></div>
    </div>
    <div class='d-flex flex-wrap gap-2'>
        <button type='button' class='btn btn-danger btn-sm rounded-pill fw-bold text-white px-3 py-2 btn-confirm-create-ticket shadow-sm' style='background-color:#D71920; border-color:#D71920;' onclick='if(window.confirmCreateTicket) window.confirmCreateTicket(this, ""{encodedTitle}"", {categoryIdStr}, {serviceIdStr}, ""{encodedAddress}"", ""{encodedTicketContent}"");'>
            <i class='bi bi-check-circle-fill me-1'></i> Tạo phiếu hỗ trợ
        </button>
        <a href='/Ticket/TaoPhieu?serviceId={serviceIdStr}&categoryId={categoryIdStr}' class='btn btn-outline-secondary btn-sm rounded-pill px-3 py-2 text-decoration-none'>
            <i class='bi bi-pencil-square me-1'></i> Chỉnh sửa thông tin
        </a>
        <button type='button' class='btn btn-outline-danger btn-sm rounded-pill px-3 py-2' onclick='if(window.cancelConfirmTicket) window.cancelConfirmTicket(this);'>
            <i class='bi bi-x-circle me-1'></i> Hủy
        </button>
    </div>
</div>";
            encoded = encoded.Replace(fullTag, cardHtml);
        }

        // 3. Parse bold Markdown: **text** -> <strong>text</strong>
        encoded = System.Text.RegularExpressions.Regex.Replace(encoded, @"\*\*(.*?)\*\*", "<strong>$1</strong>");

        // 4. Parse Markdown links: [Text](URL) -> <a href="URL" target="_blank">Text</a>
        encoded = System.Text.RegularExpressions.Regex.Replace(encoded, @"\[(.*?)\]\((.*?)\)", "<a href=\"$2\" target=\"_blank\" class=\"fw-bold text-danger text-decoration-underline\">$1</a>");

        // 5. Convert newlines to breaks
        encoded = encoded.Replace("\n", "<br />");

        return new Microsoft.AspNetCore.Html.HtmlString(encoded);
    }
}
