@model SupportTicketSysterm.ViewModels.DanhGiaPhieuViewModel
@{
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
    ViewData["Title"] = "Đánh Giá Chất Lượng Dịch Vụ - TechSupport Viettel Telecom";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/review.css" asp-append-version="true" />
    <style>
        .star-rating-group { display: flex; gap: 4px; cursor: pointer; }
        .star-icon { font-size: 1.5rem; color: #CBD5E1; transition: color 0.2s ease, transform 0.2s ease; }
        .star-icon.active { color: #F59E0B; }
        .star-icon:hover { transform: scale(1.15); }
        .alert-already-rated { background: #EFF6FF; border: 1px solid #BFDBFE; border-radius: 12px; }
        .alert-not-completed { background: #FFFBEB; border: 1px solid #FDE68A; border-radius: 12px; }
        @@keyframes modalPopIn {
            from { opacity: 0; transform: scale(0.9); }
            to { opacity: 1; transform: scale(1); }
        }
    </style>
}

<div class="review-page-wrapper">

    <!-- ==========================================
       1. HERO BANNER SECTION
       ========================================== -->
    <section class="rev-hero">
        <div class="rev-hero-overlay"></div>
        <div class="rev-hero-particles"></div>
        <div class="rev-hero-content">
            <span class="rev-hero-subtitle">
                <i class="bi bi-star-fill me-1 text-warning"></i> VIETTEL TELECOM CẦN THƠ
            </span>
            <h1 class="rev-hero-title">
                ĐÁNH GIÁ <span>CHẤT LƯỢNG DỊCH VỤ</span>
            </h1>
            <p class="rev-hero-desc">
                Ý kiến đánh giá của quý khách là cơ sở giúp Viettel Telecom nâng cao chất lượng mạng và tác phong phục vụ.
            </p>
            <div class="rev-hero-breadcrumb">
                <a asp-controller="Customers" asp-action="TrangChu">
                    <i class="bi bi-house-door-fill me-1"></i> Trang chủ
                </a>
                <span class="separator">></span>
                <a asp-controller="Customers" asp-action="PhieuCuaToi">Phiếu của tôi</a>
                <span class="separator">></span>
                <span class="current">Đánh giá</span>
            </div>
        </div>
    </section>

    <!-- ==========================================
       2. MAIN CONTENT SECTION (2 COLUMNS)
       ========================================== -->
    <section class="rev-main-section">
        <div class="container">

            <!-- ALERT BANNER MESSAGES -->
            @if (!Model.IsCompleted)
            {
                <div class="alert alert-not-completed p-4 mb-4 shadow-sm" data-aos="fade-up">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-warning text-dark d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                            <i class="bi bi-exclamation-triangle-fill fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-1">Phiếu hỗ trợ chưa hoàn thành</h5>
                            <p class="text-secondary m-0">Phiếu hỗ trợ chưa hoàn thành nên chưa thể đánh giá.</p>
                        </div>
                    </div>
                </div>
            }
            else if (Model.IsAlreadyRated)
            {
                <div class="alert alert-already-rated p-4 mb-4 shadow-sm" data-aos="fade-up">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 48px; height: 48px;">
                            <i class="bi bi-patch-check-fill fs-4"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-primary mb-1">Bạn đã đánh giá phiếu này</h5>
                            <p class="text-secondary m-0">Dưới đây là chi tiết ý kiến đánh giá đã được lưu trên hệ thống SQL Server.</p>
                        </div>
                    </div>
                </div>
            }

            <div class="row g-4">

                <!-- LEFT COLUMN: Ticket Details & Form -->
                <div class="col-lg-8 col-12">

                    <!-- CARD 1: THÔNG TIN PHIẾU HỖ TRỢ (SQL SERVER DATA) -->
                    <div class="rev-card rev-ticket-card mb-4" data-aos="fade-up">
                        <div class="rev-card-header d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rev-icon-circle bg-red-soft">
                                    <i class="bi bi-ticket-detailed-fill"></i>
                                </div>
                                <div>
                                    <h2 class="rev-card-title m-0">Thông Tin Phiếu Đánh Giá</h2>
                                    <span class="rev-card-subtitle">Thông tin chi tiết phiếu kỹ thuật đọc trực tiếp từ CSDL SQL Server</span>
                                </div>
                            </div>
                            <span class="rev-status-badge @(Model.TrangThai == "Hoàn thành" || Model.TrangThai == "DaHoanThanh" ? "badge-success" : "badge-warning")">
                                <i class="bi bi-check-circle-fill me-1"></i> @Model.TrangThai
                            </span>
                        </div>
                        <div class="rev-card-body">
                            <div class="row g-3">
                                <div class="col-sm-6 col-12">
                                    <div class="rev-info-item">
                                        <span class="info-label">Mã phiếu hỗ trợ</span>
                                        <span class="info-value font-mono text-danger fw-bold">@Model.MaPhieu</span>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-12">
                                    <div class="rev-info-item">
                                        <span class="info-label">Tiêu đề sự cố</span>
                                        <span class="info-value fw-bold">@Model.TieuDe</span>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-12">
                                    <div class="rev-info-item">
                                        <span class="info-label">Khách hàng</span>
                                        <span class="info-value fw-bold text-dark">@Model.TenKhachHang</span>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-12">
                                    <div class="rev-info-item">
                                        <span class="info-label">Danh mục dịch vụ</span>
                                        <span class="info-value">@Model.TenDanhMuc</span>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-12">
                                    <div class="rev-info-item">
                                        <span class="info-label">Gói dịch vụ</span>
                                        <span class="info-value">@Model.TenDichVu</span>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-12">
                                    <div class="rev-info-item">
                                        <span class="info-label">Kỹ thuật viên hỗ trợ</span>
                                        <span class="info-value text-primary font-weight-bold">
                                            <i class="bi bi-person-badge-fill me-1"></i> @Model.TenNhanVien
                                        </span>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-12">
                                    <div class="rev-info-item">
                                        <span class="info-label">Thời gian hoàn thành</span>
                                        <span class="info-value text-success fw-bold">@Model.NgayHoanThanhText</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- CARD 2: FORM ĐÁNH GIÁ (HOẶC READ-ONLY VIEW NẾU ĐÃ ĐÁNH GIÁ) -->
                    @if (Model.IsCompleted && !Model.IsAlreadyRated)
                    {
                        <div class="rev-card rev-form-card mb-4" data-aos="fade-up" data-aos-delay="100">
                            <div class="rev-card-header d-flex align-items-center gap-2">
                                <div class="rev-icon-circle bg-gold-soft">
                                    <i class="bi bi-stars"></i>
                                </div>
                                <div>
                                    <h2 class="rev-card-title m-0">Đánh Giá 5 Tiêu Chí Dịch Vụ</h2>
                                    <span class="rev-card-subtitle">Nhấp chọn số sao cho 5 tiêu chí để gửi phản hồi lên hệ thống</span>
                                </div>
                            </div>
                            <div class="rev-card-body">
                                <form id="reviewForm" method="post" asp-controller="Ticket" asp-action="DanhGiaPhieu">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" asp-for="IdPhieu" />
                                    <input type="hidden" asp-for="ChatLuongDichVu" id="inputQuality" value="@Model.ChatLuongDichVu" />
                                    <input type="hidden" asp-for="ThaiDoNhanVien" id="inputAttitude" value="@Model.ThaiDoNhanVien" />
                                    <input type="hidden" asp-for="TocDoXuLy" id="inputSpeed" value="@Model.TocDoXuLy" />
                                    <input type="hidden" asp-for="KhaNangGiaiQuyet" id="inputSolving" value="@Model.KhaNangGiaiQuyet" />
                                    <input type="hidden" asp-for="MucDoHaiLong" id="inputSatisfaction" value="@Model.MucDoHaiLong" />

                                    <!-- Tiêu chí 1 -->
                                    <div class="rating-criterion-row mb-4" data-criterion="quality">
                                        <div class="criterion-info">
                                            <span class="criterion-num">1</span>
                                            <div class="criterion-text">
                                                <span class="criterion-name">Chất lượng dịch vụ</span>
                                                <span class="criterion-desc">Hiệu quả xử lý sự cố & độ ổn định thiết bị</span>
                                            </div>
                                        </div>
                                        <div class="criterion-stars-wrapper">
                                            <div class="star-rating-group" data-target="inputQuality" data-score="5">
                                                <i class="bi bi-star-fill star-icon active" data-value="1"></i>
                                                <i class="bi bi-star-fill star-icon active" data-value="2"></i>
                                                <i class="bi bi-star-fill star-icon active" data-value="3"></i>
                                                <i class="bi bi-star-fill star-icon active" data-value="4"></i>
                                                <i class="bi bi-star-fill star-icon active" data-value="5"></i>
                                            </div>
                                            <span class="score-display-badge">5/5</span>
                                        </div>
                                    </div>

                                    <!-- Tiêu chí 2 -->
                                    <div class="rating-criterion-row mb-4" data-criterion="attitude">
                                        <div class="criterion-info">
                                            <span class="criterion-num">2</span>
                                            <div class="criterion-text">
                                                <span class="criterion-name">Thái độ phục vụ</span>
                                                <span class="criterion-desc">Tác phong lịch sự, nhiệt tình & văn minh</span>
                                            </div>
                                        </div>
                                        <div class="criterion-stars-wrapper">
                                            <div class="star-rating-group" data-target="inputAttitude" data-score="5">
                                                <i class="bi bi-star-fill star-icon active" data-value="1"></i>
                                                <i class="bi bi-star-fill star-icon active" data-value="2"></i>
                                                <i class="bi bi-star-fill star-icon active" data-value="3"></i>
                                                <i class="bi bi-star-fill star-icon active" data-value="4"></i>
                                                <i class="bi bi-star-fill star-icon active" data-value="5"></i>
                                            </div>
                                            <span class="score-display-badge">5/5</span>
                                        </div>
                                    </div>

                                    <!-- Tiêu chí 3 -->
                                    <div class="rating-criterion-row mb-4" data-criterion="speed">
                                        <div class="criterion-info">
                                            <span class="criterion-num">3</span>
                                            <div class="criterion-text">
                                                <span class="criterion-name">Tốc độ xử lý</span>
                                                <span class="criterion-desc">Thời gian tiếp nhận & có mặt hỗ trợ</span>
                                            </div>
                                        </div>
                                        <div class="criterion-stars-wrapper">
                                            <div class="star-rating-group" data-target="inputSpeed" data-score="5">
                                                <i class="bi bi-star-fill star-icon active" data-value="1"></i>
                                                <i class="bi bi-star-fill star-icon active" data-value="2"></i>
                                                <i class="bi bi-star-fill star-icon active" data-value="3"></i>
                                                <i class="bi bi-star-fill star-icon active" data-value="4"></i>
                                                <i class="bi bi-star-fill star-icon active" data-value="5"></i>
                                            </div>
                                            <span class="score-display-badge">5/5</span>
                                        </div>
                                    </div>

                                    <!-- Tiêu chí 4 -->
                                    <div class="rating-criterion-row mb-4" data-criterion="solving">
                                        <div class="criterion-info">
                                            <span class="criterion-num">4</span>
                                            <div class="criterion-text">
                                                <span class="criterion-name">Khả năng giải quyết</span>
                                                <span class="criterion-desc">Trình độ chuyên môn & tư vấn giải pháp</span>
                                            </div>
                                        </div>
                                        <div class="criterion-stars-wrapper">
                                            <div class="star-rating-group" data-target="inputSolving" data-score="5">
                                                <i class="bi bi-star-fill star-icon active" data-value="1"></i>
                                                <i class="bi bi-star-fill star-icon active" data-value="2"></i>
                                                <i class="bi bi-star-fill star-icon active" data-value="3"></i>
                                                <i class="bi bi-star-fill star-icon active" data-value="4"></i>
                                                <i class="bi bi-star-fill star-icon active" data-value="5"></i>
                                            </div>
                                            <span class="score-display-badge">5/5</span>
                                        </div>
                                    </div>

                                    <!-- Tiêu chí 5 -->
                                    <div class="rating-criterion-row mb-4" data-criterion="satisfaction">
                                        <div class="criterion-info">
                                            <span class="criterion-num">5</span>
                                            <div class="criterion-text">
                                                <span class="criterion-name">Mức độ hài lòng chung</span>
                                                <span class="criterion-desc">Đánh giá tổng thể trải nghiệm dịch vụ</span>
                                            </div>
                                        </div>
                                        <div class="criterion-stars-wrapper">
                                            <div class="star-rating-group" data-target="inputSatisfaction" data-score="5">
                                                <i class="bi bi-star-fill star-icon active" data-value="1"></i>
                                                <i class="bi bi-star-fill star-icon active" data-value="2"></i>
                                                <i class="bi bi-star-fill star-icon active" data-value="3"></i>
                                                <i class="bi bi-star-fill star-icon active" data-value="4"></i>
                                                <i class="bi bi-star-fill star-icon active" data-value="5"></i>
                                            </div>
                                            <span class="score-display-badge">5/5</span>
                                        </div>
                                    </div>

                                    <!-- NHẬN XÉT -->
                                    <div class="form-group mb-4">
                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <label for="reviewComments" class="form-label fw-bold m-0">
                                                <i class="bi bi-chat-right-quote-fill me-1 text-danger"></i> Ý kiến nhận xét & góp ý chi tiết
                                            </label>
                                            <span class="char-count-badge">
                                                <span id="charCount">0</span>/1000 ký tự
                                            </span>
                                        </div>
                                        <textarea id="reviewComments" asp-for="NhanXet" class="form-control rev-custom-textarea" rows="4" maxlength="1000" placeholder="Hãy chia sẻ trải nghiệm của bạn về dịch vụ kỹ thuật Viettel..."></textarea>
                                    </div>

                                    <!-- ACTION BUTTONS -->
                                    <div class="rev-action-buttons d-flex flex-wrap gap-3 mt-4 pt-2">
                                        <button type="button" class="btn btn-rev-submit btn-ripple" id="btnSubmitReview">
                                            <i class="bi bi-send-fill me-1"></i> Gửi Đánh Giá Dịch Vụ
                                        </button>
                                        <a asp-controller="Customers" asp-action="PhieuCuaToi" class="btn btn-rev-back">
                                            <i class="bi bi-arrow-left-circle me-1"></i> Quay Lại Danh Sách
                                        </a>
                                    </div>

                                </form>
                            </div>
                        </div>
                    }
                    else if (Model.IsAlreadyRated)
                    {
                        <!-- READ ONLY RATED CARD -->
                        <div class="rev-card mb-4" data-aos="fade-up">
                            <div class="rev-card-header bg-light">
                                <h4 class="rev-card-title m-0 text-success">
                                    <i class="bi bi-check-circle-fill me-2"></i>Chi Tiết Đánh Giá Đã Lưu
                                </h4>
                            </div>
                            <div class="rev-card-body">
                                <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
                                    <span class="text-muted fs-8">Ngày gửi đánh giá:</span>
                                    <strong class="text-dark font-mono">@(Model.NgayDanhGia?.ToString("dd/MM/yyyy HH:mm") ?? "Mới đây")</strong>
                                </div>
                                <div class="mb-3">
                                    <span class="text-muted d-block fs-8 mb-1">Nội dung nhận xét:</span>
                                    <div class="p-3 bg-light rounded-3 text-dark italic">
                                        "@(string.IsNullOrWhiteSpace(Model.NhanXet) ? "Không có nhận xét thêm." : Model.NhanXet)"
                                    </div>
                                </div>
                                <a asp-controller="Customers" asp-action="PhieuCuaToi" class="btn btn-outline-danger btn-sm rounded-pill px-4">
                                    <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách phiếu
                                </a>
                            </div>
                        </div>
                    }

                </div>

                <!-- RIGHT COLUMN: SCORE SIDEBAR (DỮ LIỆU TÍNH TOÁN SERVER/CLIENT REALTIME) -->
                <div class="col-lg-4 col-12">
                    <div class="rev-sticky-sidebar">

                        <div class="rev-card rev-score-card mb-4" data-aos="fade-up" data-aos-delay="100">
                            <div class="score-card-header text-center">
                                <span class="score-header-tag"><i class="bi bi-award-fill me-1"></i> ĐIỂM TRUNG BÌNH</span>
                                <div class="score-big-number" id="overallScoreVal">@Model.DiemTrungBinh.ToString("0.0")</div>
                                <div class="score-stars-display" id="overallStarsDisplay">
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                </div>
                                <div class="score-level-badge badge-excellent" id="overallLevelBadge">
                                    <i class="bi bi-emoji-smile-fill me-1"></i> Mức độ: Xuất Sắc
                                </div>
                            </div>
                            <div class="score-card-body">
                                <div class="score-progress-list">
                                    <div class="progress-item mb-3">
                                        <div class="d-flex justify-content-between font-size-xs mb-1">
                                            <span class="progress-label">Chất lượng dịch vụ</span>
                                            <span class="progress-val fw-bold text-danger" id="progValQuality">@Model.ChatLuongDichVu.ToString("0.0")</span>
                                        </div>
                                        <div class="progress rev-progress-bar">
                                            <div class="progress-bar bg-danger" id="progBarQuality" style="width: @(Model.ChatLuongDichVu * 20)%"></div>
                                        </div>
                                    </div>
                                    <div class="progress-item mb-3">
                                        <div class="d-flex justify-content-between font-size-xs mb-1">
                                            <span class="progress-label">Thái độ phục vụ</span>
                                            <span class="progress-val fw-bold text-danger" id="progValAttitude">@Model.ThaiDoNhanVien.ToString("0.0")</span>
                                        </div>
                                        <div class="progress rev-progress-bar">
                                            <div class="progress-bar bg-danger" id="progBarAttitude" style="width: @(Model.ThaiDoNhanVien * 20)%"></div>
                                        </div>
                                    </div>
                                    <div class="progress-item mb-3">
                                        <div class="d-flex justify-content-between font-size-xs mb-1">
                                            <span class="progress-label">Tốc độ xử lý</span>
                                            <span class="progress-val fw-bold text-danger" id="progValSpeed">@Model.TocDoXuLy.ToString("0.0")</span>
                                        </div>
                                        <div class="progress rev-progress-bar">
                                            <div class="progress-bar bg-danger" id="progBarSpeed" style="width: @(Model.TocDoXuLy * 20)%"></div>
                                        </div>
                                    </div>
                                    <div class="progress-item mb-3">
                                        <div class="d-flex justify-content-between font-size-xs mb-1">
                                            <span class="progress-label">Khả năng giải quyết</span>
                                            <span class="progress-val fw-bold text-danger" id="progValSolving">@Model.KhaNangGiaiQuyet.ToString("0.0")</span>
                                        </div>
                                        <div class="progress rev-progress-bar">
                                            <div class="progress-bar bg-danger" id="progBarSolving" style="width: @(Model.KhaNangGiaiQuyet * 20)%"></div>
                                        </div>
                                    </div>
                                    <div class="progress-item">
                                        <div class="d-flex justify-content-between font-size-xs mb-1">
                                            <span class="progress-label">Mức độ hài lòng</span>
                                            <span class="progress-val fw-bold text-danger" id="progValSatisfaction">@Model.MucDoHaiLong.ToString("0.0")</span>
                                        </div>
                                        <div class="progress rev-progress-bar">
                                            <div class="progress-bar bg-danger" id="progBarSatisfaction" style="width: @(Model.MucDoHaiLong * 20)%"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </section>

</div>

<!-- =========================================================
   VIETTEL SUCCESS RATING MODAL (SPA EXPERIENCE)
   ========================================================= -->
<div class="modal fade" id="ratingSuccessModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-md">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden" style="animation: modalPopIn 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);">
            <div class="modal-header border-0 bg-danger text-white p-4 text-center d-flex flex-column align-items-center position-relative">
                <div class="rounded-circle bg-white text-danger d-flex align-items-center justify-content-center shadow mb-2" style="width: 64px; height: 64px;">
                    <i class="bi bi-star-fill display-5 fw-bold text-warning"></i>
                </div>
                <h4 class="fw-bold m-0 text-white">Đánh Giá Thành Công</h4>
                <p class="small text-white-50 m-0 mt-1">Viettel Telecom chân thành cảm ơn ý kiến đóng góp của quý khách</p>
            </div>
            <div class="modal-body p-4 bg-light text-center">
                <p class="text-secondary fs-7 mb-3">
                    Hệ thống đã lưu thành công đánh giá cho phiếu <strong class="text-danger font-mono" id="ratingModalMaPhieu">@Model.MaPhieu</strong> với số điểm trung bình là <strong class="text-danger" id="ratingModalScore">5.0/5.0</strong>.
                </p>
                <div class="d-flex justify-content-center gap-2 mt-3">
                    <a asp-controller="Customers" asp-action="PhieuCuaToi" class="btn btn-danger rounded-pill px-4 py-2 font-weight-bold btn-ripple">
                        <i class="bi bi-card-checklist me-1"></i> Về danh sách phiếu của tôi
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
