@model SupportTicketSysterm.ViewModels.ChiTietPhieuViewModel
@{
    Layout = null;
    ViewData["Title"] = "Chi tiết phiếu hỗ trợ";

    // Helpers for badges mapping
    string GetStatusClass(string status)
    {
        return (status?.ToLower()) switch
        {
            "chờ tiếp nhận" or "pending" or "chotiepnhan" => "status-pending",
            "đang xử lý" or "processing" or "dangxuly" => "status-processing",
            "chờ phản hồi" or "chokhachhangphanhoi" or "feedback" or "chophanhoidung" => "status-feedback",
            "hoàn thành" or "completed" or "dahoanthanh" => "status-completed",
            "đã hủy" or "cancelled" or "dahuy" => "status-cancelled",
            _ => "status-pending"
        };
    }

    string GetStatusText(string status)
    {
        return (status?.ToLower()) switch
        {
            "chờ tiếp nhận" or "pending" or "chotiepnhan" => "Chờ tiếp nhận",
            "đang xử lý" or "processing" or "dangxuly" => "Đang xử lý",
            "chờ phản hồi" or "chokhachhangphanhoi" or "feedback" or "chophanhoidung" => "Chờ phản hồi",
            "hoàn thành" or "completed" or "dahoanthanh" => "Đã hoàn thành",
            "đã hủy" or "cancelled" or "dahuy" => "Đã hủy",
            _ => status ?? "Chờ tiếp nhận"
        };
    }

    string GetPriorityClass(int priority)
    {
        return $"priority-{priority}";
    }

    string GetPriorityText(int priority)
    {
        return priority switch
        {
            1 => "Thấp",
            2 => "Trung bình",
            3 => "Cao",
            4 => "Khẩn cấp",
            _ => "Thấp"
        };
    }
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Chi Tiết Phiếu Hỗ Trợ - TechSupport Viettel</title>

    <!-- SEO Optimization -->
    <meta name="description" content="Chi tiết phiếu hỗ trợ kỹ thuật và tiến độ xử lý trực tuyến. TechSupport Viettel Telecom.">
    <meta name="robots" content="noindex, nofollow">

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="https://viettel.com.vn/favicon.ico">

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Font Awesome 6.6.0 CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">

    <!-- Google Fonts Inter & Be Vietnam Pro -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Be+Vietnam+Pro:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Core Stylesheets -->
    <link rel="stylesheet" href="~/assets/css/style.css">
    <link rel="stylesheet" href="~/assets/css/responsive.css">
    <link rel="stylesheet" href="~/assets/css/header.css">
    <link rel="stylesheet" href="~/assets/css/sidebar.css">
    @* <link rel="stylesheet" href="~/assets/css/footer.css"> *@

    <!-- Custom Page CSS -->
    <link rel="stylesheet" href="~/assets/css/ticket-detail.css">
    <link rel="stylesheet" href="~/assets/css/phieu-cuatoi.css" asp-append-version="true">
    <link rel="stylesheet" href="~/assets/css/page-hero.css" asp-append-version="true">
</head>

<body>

    <!-- ==================== HEADER ==================== -->
    @await Html.PartialAsync("~/Views/Shared/_Header.cshtml", Context.Session)

    <!-- ==================== SIDEBAR ==================== -->
    <div id="sidebar-container"></div>

    <!-- ==================== HERO SECTION ==================== -->
    <section class="hero-section" aria-label="Chi tiết phiếu hỗ trợ">
        <div class="container hero-content">
            <div class="row align-items-center g-4">

                <!-- LEFT: text content -->
                <div class="col-lg-7 col-12 text-start hero-text-col animate-fade-up">

                    <!-- Breadcrumb Navigation -->
                    <nav aria-label="breadcrumb" class="hero-breadcrumb d-print-none">
                        <ol class="breadcrumb m-0" itemscope itemtype="https://schema.org/BreadcrumbList">
                            <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                                <a href="@Url.Action("TrangChu", "Customers")" itemprop="item" class="text-decoration-none d-inline-flex align-items-center">
                                    <i class="fa-solid fa-house-door-fill me-1"></i>
                                    <span itemprop="name">Trang chủ</span>
                                </a>
                                <meta itemprop="position" content="1" />
                            </li>
                            <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                                <a href="@Url.Action("PhieuCuaToi", "Customers")" itemprop="item" class="text-decoration-none">
                                    <span itemprop="name">Phiếu của tôi</span>
                                </a>
                                <meta itemprop="position" content="2" />
                            </li>
                            <li class="breadcrumb-item active" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page">
                                <span itemprop="name">Chi tiết phiếu</span>
                                <meta itemprop="position" content="3" />
                            </li>
                        </ol>
                    </nav>

                    <!-- Hero Badge -->
                    <span class="hero-badge">
                        <i class="fa-solid fa-ticket-fill me-1"></i> Phiếu hỗ trợ: @Model.MaPhieu
                    </span>

                    <!-- Title -->
                    <h1 class="hero-title text-uppercase mb-2">@Model.TieuDe</h1>

                    <!-- Description -->
                    <p class="hero-desc mb-3">
                        Theo dõi chi tiết tiến trình xử lý sự cố, xem lịch sử trao đổi, lịch hẹn và tương tác trực tiếp với kỹ thuật viên phụ trách.
                    </p>

                    <!-- Header Tags -->
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
                        <!-- Status Badge -->
                        <span class="tag-badge @GetStatusClass(Model.TrangThai)">
                            <i class="bi bi-clock-history"></i> @GetStatusText(Model.TrangThai)
                        </span>

                        <!-- Priority Badge -->
                        <span class="tag-badge @GetPriorityClass(Model.MucDoUuTien)">
                            <i class="bi bi-exclamation-triangle-fill"></i> Ưu tiên: @GetPriorityText(Model.MucDoUuTien)
                        </span>

                        <!-- Category Badge -->
                        <span class="tag-badge tag-info">
                            <i class="bi bi-folder"></i> @(Model.TenDanhMuc ?? "Dịch vụ mạng")
                        </span>

                        <!-- Request Type Badge -->
                        <span class="tag-badge tag-info">
                            <i class="bi bi-question-circle"></i> @Model.LoaiYeuCau
                        </span>

                        <!-- Created Date -->
                        <span class="tag-badge tag-info">
                            <i class="bi bi-calendar-event"></i> Ngày tạo: @Model.NgayTao.ToString("dd/MM/yyyy")
                        </span>
                    </div>

                    <!-- CTA Buttons -->
                    <div class="hero-cta-buttons d-flex flex-wrap gap-3 mt-3 d-print-none">
                        <a asp-controller="Customers" asp-action="PhieuCuaToi" class="btn btn-hero-contact px-4 py-2">
                            <i class="bi bi-arrow-left me-1"></i> Danh sách phiếu
                        </a>
                        <a asp-controller="Ticket" asp-action="InPhieuPDF" asp-route-id="@Model.IdPhieu" class="btn btn-hero-create px-4 py-2">
                            <i class="fa-solid fa-file-pdf me-1"></i> In Phiếu PDF
                        </a>
                    </div>

                    <!-- Quick Stats -->
                    <div class="lk-hero-stats d-flex flex-wrap gap-3 mt-4 d-print-none">
                        <div class="lk-hero-stat-item">
                            <span class="lk-hero-stat-num" style="color:#D71920">24/7</span>
                            <span class="lk-hero-stat-label">Hỗ trợ kỹ thuật</span>
                        </div>
                        <div class="lk-hero-stat-sep"></div>
                        <div class="lk-hero-stat-item">
                            <span class="lk-hero-stat-num" style="color:#3B82F6">&lt; 30p</span>
                            <span class="lk-hero-stat-label">Thời gian phản hồi</span>
                        </div>
                        <div class="lk-hero-stat-sep"></div>
                        <div class="lk-hero-stat-item">
                            <span class="lk-hero-stat-num" style="color:#10B981">100%</span>
                            <span class="lk-hero-stat-label">Bảo mật thông tin</span>
                        </div>
                    </div>
                </div>

                <!-- RIGHT: SVG Illustration Banner -->
                <div class="col-lg-5 col-12 hero-banner-wrapper animate-fade-up delay-1 d-print-none">
                    <svg class="hero-banner-svg" viewBox="0 0 500 420" xmlns="http://www.w3.org/2000/svg" aria-label="Chi tiết phiếu hỗ trợ">
                        <defs>
                            <linearGradient id="tdGradRed" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#D71920" />
                                <stop offset="100%" stop-color="#ff4d6d" />
                            </linearGradient>
                            <linearGradient id="tdGradDark" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#1f2937" />
                                <stop offset="100%" stop-color="#111827" />
                            </linearGradient>
                            <linearGradient id="tdGradBlue" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#3B82F6" />
                                <stop offset="100%" stop-color="#2563EB" />
                            </linearGradient>
                            <linearGradient id="tdGradGreen" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#10B981" />
                                <stop offset="100%" stop-color="#059669" />
                            </linearGradient>
                        </defs>

                        <!-- Background decorative circles -->
                        <circle cx="250" cy="210" r="175" fill="url(#tdGradRed)" opacity="0.04" />
                        <circle cx="400" cy="80" r="65" fill="url(#tdGradRed)" opacity="0.06" />

                        <!-- Main Ticket Detail Dashboard Card -->
                        <rect x="40" y="50" width="380" height="310" rx="24" fill="#ffffff" stroke="rgba(15,17,21,0.05)" stroke-width="2" filter="drop-shadow(0 20px 40px rgba(0,0,0,0.07))" />

                        <!-- Header bar -->
                        <path d="M40 74 C40 60.85 50.85 50 64 50 L396 50 C409.15 50 420 60.85 420 74 L420 95 L40 95 Z" fill="url(#tdGradDark)" />
                        <!-- Traffic lights -->
                        <circle cx="65" cy="72" r="5" fill="#D71920" />
                        <circle cx="81" cy="72" r="5" fill="#eab308" />
                        <circle cx="97" cy="72" r="5" fill="#10b981" />

                        <!-- Ticket Details graphic on screen -->
                        <rect x="60" y="115" width="320" height="40" rx="8" fill="#F8FAFC" stroke="#E2E8F0" stroke-width="1" />
                        <rect x="75" y="127" width="90" height="8" rx="3" fill="url(#tdGradRed)" opacity="0.85" />
                        <rect x="75" y="139" width="160" height="6" rx="2" fill="#94A3B8" />

                        <!-- Status badge on illustration -->
                        <rect x="290" y="125" width="75" height="20" rx="10" fill="url(#tdGradBlue)" />
                        <circle cx="302" cy="135" r="4" fill="#ffffff" />
                        <rect x="312" y="132" width="42" height="6" rx="3" fill="#ffffff" />

                        <!-- Timeline step graphic 1 -->
                        <circle cx="75" cy="185" r="10" fill="url(#tdGradGreen)" />
                        <path d="M71 185 L74 188 L80 182" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round" />
                        <rect x="95" y="180" width="120" height="8" rx="3" fill="#334155" />
                        <rect x="95" y="192" width="180" height="6" rx="2" fill="#94A3B8" />

                        <!-- Timeline step graphic 2 -->
                        <line x1="75" y1="195" x2="75" y2="225" stroke="#CBD5E1" stroke-width="2" stroke-dasharray="3 3" />
                        <circle cx="75" cy="235" r="10" fill="url(#tdGradBlue)" />
                        <circle cx="75" cy="235" r="4" fill="#ffffff" />
                        <rect x="95" y="230" width="140" height="8" rx="3" fill="#334155" />
                        <rect x="95" y="242" width="160" height="6" rx="2" fill="#94A3B8" />

                        <!-- Timeline step graphic 3 -->
                        <line x1="75" y1="245" x2="75" y2="275" stroke="#CBD5E1" stroke-width="2" stroke-dasharray="3 3" />
                        <circle cx="75" cy="285" r="10" fill="#E2E8F0" />
                        <rect x="95" y="280" width="110" height="8" rx="3" fill="#94A3B8" />
                        <rect x="95" y="292" width="130" height="6" rx="2" fill="#CBD5E1" />

                        <!-- Floating Badge -->
                        <g transform="translate(320, 290)">
                            <rect x="0" y="0" width="115" height="55" rx="14" fill="url(#tdGradRed)" filter="drop-shadow(0 8px 16px rgba(215,25,32,0.25))" />
                            <circle cx="28" cy="28" r="14" fill="rgba(255,255,255,0.2)" />
                            <path d="M22 28 L26 32 L34 24" stroke="#ffffff" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                            <rect x="50" y="20" width="52" height="6" rx="3" fill="#ffffff" />
                            <rect x="50" y="31" width="38" height="5" rx="2.5" fill="rgba(255,255,255,0.7)" />
                        </g>
                    </svg>
                </div>

            </div>
        </div>
    </section>

    <!-- MAIN WORKSPACE -->
    <main class="workspace-area">
        <div class="container">

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success border-0 rounded-3 mb-3 animate-fade-up">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger border-0 rounded-3 mb-3 animate-fade-up">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                </div>
            }

            <!-- COLUMN LAYOUT -->
            <div class="row g-4">
                
                <!-- LEFT COLUMN (Main Details) -->
                <div class="col-lg-8 col-md-12">
                    
                    <!-- CARD 1: THÔNG TIN TỔNG QUAN -->
                    <div class="detail-card">
                        <div class="detail-card-head">
                            <div class="card-icon red">
                                <i class="fa-solid fa-file-lines"></i>
                            </div>
                            <h2 class="detail-card-title">Mô tả sự cố & yêu cầu</h2>
                        </div>
                        <div class="detail-card-body">
                            <div class="data-grid mb-3">
                                <div class="data-cell full-width">
                                    <span class="cell-lbl"><i class="fa-solid fa-pen-fancy"></i> Tiêu đề</span>
                                    <span class="cell-val text-danger">@Model.TieuDe</span>
                                </div>
                            </div>
                            <div class="data-cell full-width">
                                <span class="cell-lbl mb-2"><i class="fa-solid fa-align-left"></i> Nội dung chi tiết</span>
                                <p class="desc-box">@Model.NoiDung</p>
                            </div>
                        </div>
                    </div>

                    <!-- CARD 2: LỊCH HẸN KHẢO SÁT/XỬ LÝ -->
                    <div class="detail-card">
                        <div class="detail-card-head">
                            <div class="card-icon blue">
                                <i class="fa-solid fa-calendar-days"></i>
                            </div>
                            <h2 class="detail-card-title">Lịch hẹn hỗ trợ tại nhà</h2>
                        </div>
                        <div class="detail-card-body">
                            <div class="lh-container">
                                @if (Model.LichHens.Any())
                                {
                                    <div class="lh-timeline">
                                        @foreach (var item in Model.LichHens)
                                        {
                                            var statusClass = item.TrangThai switch
                                            {
                                                "Đã xác nhận" => "lh-status-confirmed",
                                                "Chờ xác nhận" => "lh-status-waiting",
                                                "Đã hoàn thành" => "lh-status-completed",
                                                "Đã hủy" => "lh-status-cancelled",
                                                _ => "lh-status-waiting"
                                            };

                                            <div class="lh-item animate-fade-up" id="lh-item-@item.IdLichHen">
                                                <div class="lh-header">
                                                    <span class="lh-id">Mã lịch hẹn: LH-@item.IdLichHen.ToString("D5")</span>
                                                    <span class="lh-badge @statusClass" id="lh-badge-@item.IdLichHen">
                                                        <span class="status-dot"></span> @item.TrangThai
                                                    </span>
                                                </div>
                                                <div class="lh-body">
                                                    <div class="lh-info-row">
                                                        <div class="lh-info-col">
                                                            <div class="lh-info-label"><i class="bi bi-calendar-event me-1 text-danger"></i> Ngày hẹn</div>
                                                            <div class="lh-info-value">@(item.NgayHen?.ToString("dd/MM/yyyy") ?? "—")</div>
                                                        </div>
                                                        <div class="lh-info-col">
                                                            <div class="lh-info-label"><i class="bi bi-clock me-1 text-danger"></i> Giờ hẹn</div>
                                                            <div class="lh-info-value">@(item.GioHen?.ToString(@"hh\:mm") ?? "—")</div>
                                                        </div>
                                                    </div>

                                                    <div class="lh-info-field">
                                                        <div class="lh-info-label"><i class="bi bi-geo-alt me-1 text-danger"></i> Địa chỉ</div>
                                                        <div class="lh-info-value">@(item.DiaChi ?? "—")</div>
                                                    </div>

                                                    <div class="lh-info-row">
                                                        <div class="lh-info-col">
                                                            <div class="lh-info-label"><i class="bi bi-person-badge me-1 text-danger"></i> Kỹ thuật viên</div>
                                                            <div class="lh-info-value">@(item.HoTenNhanVien ?? "Chưa phân công")</div>
                                                        </div>
                                                        <div class="lh-info-col">
                                                            <div class="lh-info-label"><i class="bi bi-telephone me-1 text-danger"></i> Điện thoại</div>
                                                            <div class="lh-info-value">
                                                                @if (!string.IsNullOrEmpty(item.SoDienThoai))
                                                                {
                                                                    <a href="tel:@item.SoDienThoai" class="lh-phone-link">@item.SoDienThoai</a>
                                                                }
                                                                else
                                                                {
                                                                    <span>—</span>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>

                                                    @if (!string.IsNullOrEmpty(item.GhiChu))
                                                    {
                                                        <div class="lh-notes-box">
                                                            <div class="lh-info-label">📝 Ghi chú</div>
                                                            <div class="lh-notes-content">@item.GhiChu</div>
                                                        </div>
                                                    }

                                                    <!-- ACTION BUTTONS AREA (ĐỔI LỊCH HẸN / HỦY LỊCH HẸN / ĐẶT LỊCH LẠI) -->
                                                    <div class="lh-actions mt-3 pt-3 border-top d-flex align-items-center justify-content-end gap-2" id="lh-actions-@item.IdLichHen">
                                                        @if (item.TrangThai == "Chờ xác nhận" || item.TrangThai == "ChoXacNhan" || item.TrangThai == "Đã xác nhận" || item.TrangThai == "DaXacNhan")
                                                        {
                                                            <button type="button" 
                                                                    class="btn btn-primary btn-ripple rounded-pill px-4 btn-open-reschedule-modal" 
                                                                    style="font-size: 0.875rem;"
                                                                    data-id-lich-hen="@item.IdLichHen" 
                                                                    data-id-phieu="@Model.IdPhieu"
                                                                    data-ma-phieu="@Model.MaPhieu"
                                                                    data-ngay-hen="@(item.NgayHen?.ToString("yyyy-MM-dd") ?? "")"
                                                                    data-ngay-hen-display="@(item.NgayHen?.ToString("dd/MM/yyyy") ?? "")"
                                                                    data-gio-hen="@(item.GioHen?.ToString(@"hh\:mm") ?? "")"
                                                                    data-dia-chi="@(item.DiaChi ?? Model.DiaChiKhachHang ?? "")"
                                                                    data-trang-thai="@item.TrangThai"
                                                                    data-ktv="@(item.HoTenNhanVien ?? "Chưa phân công")"
                                                                    data-bs-toggle="modal" 
                                                                    data-bs-target="#rescheduleAppointmentModal">
                                                                <i class="fa-solid fa-calendar-days me-1"></i> Đổi lịch hẹn
                                                            </button>
                                                            <button type="button" 
                                                                    class="btn btn-danger btn-ripple rounded-pill px-4 btn-open-cancel-modal" 
                                                                    style="background-color: #EE0033 !important; border-color: #EE0033 !important; font-size: 0.875rem;"
                                                                    data-id-lich-hen="@item.IdLichHen" 
                                                                    data-id-phieu="@Model.IdPhieu"
                                                                    data-ma-phieu="@Model.MaPhieu"
                                                                    data-bs-toggle="modal" 
                                                                    data-bs-target="#cancelAppointmentModal">
                                                                <i class="fa-solid fa-ban me-1"></i> Hủy lịch hẹn
                                                            </button>
                                                        }
                                                        else if (item.TrangThai == "Đã hủy" || item.TrangThai == "DaHuy")
                                                        {
                                                            <a href="/Ticket/TaoLichHen?idPhieu=@Model.IdPhieu" 
                                                               class="btn btn-primary btn-ripple rounded-pill px-4" style="font-size: 0.875rem;">
                                                                <i class="bi bi-calendar-plus me-1"></i> Đặt lịch hẹn lại
                                                            </a>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="lh-empty-state">
                                        <span class="lh-empty-icon">📅</span>
                                        <h3 class="lh-empty-title">Chưa có lịch hẹn</h3>
                                        <p class="lh-empty-desc">Hiện tại chưa có lịch hẹn kỹ thuật viên khảo sát tại nhà.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- CARD 3: TIMELINE LỊCH SỬ XỬ LÝ -->
                    <div class="detail-card">
                        <div class="detail-card-head">
                            <div class="card-icon red">
                                <i class="fa-solid fa-clock-rotate-left"></i>
                            </div>
                            <h2 class="detail-card-title">Nhật ký & Tiến trình xử lý</h2>
                        </div>
                        <div class="detail-card-body">
                            <div class="timeline-flow">
                                @if (Model.LichSuXuLys != null && Model.LichSuXuLys.Any())
                                {
                                    @foreach (var step in Model.LichSuXuLys)
                                    {
                                        <div class="timeline-step">
                                            <div class="timeline-dot" style="display: flex; align-items: center; justify-content: center; background-color: var(--vt-red-glow);">
                                                <i class="fa-solid @(step.TrangThaiMoi switch {
                                                    "Chờ tiếp nhận" => "fa-circle-question text-warning",
                                                    "Đang xử lý" => "fa-spinner text-primary",
                                                    "Hoàn thành" => "fa-circle-check text-success",
                                                    "Đã hủy" => "fa-circle-xmark text-danger",
                                                    _ => "fa-info-circle text-info"
                                                })" style="font-size: 0.75rem;"></i>
                                            </div>
                                            <div class="timeline-card">
                                                <div class="timeline-header">
                                                    <span class="timeline-op-name"><i class="bi bi-person-badge text-danger me-1"></i> @step.TenNhanVien</span>
                                                    <span class="timeline-date">@step.ThoiGian</span>
                                                </div>
                                                <p class="timeline-desc">@step.NoiDung</p>
                                                @if (!string.IsNullOrEmpty(step.TrangThaiCu) && !string.IsNullOrEmpty(step.TrangThaiMoi) && step.TrangThaiCu != step.TrangThaiMoi)
                                                {
                                                    <div class="timeline-status-change">
                                                        <span>Trạng thái: </span>
                                                        <span class="status-old">@GetStatusText(step.TrangThaiCu)</span>
                                                        <i class="bi bi-arrow-right"></i>
                                                        <span class="status-new">@GetStatusText(step.TrangThaiMoi)</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="empty-state-box py-4">
                                        <i class="bi bi-clock empty-state-icon"></i>
                                        <h3 class="empty-state-title">Chưa có nhật ký hoạt động</h3>
                                        <p class="empty-state-desc">Phiếu hỗ trợ chưa phát sinh lịch sử xử lý.</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- CARD 4: TÀI LIỆU & FILE ĐÍNH KÈM -->
                    <div class="detail-card">
                        <div class="detail-card-head">
                            <div class="card-icon green">
                                <i class="fa-solid fa-paperclip"></i>
                            </div>
                            <h2 class="detail-card-title">Tài liệu & file đính kèm</h2>
                        </div>
                        <div class="detail-card-body">
                            @if (Model.FileDinhKems != null && Model.FileDinhKems.Any())
                            {
                                <div class="attach-grid">
                                    @foreach (var file in Model.FileDinhKems)
                                    {
                                        var isImg = file.LoaiFile != null && (file.LoaiFile.StartsWith("image/", StringComparison.OrdinalIgnoreCase) || 
                                                     file.TenFile.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) || 
                                                     file.TenFile.EndsWith(".png", StringComparison.OrdinalIgnoreCase) || 
                                                     file.TenFile.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) ||
                                                     file.TenFile.EndsWith(".gif", StringComparison.OrdinalIgnoreCase) ||
                                                     file.TenFile.EndsWith(".webp", StringComparison.OrdinalIgnoreCase));
                                        
                                        var isPdf = file.TenFile.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
                                        var isWord = file.TenFile.EndsWith(".doc", StringComparison.OrdinalIgnoreCase) || file.TenFile.EndsWith(".docx", StringComparison.OrdinalIgnoreCase);
                                        var isExcel = file.TenFile.EndsWith(".xls", StringComparison.OrdinalIgnoreCase) || file.TenFile.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase);
                                        
                                        var fileIcon = "bi-file-earmark-fill text-secondary";
                                        if (isImg) fileIcon = "bi-file-earmark-image-fill text-primary";
                                        else if (isPdf) fileIcon = "bi-file-earmark-pdf-fill text-danger";
                                        else if (isWord) fileIcon = "bi-file-earmark-word-fill text-primary";
                                        else if (isExcel) fileIcon = "bi-file-earmark-excel-fill text-success";
                                        
                                        var fileTypeLabel = "Khác";
                                        if (isImg) fileTypeLabel = "Hình ảnh";
                                        else if (isPdf) fileTypeLabel = "PDF";
                                        else if (isWord) fileTypeLabel = "Word";
                                        else if (isExcel) fileTypeLabel = "Excel";

                                        <div class="attach-card d-flex flex-column" style="min-height: 100%;">
                                            @if (isImg)
                                            {
                                                <div class="attach-image-preview mb-3" style="width: 100%; height: 160px; overflow: hidden; border-radius: 12px; border: 1.5px solid var(--border-color); background-color: #f8fafc; position: relative;">
                                                    <a href="@file.DuongDan" target="_blank" title="Xem ảnh đầy đủ" style="display: block; width: 100%; height: 100%;">
                                                        <img src="@file.DuongDan" alt="@file.TenFile" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" />
                                                    </a>
                                                </div>
                                            }
                                            <div class="attach-info-row d-flex align-items-start gap-2 flex-grow-1">
                                                <div class="attach-file-icon" style="font-size: 1.5rem; flex-shrink: 0; line-height: 1;">
                                                    <i class="bi @fileIcon"></i>
                                                </div>
                                                <div style="min-width: 0; flex: 1;">
                                                    <span class="attach-file-name fw-bold text-dark text-truncate d-block" title="@file.TenFile" style="font-size: 0.88rem;">@file.TenFile</span>
                                                    <span class="attach-file-size text-muted small d-block" style="font-size: 0.75rem; margin-top: 2px;">
                                                        Loại: <strong>@fileTypeLabel</strong> | Dung lượng: <strong>@file.DungLuong</strong>
                                                    </span>
                                                    <span class="attach-file-size text-muted small d-block" style="font-size: 0.72rem; margin-top: 2px;">
                                                        Người tải: <strong>@file.NguoiTai</strong> | @file.NgayUpload
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="d-flex gap-2 mt-3">
                                                <a href="@file.DuongDan" class="btn btn-outline-secondary btn-sm flex-grow-1" target="_blank">
                                                    <i class="bi bi-eye"></i> Xem
                                                </a>
                                                <a href="@file.DuongDan" class="btn btn-danger btn-sm flex-grow-1" style="background-color: #EE0033; border-color: #EE0033;" download="@file.TenFile">
                                                    <i class="bi bi-download"></i> Tải về
                                                </a>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="empty-state-box">
                                    <i class="bi bi-folder-symlink empty-state-icon"></i>
                                    <h3 class="empty-state-title">Không có tệp đính kèm</h3>
                                    <p class="empty-state-desc">Phiếu hỗ trợ này chưa được đính kèm bất kỳ hình ảnh hoặc tài liệu nào.</p>
                                </div>
                            }
                        </div>
                    </div>

                </div>

                <!-- RIGHT COLUMN (Metadata/Side Cards) -->
                <div class="col-lg-4 col-md-12">
                    
                    <!-- CARD 5: THÔNG TIN KHÁCH HÀNG -->
                    <div class="detail-card">
                        <div class="detail-card-head">
                            <div class="card-icon red">
                                <i class="fa-solid fa-user-tie"></i>
                            </div>
                            <h2 class="detail-card-title">Thông tin khách hàng</h2>
                        </div>
                        <div class="detail-card-body">
                            <div class="d-flex flex-column gap-3">
                                <div class="data-cell">
                                    <span class="cell-lbl"><i class="bi bi-person-fill"></i> Họ và tên</span>
                                    <span class="cell-val">@Model.HoTen</span>
                                </div>
                                <div class="data-cell">
                                    <span class="cell-lbl"><i class="bi bi-telephone-fill"></i> Số điện thoại</span>
                                    <span class="cell-val">@Model.SoDienThoai</span>
                                </div>
                                <div class="data-cell">
                                    <span class="cell-lbl"><i class="bi bi-envelope-fill"></i> Email</span>
                                    <span class="cell-val">@Model.Email</span>
                                </div>
                                <div class="data-cell">
                                    <span class="cell-lbl"><i class="bi bi-geo-alt-fill"></i> Địa chỉ</span>
                                    <span class="cell-val">@(Model.DiaChiKhachHang ?? "Chưa cung cấp")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- CARD 6: THÔNG TIN DỊCH VỤ -->
                    <div class="detail-card">
                        <div class="detail-card-head">
                            <div class="card-icon blue">
                                <i class="fa-solid fa-network-wired"></i>
                            </div>
                            <h2 class="detail-card-title">Dịch vụ yêu cầu</h2>
                        </div>
                        <div class="detail-card-body">
                            <div class="d-flex flex-column gap-3">
                                <div class="data-cell">
                                    <span class="cell-lbl"><i class="bi bi-tag-fill"></i> Danh mục sự cố</span>
                                    <span class="cell-val">@Model.TenDanhMuc</span>
                                </div>
                                <div class="data-cell">
                                    <span class="cell-lbl"><i class="bi bi-hdd-network-fill"></i> Dịch vụ chi tiết</span>
                                    <span class="cell-val text-danger">@Model.TenDichVu</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- CARD 7: NHÂN VIÊN PHỤ TRÁCH -->
                    <div class="detail-card">
                        <div class="detail-card-head">
                            <div class="card-icon red">
                                <i class="bi bi-person-badge-fill"></i>
                            </div>
                            <h2 class="detail-card-title">Kỹ thuật viên phụ trách</h2>
                        </div>
                        <div class="detail-card-body">
                            @if (!string.IsNullOrEmpty(Model.TenNhanVien))
                            {
                                <div class="d-flex flex-column gap-3">
                                    <div class="data-cell">
                                        <span class="cell-lbl"><i class="bi bi-person-check-fill"></i> Họ tên</span>
                                        <span class="cell-val">@Model.TenNhanVien</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(Model.MaNhanVien))
                                    {
                                        <div class="data-cell">
                                            <span class="cell-lbl"><i class="bi bi-hash"></i> Mã nhân viên</span>
                                            <span class="cell-val">@Model.MaNhanVien</span>
                                        </div>
                                    }
                                    <div class="data-cell">
                                        <span class="cell-lbl"><i class="bi bi-telephone-outbound-fill"></i> Điện thoại liên hệ</span>
                                        <span class="cell-val"><a href="tel:@Model.SoDienThoaiNV" class="text-danger text-decoration-none fw-bold">@Model.SoDienThoaiNV</a></span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(Model.EmailNV))
                                    {
                                        <div class="data-cell">
                                            <span class="cell-lbl"><i class="bi bi-envelope-at-fill"></i> Email</span>
                                            <span class="cell-val">@Model.EmailNV</span>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.VaiTroNV))
                                    {
                                        <div class="data-cell">
                                            <span class="cell-lbl"><i class="bi bi-briefcase-fill"></i> Vai trò</span>
                                            <span class="cell-val">@Model.VaiTroNV</span>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="empty-state-box py-3 bg-light border-0">
                                    <i class="bi bi-person-x-fill empty-state-icon text-muted" style="font-size: 2rem;"></i>
                                    <h4 class="empty-state-title fs-6 text-muted">Chưa phân công nhân viên</h4>
                                    <p class="empty-state-desc" style="font-size: 0.75rem;">Yêu cầu hỗ trợ đang được tiếp nhận và điều phối kỹ thuật viên.</p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- CARD 8: ĐÁNH GIÁ DỊCH VỤ -->
                    <div class="detail-card" id="card-danh-gia">
                        <div class="detail-card-head">
                            <div class="card-icon green">
                                <i class="fa-solid fa-star"></i>
                            </div>
                            <h2 class="detail-card-title">Đánh giá của bạn</h2>
                        </div>
                        <div class="detail-card-body">
                            @if (Model.DanhGia != null)
                            {
                                <div class="d-flex flex-column">
                                    <div class="rating-metric-item">
                                        <span class="rating-metric-lbl">Chất lượng dịch vụ</span>
                                        <div class="rating-stars-row">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="bi @(i <= Model.DanhGia.ChatLuongDichVu ? "bi-star-fill" : "bi-star")"></i>
                                            }
                                        </div>
                                    </div>
                                    <div class="rating-metric-item">
                                        <span class="rating-metric-lbl">Thái độ kỹ thuật viên</span>
                                        <div class="rating-stars-row">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="bi @(i <= Model.DanhGia.ThaiDoNhanVien ? "bi-star-fill" : "bi-star")"></i>
                                            }
                                        </div>
                                    </div>
                                    <div class="rating-metric-item">
                                        <span class="rating-metric-lbl">Tốc độ xử lý sự cố</span>
                                        <div class="rating-stars-row">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="bi @(i <= Model.DanhGia.TocDoXuLy ? "bi-star-fill" : "bi-star")"></i>
                                            }
                                        </div>
                                    </div>

                                    @if (!string.IsNullOrEmpty(Model.DanhGia.NhanXet))
                                    {
                                        <div class="review-comment-box">
                                            <span class="review-comment-title"><i class="bi bi-chat-quote-fill me-1"></i> Ý kiến đóng góp</span>
                                            <p class="review-comment-desc">"@Model.DanhGia.NhanXet"</p>
                                            <small class="text-muted d-block mt-2 text-end">Ngày gửi: @Model.DanhGia.NgayDanhGia?.ToString("dd/MM/yyyy")</small>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="empty-state-box py-4 bg-light border-0">
                                    <i class="bi bi-star empty-state-icon text-muted" style="font-size: 2rem;"></i>
                                    <h4 class="empty-state-title fs-6 text-muted">Chưa đánh giá</h4>
                                    <p class="empty-state-desc" style="font-size: 0.75rem;">Yêu cầu hỗ trợ chưa được đánh giá chất lượng dịch vụ.</p>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- CARD 9: PHẢN HỒI TỪ NHÂN VIÊN -->
                    @if (Model.DanhGia != null)
                    {
                        if (Model.DaPhanHoi)
                        {
                            <div class="detail-card feedback-card animate-fade-up mt-3">
                                <div class="detail-card-head border-0 pb-0 mb-3 bg-transparent">
                                    <div class="card-icon">
                                        <i class="fa-solid fa-reply"></i>
                                    </div>
                                    <h2 class="detail-card-title text-dark">Phản hồi từ Nhân viên hỗ trợ</h2>
                                </div>
                                <div class="detail-card-body p-0">
                                    <div class="d-flex align-items-center mb-3">
                                        <div class="avatar-wrap me-3">
                                            <img src="@(string.IsNullOrEmpty(Model.AvatarNhanVien) ? "https://ui-avatars.com/api/?name=" + System.Net.WebUtility.UrlEncode(Model.TenNhanVienPhanHoi ?? "Staff") + "&background=EE0033&color=fff" : Model.AvatarNhanVien)" alt="Avatar nhân viên phản hồi" />
                                        </div>
                                        <div>
                                            <h4 class="m-0 fw-bold text-dark fs-6">@Model.TenNhanVienPhanHoi</h4>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary" style="font-size: 0.7rem; font-weight: 700; padding: 2px 6px;">Nhân viên Hỗ trợ</span>
                                                <span class="text-muted" style="font-size: 0.75rem;"><i class="bi bi-clock me-1"></i>@(Model.NgayPhanHoi?.ToString("dd/MM/yyyy HH:mm"))</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="feedback-content-box p-3 bg-white border rounded-3">
                                        @Model.PhanHoiNhanVien
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="detail-card feedback-card pending animate-fade-up mt-3">
                                <div class="detail-card-head border-0 pb-0 mb-3 bg-transparent align-items-center">
                                    <div class="card-icon">
                                        <i class="bi bi-clock-history"></i>
                                    </div>
                                    <h2 class="detail-card-title text-dark">Phản hồi từ Nhân viên hỗ trợ</h2>
                                    <span class="badge bg-warning-subtle text-warning border border-warning ms-auto" style="font-size: 0.72rem; font-weight: 700; padding: 4px 8px; background-color: #FFFBEB !important;">Chưa phản hồi</span>
                                </div>
                                <div class="detail-card-body p-0">
                                    <p class="m-0 fw-bold text-warning-emphasis" style="font-size: 0.9rem;"><i class="bi bi-exclamation-circle-fill me-1"></i> Nhân viên chưa phản hồi đánh giá của bạn.</p>
                                </div>
                            </div>
                        }
                    }

                </div>

            </div>

            <!-- ACTION BUTTONS BAR -->
            <div class="action-buttons-layout">
                <div class="action-btn-group">
                    <a asp-controller="Customers" asp-action="PhieuCuaToi" class="btn btn-viettel btn-outline" style="color: white !important;">
                        <i class="bi bi-arrow-left"></i> Danh sách phiếu
                    </a>
                    @if (!string.IsNullOrEmpty(Model.TenNhanVien))
                    {
                        <a href="/LiveSupport?maPhieu=@Model.MaPhieu" class="btn btn-viettel btn-red" style="background-color: #EE0033 !important; color: white !important; border: none !important;">
                            <i class="bi bi-chat-dots-fill"></i> Trao đổi nhân viên
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Customers" asp-action="LienHe" class="btn btn-viettel btn-outline">
                            <i class="bi bi-telephone-inbound"></i> Liên hệ hỗ trợ
                        </a>
                    }
                </div>

                <div class="action-btn-group">
                    <a asp-controller="Ticket" asp-action="InPhieuPDF" asp-route-id="@Model.IdPhieu" class="btn btn-viettel btn-red" style="background-color: #EE0033 !important; color: white !important; border: none !important;">
                        <i class="fa-solid fa-print"></i> In Phiếu
                    </a>

                    @if ((Model.TrangThai == "Hoàn thành" || Model.TrangThai == "DaHoanThanh" || Model.TrangThai == "Đã hoàn thành") && Model.DanhGia == null)
                    {
                        <a asp-controller="Ticket" asp-action="DanhGiaPhieu" asp-route-id="@Model.IdPhieu" class="btn btn-viettel btn-red">
                            <i class="bi bi-star"></i> Đánh giá dịch vụ
                        </a>
                    }
                </div>
            </div>

        </div>
    </main>

    <!-- ==================== FOOTER ==================== -->
    @* @await Html.PartialAsync("_Footer") *@

    <!-- Auto Print Script Triggers -->
    @if (ViewData["IsPrint"] is bool isPrint && isPrint)
    {
        <script>
            window.addEventListener('DOMContentLoaded', () => {
                setTimeout(() => {
                    window.print();
                }, 500);
            });
        </script>
    }

    <!-- =========================================================
       MODAL 1: XÁC NHẬN HỦY LỊCH HẸN (GLASSMORPHISM & FADE ANIMATION)
       ========================================================= -->
    <div class="modal fade" id="cancelAppointmentModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden" style="background: rgba(255, 255, 255, 0.96); backdrop-filter: blur(16px);">
                <div class="modal-header border-0 bg-danger text-white p-4 d-flex align-items-center justify-content-between position-relative">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-white text-danger d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                            <i class="fa-solid fa-ban fs-5"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold m-0 text-white">Xác nhận hủy lịch hẹn</h5>
                            <span class="small text-white-50">Phiếu hỗ trợ #<span id="cancelModalMaPhieuText">@Model.MaPhieu</span></span>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <form id="cancelAppointmentForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="hiddenIdLichHen" name="idLichHen" value="0" />

                        <div class="alert alert-warning border-0 rounded-3 p-3 mb-3 text-dark small" style="background-color: #FFFBEB;">
                            <i class="bi bi-exclamation-triangle-fill text-warning me-1"></i>
                            <strong>Bạn có chắc chắn muốn hủy lịch hẹn này?</strong><br />
                            Sau khi hủy, lịch hẹn sẽ không còn hiệu lực và kỹ thuật viên sẽ không thể đến khảo sát theo khung giờ này.
                        </div>

                        <!-- Dropdown lý do hủy -->
                        <div class="mb-3">
                            <label for="lyDoHuySelect" class="form-label fw-bold text-dark small">Lý do hủy lịch hẹn <span class="text-danger">*</span></label>
                            <select id="lyDoHuySelect" name="lyDoHuy" class="form-select rounded-3">
                                <option value="Bận việc" selected>Bận việc</option>
                                <option value="Muốn đổi thời gian">Muốn đổi thời gian</option>
                                <option value="Không còn nhu cầu">Không còn nhu cầu</option>
                                <option value="Đặt nhầm lịch">Đặt nhầm lịch</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>

                        <!-- Textarea nếu chọn Khác -->
                        <div class="mb-3" id="noiDungKhacArea" style="display: none;">
                            <label for="txtNoiDungKhac" class="form-label fw-bold text-dark small">Chi tiết lý do khác <span class="text-danger">*</span></label>
                            <textarea id="txtNoiDungKhac" name="noiDungKhac" class="form-control rounded-3" rows="3" placeholder="Vui lòng ghi rõ lý do hủy..."></textarea>
                        </div>

                        <!-- Checkbox xác nhận -->
                        <div class="form-check mb-2">
                            <input type="checkbox" id="chkConfirmCancel" class="form-check-input" />
                            <label for="chkConfirmCancel" class="form-check-label fw-bold text-dark small"
                                Tôi xác nhận muốn hủy lịch hẹn.
                            </label>
                        </div>
                    </form>
                </div>
                <div class="modal-footer border-0 bg-light p-3 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" id="btnSubmitCancelAppointment" class="btn btn-danger rounded-pill px-4" disabled style="background-color: #EE0033 !important; border: none !important;">
                        <i class="fa-solid fa-ban me-1"></i> Xác nhận hủy
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- =========================================================
       MODAL 2: HỦY LỊCH HẸN THÀNH CÔNG POPUP
       ========================================================= -->
    <div class="modal fade" id="cancelSuccessModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header border-0 bg-success text-white p-4 text-center d-flex flex-column align-items-center">
                    <div class="rounded-circle bg-white text-success d-flex align-items-center justify-content-center shadow mb-2" style="width: 64px; height: 64px;">
                        <i class="bi bi-check-lg display-5 fw-bold text-success"></i>
                    </div>
                    <h4 class="fw-bold m-0 text-white">Đã Hủy Lịch Hẹn</h4>
                </div>
                <div class="modal-body p-4 text-center bg-light">
                    <p class="text-secondary mb-3 fs-7">
                        Lịch hẹn hỗ trợ đã được hủy thành công trên hệ thống Viettel Telecom.<br />
                        Bạn có thể tạo lịch hẹn mới bất kỳ lúc nào nếu vẫn cần kỹ thuật viên hỗ trợ.
                    </p>
                </div>
                <div class="modal-footer border-0 bg-light p-3 d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                    <a href="/Ticket/TaoLichHen?idPhieu=@Model.IdPhieu" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-calendar-plus me-1"></i> Đặt lịch lại
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- =========================================================
       MODAL 3: ĐỔI LỊCH HẸN HỖ TRỢ (GLASSMORPHISM & LIVE SLOTS)
       ========================================================= -->
    <div class="modal fade" id="rescheduleAppointmentModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden" style="background: rgba(255, 255, 255, 0.98); backdrop-filter: blur(16px);">
                <div class="modal-header border-0 bg-primary text-white p-4 d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-white text-primary d-flex align-items-center justify-content-center shadow-sm" style="width: 44px; height: 44px;">
                            <i class="fa-solid fa-calendar-days fs-5"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold m-0 text-white">Đổi lịch hẹn hỗ trợ</h5>
                            <span class="small text-white-50">Phiếu hỗ trợ #<span id="rescheduleModalMaPhieuText">@Model.MaPhieu</span></span>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- THÔNG TIN LỊCH HẸN HIỆN TẠI CARD -->
                    <div class="card border-0 bg-light rounded-3 p-3 mb-4">
                        <h6 class="fw-bold text-secondary mb-2 small text-uppercase"><i class="bi bi-clock-history me-1"></i> Lịch hẹn hiện tại</h6>
                        <div class="row g-2 small">
                            <div class="col-6 col-md-3">
                                <span class="text-muted d-block"><i class="bi bi-calendar-event text-danger me-1"></i> Ngày hẹn:</span>
                                <strong id="rescheduleOldDateText" class="text-dark">—</strong>
                            </div>
                            <div class="col-6 col-md-3">
                                <span class="text-muted d-block"><i class="bi bi-clock text-danger me-1"></i> Khung giờ:</span>
                                <strong id="rescheduleOldTimeText" class="text-dark">—</strong>
                            </div>
                            <div class="col-6 col-md-3">
                                <span class="text-muted d-block"><i class="bi bi-info-circle text-danger me-1"></i> Trạng thái:</span>
                                <span id="rescheduleOldStatusBadge" class="badge bg-warning text-dark">—</span>
                            </div>
                            <div class="col-6 col-md-3">
                                <span class="text-muted d-block"><i class="bi bi-person-badge text-danger me-1"></i> KTV phụ trách:</span>
                                <span id="rescheduleOldKtvText" class="fw-bold text-primary">—</span>
                            </div>
                            <div class="col-12 mt-2">
                                <span class="text-muted d-block"><i class="bi bi-geo-alt-fill text-danger me-1"></i> Địa chỉ hiện tại:</span>
                                <span id="rescheduleOldAddressText" class="text-dark fw-medium">—</span>
                            </div>
                        </div>
                    </div>

                    <form id="rescheduleAppointmentForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="rescheduleHiddenIdLichHen" name="idLichHen" value="0" />

                        <div class="row g-3">
                            <!-- 1. CHỌN NGÀY MỚI (DATEPICKER) -->
                            <div class="col-md-6">
                                <label for="txtNgayHenMoi" class="form-label fw-bold text-dark small"><i class="bi bi-calendar3 text-danger me-1"></i> Chọn ngày hẹn mới <span class="text-danger">*</span></label>
                                <input type="date" 
                                       id="txtNgayHenMoi" 
                                       name="ngayHenMoi" 
                                       class="form-control rounded-3" 
                                       min="@DateTime.Today.ToString("yyyy-MM-dd")" 
                                       value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" 
                                       required />
                                <span class="form-text small text-muted">Vui lòng chọn từ ngày hôm nay trở đi.</span>
                            </div>

                            <!-- 2. CHỌN KHUNG GIỜ MỚI (SQL LOADED) -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold text-dark small"><i class="bi bi-alarm text-danger me-1"></i> Chọn khung giờ mới <span class="text-danger">*</span></label>
                                <div id="slotContainer" class="d-flex flex-column gap-2">
                                    <div class="form-check p-2 border rounded-3 d-flex align-items-center justify-content-between slot-item">
                                        <div>
                                            <input class="form-check-input me-2" type="radio" name="khungGioMoi" id="slot1" value="08:00-10:00" checked />
                                            <label class="form-check-label fw-medium text-dark cursor-pointer" for="slot1">08:00 - 10:00</label>
                                        </div>
                                        <span class="badge bg-success slot-badge" id="slotBadge-08:00-10:00">Còn trống</span>
                                    </div>
                                    <div class="form-check p-2 border rounded-3 d-flex align-items-center justify-content-between slot-item">
                                        <div>
                                            <input class="form-check-input me-2" type="radio" name="khungGioMoi" id="slot2" value="10:00-12:00" />
                                            <label class="form-check-label fw-medium text-dark cursor-pointer" for="slot2">10:00 - 12:00</label>
                                        </div>
                                        <span class="badge bg-success slot-badge" id="slotBadge-10:00-12:00">Còn trống</span>
                                    </div>
                                    <div class="form-check p-2 border rounded-3 d-flex align-items-center justify-content-between slot-item">
                                        <div>
                                            <input class="form-check-input me-2" type="radio" name="khungGioMoi" id="slot3" value="13:00-15:00" />
                                            <label class="form-check-label fw-medium text-dark cursor-pointer" for="slot3">13:00 - 15:00</label>
                                        </div>
                                        <span class="badge bg-success slot-badge" id="slotBadge-13:00-15:00">Còn trống</span>
                                    </div>
                                    <div class="form-check p-2 border rounded-3 d-flex align-items-center justify-content-between slot-item">
                                        <div>
                                            <input class="form-check-input me-2" type="radio" name="khungGioMoi" id="slot4" value="15:00-17:00" />
                                            <label class="form-check-label fw-medium text-dark cursor-pointer" for="slot4">15:00 - 17:00</label>
                                        </div>
                                        <span class="badge bg-success slot-badge" id="slotBadge-15:00-17:00">Còn trống</span>
                                    </div>
                                </div>
                            </div>

                            <!-- 3. ĐỊA CHỈ HỖ TRỢ -->
                            <div class="col-12">
                                <label for="txtDiaChiHoTroMoi" class="form-label fw-bold text-dark small"><i class="bi bi-geo-alt-fill text-danger me-1"></i> Địa chỉ hỗ trợ tại nhà <span class="text-danger">*</span></label>
                                <input type="text" 
                                       id="txtDiaChiHoTroMoi" 
                                       name="diaChiHoTro" 
                                       class="form-control rounded-3" 
                                       placeholder="Nhập địa chỉ hỗ trợ..." 
                                       required />
                            </div>

                            <!-- 4. GHI CHÚ BỔ SUNG -->
                            <div class="col-12">
                                <label for="txtGhiChuMoi" class="form-label fw-bold text-dark small"><i class="bi bi-pencil-square text-danger me-1"></i> Ghi chú cho kỹ thuật viên</label>
                                <textarea id="txtGhiChuMoi" 
                                          name="ghiChu" 
                                          class="form-control rounded-3" 
                                          rows="2" 
                                          placeholder="Ghi chú thêm về yêu cầu hỗ trợ (Không bắt buộc)..."></textarea>
                            </div>

                            <!-- 5. LÝ DO ĐỔI LỊCH -->
                            <div class="col-12">
                                <label for="lyDoDoiLichSelect" class="form-label fw-bold text-dark small"><i class="bi bi-question-circle text-danger me-1"></i> Lý do đổi lịch hẹn <span class="text-danger">*</span></label>
                                <select id="lyDoDoiLichSelect" name="lyDoDoiLich" class="form-select rounded-3">
                                    <option value="Bận việc" selected>Bận việc</option>
                                    <option value="Muốn đổi thời gian">Muốn đổi thời gian</option>
                                    <option value="Có việc đột xuất">Có việc đột xuất</option>
                                    <option value="Không có mặt tại nhà">Không có mặt tại nhà</option>
                                    <option value="Khác">Khác</option>
                                </select>
                            </div>

                            <!-- TEXTAREA NẾU CHỌN KHÁC -->
                            <div class="col-12" id="noiDungDoiKhacArea" style="display: none;">
                                <label for="txtNoiDungDoiKhac" class="form-label fw-bold text-dark small">Chi tiết lý do khác <span class="text-danger">*</span></label>
                                <textarea id="txtNoiDungDoiKhac" name="noiDungKhac" class="form-control rounded-3" rows="2" placeholder="Nhập lý do chi tiết..."></textarea>
                            </div>

                            <!-- CHECKBOX XÁC NHẬN -->
                            <div class="col-12 mt-3">
                                <div class="form-check">
                                    <input type="checkbox" id="chkConfirmReschedule" class="form-check-input" />
                                    <label for="chkConfirmReschedule" class="form-check-label fw-bold text-dark small cursor-pointer">
                                        Tôi xác nhận muốn đổi lịch hẹn.
                                    </label>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer border-0 bg-light p-3 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" id="btnSubmitRescheduleAppointment" class="btn btn-primary rounded-pill px-4" disabled>
                        <i class="fa-solid fa-calendar-check me-1"></i> Xác nhận đổi lịch
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- =========================================================
       MODAL 4: YÊU CẦU ĐỔI LỊCH THÀNH CÔNG POPUP
       ========================================================= -->
    <div class="modal fade" id="rescheduleSuccessModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header border-0 bg-success text-white p-4 text-center d-flex flex-column align-items-center">
                    <div class="rounded-circle bg-white text-success d-flex align-items-center justify-content-center shadow mb-2" style="width: 64px; height: 64px;">
                        <i class="bi bi-check-lg display-5 fw-bold text-success"></i>
                    </div>
                    <h4 class="fw-bold m-0 text-white">Yêu Cầu Đổi Lịch Đã Được Gửi</h4>
                </div>
                <div class="modal-body p-4 text-center bg-light">
                    <p class="text-secondary mb-3 fs-7">
                        Yêu cầu đổi lịch hẹn đã được gửi thành công.<br />
                        Quản trị viên sẽ xác nhận lịch hẹn mới trong thời gian sớm nhất.
                    </p>
                </div>
                <div class="modal-footer border-0 bg-light p-3 d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-success rounded-pill px-4" data-bs-dismiss="modal">
                        <i class="bi bi-calendar-check me-1"></i> Xem lịch hẹn
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== SCRIPTS ==================== -->
    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>

    <!-- Component-Based scripts -->
    <script src="~/assets/js/header.js" asp-append-version="true"></script>
    <script src="~/assets/js/chatbox.js" asp-append-version="true"></script>
    <script src="~/assets/js/main.js" asp-append-version="true"></script>
    <script>
        if (window.initHeader) {
            window.initHeader();
        }

        // =========================================================================
        // AJAX & SPA HANDLER FOR CANCEL APPOINTMENT AT /Ticket/ChiTietPhieu
        // =========================================================================
        document.addEventListener('DOMContentLoaded', () => {
            let selectedCancelLichHenId = 0;

            document.addEventListener('click', (e) => {
                const btnCancel = e.target.closest('.btn-open-cancel-modal');
                if (btnCancel) {
                    selectedCancelLichHenId = parseInt(btnCancel.dataset.idLichHen, 10) || 0;
                    document.getElementById('hiddenIdLichHen').value = selectedCancelLichHenId;

                    const lyDoSelect = document.getElementById('lyDoHuySelect');
                    if (lyDoSelect) lyDoSelect.value = 'Bận việc';
                    const noiDungArea = document.getElementById('noiDungKhacArea');
                    if (noiDungArea) noiDungArea.style.display = 'none';
                    const txtNoiDung = document.getElementById('txtNoiDungKhac');
                    if (txtNoiDung) txtNoiDung.value = '';
                    const chkConfirm = document.getElementById('chkConfirmCancel');
                    if (chkConfirm) chkConfirm.checked = false;
                    const btnSubmit = document.getElementById('btnSubmitCancelAppointment');
                    if (btnSubmit) btnSubmit.disabled = true;
                }
            });

            const lyDoSelect = document.getElementById('lyDoHuySelect');
            if (lyDoSelect) {
                lyDoSelect.addEventListener('change', () => {
                    const noiDungArea = document.getElementById('noiDungKhacArea');
                    if (noiDungArea) {
                        noiDungArea.style.display = lyDoSelect.value === 'Khác' ? 'block' : 'none';
                    }
                    validateCancelForm();
                });
            }

            const chkConfirm = document.getElementById('chkConfirmCancel');
            if (chkConfirm) {
                chkConfirm.addEventListener('change', validateCancelForm);
            }

            const txtNoiDung = document.getElementById('txtNoiDungKhac');
            if (txtNoiDung) {
                txtNoiDung.addEventListener('input', validateCancelForm);
            }

            function validateCancelForm() {
                const btnSubmit = document.getElementById('btnSubmitCancelAppointment');
                if (!btnSubmit) return;

                const isChecked = chkConfirm && chkConfirm.checked;
                const isKhac = lyDoSelect && lyDoSelect.value === 'Khác';
                const hasText = txtNoiDung && txtNoiDung.value.trim().length > 0;

                if (isChecked && (!isKhac || (isKhac && hasText))) {
                    btnSubmit.disabled = false;
                } else {
                    btnSubmit.disabled = true;
                }
            }

            const btnSubmitCancel = document.getElementById('btnSubmitCancelAppointment');
            if (btnSubmitCancel) {
                btnSubmitCancel.addEventListener('click', async () => {
                    const form = document.getElementById('cancelAppointmentForm');
                    if (!form) return;

                    btnSubmitCancel.disabled = true;
                    btnSubmitCancel.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status"></span> Đang xử lý...`;

                    try {
                        const formData = new FormData(form);
                        const response = await fetch('/Ticket/HuyLichHen', {
                            method: 'POST',
                            body: formData
                        });

                        const data = await response.json();

                        if (data.success) {
                            // Hide confirmation modal
                            const modalElem = document.getElementById('cancelAppointmentModal');
                            if (modalElem && window.bootstrap) {
                                const modalInstance = bootstrap.Modal.getInstance(modalElem);
                                if (modalInstance) modalInstance.hide();
                            }

                            // Show Success modal
                            const successModalElem = document.getElementById('cancelSuccessModal');
                            if (successModalElem && window.bootstrap) {
                                const successModal = new bootstrap.Modal(successModalElem);
                                successModal.show();
                            }

                            // SPA UI UPDATE: Update Badge & Buttons dynamically without F5
                            const targetBadge = document.getElementById(`lh-badge-${selectedCancelLichHenId}`);
                            if (targetBadge) {
                                targetBadge.className = 'lh-badge lh-status-cancelled';
                                targetBadge.innerHTML = `<span class="status-dot"></span> Đã hủy`;
                            }

                            const targetActions = document.getElementById(`lh-actions-${selectedCancelLichHenId}`);
                            if (targetActions) {
                                targetActions.innerHTML = `
                                    <a href="/Ticket/TaoLichHen?idPhieu=${data.idPhieu}" class="btn btn-primary btn-ripple rounded-pill px-4" style="font-size: 0.875rem;">
                                        <i class="bi bi-calendar-plus me-1"></i> Đặt lịch hẹn lại
                                    </a>
                                `;
                            }
                        } else {
                            alert(data.message || 'Không thể hủy lịch hẹn.');
                        }
                    } catch (err) {
                        console.error('Lỗi AJAX hủy lịch hẹn:', err);
                        alert('Lỗi kết nối khi gửi yêu cầu hủy lịch hẹn.');
                    } finally {
                        btnSubmitCancel.disabled = false;
                        btnSubmitCancel.innerHTML = `<i class="fa-solid fa-ban me-1"></i> Xác nhận hủy`;
                    }
                });
            }

            // =========================================================================
            // AJAX & SPA HANDLER FOR RESCHEDULING APPOINTMENT
            // =========================================================================
            let selectedRescheduleLichHenId = 0;

            document.addEventListener('click', (e) => {
                const btnReschedule = e.target.closest('.btn-open-reschedule-modal');
                if (btnReschedule) {
                    selectedRescheduleLichHenId = parseInt(btnReschedule.dataset.idLichHen, 10) || 0;
                    const hiddenId = document.getElementById('rescheduleHiddenIdLichHen');
                    if (hiddenId) hiddenId.value = selectedRescheduleLichHenId;

                    // Fill current details into card
                    const oldDate = document.getElementById('rescheduleOldDateText');
                    if (oldDate) oldDate.textContent = btnReschedule.dataset.ngayHenDisplay || '—';
                    const oldTime = document.getElementById('rescheduleOldTimeText');
                    if (oldTime) oldTime.textContent = btnReschedule.dataset.gioHen || '—';
                    const oldStatus = document.getElementById('rescheduleOldStatusBadge');
                    if (oldStatus) oldStatus.textContent = btnReschedule.dataset.trangThai || 'Chờ xác nhận';
                    const oldKtv = document.getElementById('rescheduleOldKtvText');
                    if (oldKtv) oldKtv.textContent = btnReschedule.dataset.ktv || 'Chưa phân công';
                    const oldAddress = document.getElementById('rescheduleOldAddressText');
                    if (oldAddress) oldAddress.textContent = btnReschedule.dataset.diaChi || '—';

                    // Reset form fields
                    const txtAddress = document.getElementById('txtDiaChiHoTroMoi');
                    if (txtAddress) txtAddress.value = btnReschedule.dataset.diaChi || '';
                    const txtNotes = document.getElementById('txtGhiChuMoi');
                    if (txtNotes) txtNotes.value = '';
                    const lyDoSelect = document.getElementById('lyDoDoiLichSelect');
                    if (lyDoSelect) lyDoSelect.value = 'Bận việc';
                    const noiDungKhacArea = document.getElementById('noiDungDoiKhacArea');
                    if (noiDungKhacArea) noiDungKhacArea.style.display = 'none';
                    const txtNoiDungKhac = document.getElementById('txtNoiDungDoiKhac');
                    if (txtNoiDungKhac) txtNoiDungKhac.value = '';
                    const chkConfirm = document.getElementById('chkConfirmReschedule');
                    if (chkConfirm) chkConfirm.checked = false;
                    const btnSubmit = document.getElementById('btnSubmitRescheduleAppointment');
                    if (btnSubmit) btnSubmit.disabled = true;

                    fetchSlotAvailability();
                }
            });

            async function fetchSlotAvailability() {
                const txtDate = document.getElementById('txtNgayHenMoi');
                if (!txtDate || !txtDate.value) return;

                try {
                    const response = await fetch(`/Ticket/KiemTraKhungGio?date=${encodeURIComponent(txtDate.value)}`);
                    const data = await response.json();

                    if (data.success && data.slots) {
                        data.slots.forEach(s => {
                            const badge = document.getElementById(`slotBadge-${s.slotId}`);
                            if (badge) {
                                badge.textContent = s.statusText;
                                badge.className = `badge ${s.badgeClass} slot-badge`;
                            }
                            const radio = document.querySelector(`input[name="khungGioMoi"][value="${s.slotId}"]`);
                            if (radio) {
                                radio.disabled = s.isFull;
                                if (s.isFull && radio.checked) {
                                    const firstAvailable = document.querySelector('input[name="khungGioMoi"]:not(:disabled)');
                                    if (firstAvailable) firstAvailable.checked = true;
                                }
                            }
                        });
                    }
                } catch (err) {
                    console.error('Lỗi kiểm tra khung giờ:', err);
                }
            }

            const txtNgayHenMoiInput = document.getElementById('txtNgayHenMoi');
            if (txtNgayHenMoiInput) {
                txtNgayHenMoiInput.addEventListener('change', fetchSlotAvailability);
            }

            const lyDoDoiSelect = document.getElementById('lyDoDoiLichSelect');
            if (lyDoDoiSelect) {
                lyDoDoiSelect.addEventListener('change', () => {
                    const noiDungArea = document.getElementById('noiDungDoiKhacArea');
                    if (noiDungArea) {
                        noiDungArea.style.display = lyDoDoiSelect.value === 'Khác' ? 'block' : 'none';
                    }
                    validateRescheduleForm();
                });
            }

            const chkConfirmReschedule = document.getElementById('chkConfirmReschedule');
            if (chkConfirmReschedule) {
                chkConfirmReschedule.addEventListener('change', validateRescheduleForm);
            }

            const txtNoiDungDoiKhacInput = document.getElementById('txtNoiDungDoiKhac');
            if (txtNoiDungDoiKhacInput) {
                txtNoiDungDoiKhacInput.addEventListener('input', validateRescheduleForm);
            }

            function validateRescheduleForm() {
                const btnSubmit = document.getElementById('btnSubmitRescheduleAppointment');
                if (!btnSubmit) return;

                const isChecked = chkConfirmReschedule && chkConfirmReschedule.checked;
                const isKhac = lyDoDoiSelect && lyDoDoiSelect.value === 'Khác';
                const txtNoiDung = document.getElementById('txtNoiDungDoiKhac');
                const hasText = txtNoiDung && txtNoiDung.value.trim().length > 0;

                if (isChecked && (!isKhac || (isKhac && hasText))) {
                    btnSubmit.disabled = false;
                } else {
                    btnSubmit.disabled = true;
                }
            }

            const btnSubmitReschedule = document.getElementById('btnSubmitRescheduleAppointment');
            if (btnSubmitReschedule) {
                btnSubmitReschedule.addEventListener('click', async () => {
                    const form = document.getElementById('rescheduleAppointmentForm');
                    if (!form) return;

                    btnSubmitReschedule.disabled = true;
                    btnSubmitReschedule.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status"></span> Đang xử lý...`;

                    try {
                        const formData = new FormData(form);
                        const response = await fetch('/Ticket/DoiLichHen', {
                            method: 'POST',
                            body: formData
                        });

                        const data = await response.json();

                        if (data.success) {
                            // Hide reschedule modal
                            const modalElem = document.getElementById('rescheduleAppointmentModal');
                            if (modalElem && window.bootstrap) {
                                const modalInstance = bootstrap.Modal.getInstance(modalElem);
                                if (modalInstance) modalInstance.hide();
                            }

                            // Show Success modal
                            const successModalElem = document.getElementById('rescheduleSuccessModal');
                            if (successModalElem && window.bootstrap) {
                                const successModal = new bootstrap.Modal(successModalElem);
                                successModal.show();
                            }

                            // SPA REALTIME UI UPDATE (WITHOUT RELOAD):
                            // 1. Update Old Appointment Item -> Đã hủy (Badge xám/đỏ)
                            const oldBadge = document.getElementById(`lh-badge-${data.oldIdLichHen}`);
                            if (oldBadge) {
                                oldBadge.className = 'lh-badge lh-status-cancelled';
                                oldBadge.innerHTML = `<span class="status-dot"></span> Đã hủy`;
                            }

                            const oldActions = document.getElementById(`lh-actions-${data.oldIdLichHen}`);
                            if (oldActions) {
                                oldActions.innerHTML = `
                                    <span class="badge bg-secondary px-3 py-2 rounded-pill"><i class="bi bi-arrow-repeat me-1"></i> Đã gửi yêu cầu đổi lịch</span>
                                `;
                            }

                            // 2. Add New Appointment Card dynamically to timeline
                            const lhTimeline = document.querySelector('.lh-timeline');
                            if (lhTimeline) {
                                const newItemHtml = `
                                    <div class="lh-item animate-fade-up border border-warning rounded-3 mb-3 p-3 bg-white" id="lh-item-${data.newIdLichHen}">
                                        <div class="lh-header d-flex justify-content-between align-items-center mb-2">
                                            <span class="lh-id fw-bold text-dark">Mã lịch hẹn: LH-${String(data.newIdLichHen).padStart(5, '0')}</span>
                                            <span class="lh-badge lh-status-waiting badge bg-warning text-dark" id="lh-badge-${data.newIdLichHen}">
                                                <span class="status-dot"></span> Chờ xác nhận
                                            </span>
                                        </div>
                                        <div class="lh-body">
                                            <div class="lh-info-row row g-2">
                                                <div class="lh-info-col col-6">
                                                    <div class="lh-info-label text-muted small"><i class="bi bi-calendar-event me-1 text-danger"></i> Ngày hẹn</div>
                                                    <div class="lh-info-value fw-bold text-dark">${data.ngayHenText}</div>
                                                </div>
                                                <div class="lh-info-col col-6">
                                                    <div class="lh-info-label text-muted small"><i class="bi bi-clock me-1 text-danger"></i> Giờ hẹn</div>
                                                    <div class="lh-info-value fw-bold text-dark">${data.gioHenText}</div>
                                                </div>
                                            </div>
                                            <div class="lh-info-field mt-2">
                                                <div class="lh-info-label text-muted small"><i class="bi bi-geo-alt me-1 text-danger"></i> Địa chỉ</div>
                                                <div class="lh-info-value text-dark">${data.diaChi}</div>
                                            </div>
                                            <div class="lh-info-row row g-2 mt-2">
                                                <div class="lh-info-col col-6">
                                                    <div class="lh-info-label text-muted small"><i class="bi bi-person-badge me-1 text-danger"></i> Kỹ thuật viên</div>
                                                    <div class="lh-info-value text-primary font-monospace small">Chưa phân công (Chờ Admin)</div>
                                                </div>
                                            </div>
                                            <div class="lh-actions mt-3 pt-3 border-top d-flex align-items-center justify-content-end gap-2" id="lh-actions-${data.newIdLichHen}">
                                                <button type="button" 
                                                        class="btn btn-primary btn-ripple rounded-pill px-4 btn-open-reschedule-modal" 
                                                        style="font-size: 0.875rem;"
                                                        data-id-lich-hen="${data.newIdLichHen}" 
                                                        data-id-phieu="${data.idPhieu}"
                                                        data-ngay-hen-display="${data.ngayHenText}"
                                                        data-gio-hen="${data.gioHenText}"
                                                        data-dia-chi="${data.diaChi}"
                                                        data-trang-thai="Chờ xác nhận"
                                                        data-ktv="Chưa phân công"
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#rescheduleAppointmentModal">
                                                    <i class="fa-solid fa-calendar-days me-1"></i> Đổi lịch hẹn
                                                </button>
                                                <button type="button" 
                                                        class="btn btn-danger btn-ripple rounded-pill px-4 btn-open-cancel-modal" 
                                                        style="background-color: #EE0033 !important; border-color: #EE0033 !important; font-size: 0.875rem;"
                                                        data-id-lich-hen="${data.newIdLichHen}" 
                                                        data-id-phieu="${data.idPhieu}"
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#cancelAppointmentModal">
                                                    <i class="fa-solid fa-ban me-1"></i> Hủy lịch hẹn
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                `;
                                lhTimeline.insertAdjacentHTML('afterbegin', newItemHtml);
                            }
                        } else {
                            alert(data.message || 'Không thể gửi yêu cầu đổi lịch hẹn.');
                        }
                    } catch (err) {
                        console.error('Lỗi AJAX đổi lịch hẹn:', err);
                        alert('Lỗi kết nối khi gửi yêu cầu đổi lịch hẹn.');
                    } finally {
                        btnSubmitReschedule.disabled = false;
                        btnSubmitReschedule.innerHTML = `<i class="fa-solid fa-calendar-check me-1"></i> Xác nhận đổi lịch`;
                    }
                });
            }
        });
    </script>
</body>

</html>