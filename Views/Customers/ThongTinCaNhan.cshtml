                <div id="modalAlertContainer"></div>

                <form id="editProfileForm"
                      asp-action="CapNhatThongTinCaNhan"
                      asp-controller="Customers"
                      method="post"
                      novalidate>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="IdKhachHang" />

                    <!-- Read-only Info Block (Mã KH, Ngày tạo) -->
                    <div class="form-row-grid">
                        <div class="form-group-item">
                            <label class="custom-form-label">Mã khách hàng</label>
                            <input type="text" class="custom-form-input highlight" value="@Model.MaKh" readonly disabled />
                        </div>
                        <div class="form-group-item">
                            <label class="custom-form-label">Ngày tạo tài khoản</label>
                            <input type="text" class="custom-form-input" value="@(Model.NgayTao?.ToString("dd/MM/yyyy") ?? "--")" readonly disabled />
                        </div>
                    </div>

                    <div class="form-row-grid">
                        <div class="form-group-item">
                            <label for="editFullname" class="custom-form-label">
                                Họ và tên <span class="text-required">*</span>
                            </label>
                            <input asp-for="HoTen"
                                   type="text"
                                   class="custom-form-input"
                                   id="editFullname"
                                   placeholder="Nhập họ và tên..."
                                   required />
                            <span asp-validation-for="HoTen" class="form-validation-error-msg text-danger" id="editFullnameError"></span>
                        </div>
                        <div class="form-group-item">
                            <label for="editPhone" class="custom-form-label">
                                Số điện thoại liên hệ <span class="text-required">*</span>
                            </label>
                            <input asp-for="SoDienThoai"
                                   type="tel"
                                   class="custom-form-input"
                                   id="editPhone"
                                   placeholder="Nhập số điện thoại (10 chữ số)..."
                                   required />
                            <span asp-validation-for="SoDienThoai" class="form-validation-error-msg text-danger" id="editPhoneError"></span>
                        </div>
                    </div>

                    <div class="form-row-grid">
                        <div class="form-group-item">
                            <label for="editEmail" class="custom-form-label">Email tài khoản <span class="text-required">*</span></label>
                            <input asp-for="Email"
                                   type="email"
                                   class="custom-form-input"
                                   id="editEmail"
                                   placeholder="Nhập địa chỉ email..."
                                   required />
                            <span asp-validation-for="Email" class="form-validation-error-msg text-danger" id="editEmailError"></span>
                        </div>
                        <div class="form-group-item">
                            <label for="editNgaySinh" class="custom-form-label">Ngày sinh</label>
                            <input asp-for="NgaySinh"
                                   type="date"
                                   class="custom-form-input"
                                   id="editNgaySinh"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="NgaySinh" class="form-validation-error-msg text-danger" id="editNgaySinhError"></span>
                        </div>
                    </div>

                    <div class="form-group-item">
                        <label for="editAddress" class="custom-form-label">
                            Địa chỉ lắp đặt / Liên hệ
                        </label>
                        <textarea asp-for="DiaChi"
                                  class="custom-form-textarea"
                                  id="editAddress"
                                  rows="3"
                                  placeholder="Nhập địa chỉ đầy đủ (số nhà, tên đường, phường/xã, quận/huyện)..."></textarea>
                        <span asp-validation-for="DiaChi" class="form-validation-error-msg text-danger" id="editAddressError"></span>
                    </div>

                    <div class="modal-footer-actions">
                        <button type="button" class="btn-modal-action btn-cancel" data-close-modal>
                            Hủy bỏ
                        </button>
                        <button type="submit" id="btnSaveProfile" class="btn-modal-action btn-submit btn-viettel-red">
                            <i class="bi bi-save me-1" id="btnSaveProfileIcon"></i>
                            Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Đổi Mật Khẩu -->

    <div class="profile-custom-modal" id="changePasswordModal" role="dialog" aria-modal="true"
         aria-labelledby="changePasswordModalTitle">
        <div class="modal-dialog-card">
            <div class="modal-header">
                <h3 class="modal-title-text" id="changePasswordModalTitle">
                    <i class="fa-solid fa-shield text-danger"></i> Thay Đổi Mật Khẩu
                </h3>
                <button type="button" class="btn-modal-close" aria-label="Close" data-close-modal>
                    <i class="fa-solid fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <form id="changePasswordForm" asp-action="DoiMatKhau" asp-controller="Customers" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <div class="form-group-item">
                        <label for="currentPassword" class="custom-form-label">
                            Mật khẩu hiện tại <span class="text-required">*</span>
                        </label>

                        <div class="password-input-wrapper">
                            <input asp-for="DoiMatKhau.MatKhauHienTai"
                                   type="password"
                                   class="custom-form-input"
                                   id="currentPassword"
                                   required />

                            <button type="button"
                                    class="btn-password-visibility-toggle"
                                    data-toggle-password="currentPassword">
                                <i class="bi bi-eye-slash"></i>
                            </button>
                        </div>

                        <span asp-validation-for="DoiMatKhau.MatKhauHienTai" class="form-validation-error-msg text-danger" id="currentPasswordError"></span>
                    </div>

                    <div class="form-group-item">
                        <label for="newPassword" class="custom-form-label">
                            Mật khẩu mới <span class="text-required">*</span>
                        </label>

                        <div class="password-input-wrapper">
                            <input asp-for="DoiMatKhau.MatKhauMoi"
                                   type="password"
                                   class="custom-form-input"
                                   id="newPassword"
                                   required />

                            <button type="button"
                                    class="btn-password-visibility-toggle"
                                    data-toggle-password="newPassword">
                                <i class="bi bi-eye-slash"></i>
                            </button>
                        </div>

                        <span asp-validation-for="DoiMatKhau.MatKhauMoi" class="form-validation-error-msg text-danger" id="newPasswordError"></span>
                    </div>

                    <div class="form-group-item">
                        <label for="confirmPassword" class="custom-form-label">
                            Xác nhận mật khẩu <span class="text-required">*</span>
                        </label>

                        <div class="password-input-wrapper">
                            <input asp-for="DoiMatKhau.XacNhanMatKhau"
                                   type="password"
                                   class="custom-form-input"
                                   id="confirmPassword"
                                   required />

                            <button type="button"
                                    class="btn-password-visibility-toggle"
                                    data-toggle-password="confirmPassword">
                                <i class="bi bi-eye-slash"></i>
                            </button>
                        </div>

                        <span asp-validation-for="DoiMatKhau.XacNhanMatKhau" class="form-validation-error-msg text-danger" id="confirmPasswordError"></span>
                    </div>

                    <div class="modal-footer-actions">
                        <button type="button"
                                class="btn-modal-action btn-cancel"
                                data-close-modal>
                            Hủy bỏ
                        </button>

                        <button type="submit"
                                class="btn-modal-action btn-submit btn-viettel-red">
                            <i class="bi bi-key"></i>
                            Xác nhận đổi mật khẩu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

   
    <!-- ==================== SCRIPTS ==================== -->
    <!-- Bootstrap 5.3 JS Bundle (includes Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>

    <!-- Component Loader and Actions -->
    <script src="~/assets/js/header.js"></script>
    <script src="~/assets/js/sidebar.js"></script>
    <script src="~/assets/js/footer.js"></script>
    <script src="~/assets/js/chatbox.js"></script>
    <script src="~/assets/js/main.js"></script>

    <!-- Profile Page Frontend Logic -->
    @* Inject Razor flags for JS auto-open modal logic *@
    <script>
        window.__editProfileHasError = @(TempData["EditError"] != null ? "true" : "false");
    </script>
    <script src="~/assets/js/customer-profile.js"></script>

    @if (TempData["Success"] != null || TempData["Error"] != null || !ViewData.ModelState.IsValid)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                setTimeout(function() {
                    const modal = document.getElementById('changePasswordModal');
                    const overlay = document.getElementById('modalBackdropOverlay');
                    if (modal) {
                        modal.style.display = 'block';
                        modal.classList.add('show');
                    }
                    if (overlay) {
                        overlay.style.display = 'block';
                        overlay.classList.add('show');
                    }
                    document.body.style.overflow = 'hidden';
                }, 150);
            });
        </script>
    }
</body>

</html>