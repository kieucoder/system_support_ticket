                    </div>
                </aside>
                <!-- Right Column: Profile Detailed Form -->
                <article class="profile-content-col" id="personalInfoSection"
                         style="scroll-margin-top: 140px;">
                    <div class="profile-details-card">

                        <div class="card-header-with-action">
                            <h3 class="card-section-title">
                                <i class="bi bi-person-vcard text-danger"></i> Thông tin cá nhân
                            </h3>
                            <button type="button" class="btn btn-hero-create btn-sm rounded-pill px-3 shadow-sm" id="btnOpenEditProfileModal">
                                <i class="bi bi-pencil-square me-1"></i> Chỉnh sửa thông tin
                            </button>
                        </div>

                        <form id="inlineProfileForm" class="mt-3" novalidate>
                            <div class="profile-fields-grid">
                                <div class="profile-field-item">
                                    <label for="profileUserCode" class="field-label">Mã khách hàng</label>
                                    <input type="text" class="profile-form-input highlight"
                                           id="profileUserCode" value="@Model.MaKh" readonly>
                                </div>
                                <div class="profile-field-item">
                                    <label for="profileFullname" class="field-label">Họ và tên</label>
                                    <input type="text" class="profile-form-input" id="profileFullname"
                                           value="@Model.HoTen" readonly>
                                </div>
                                <div class="profile-field-item">
                                    <label for="profilePhone" class="field-label">Số điện thoại đăng ký</label>
                                    <input type="tel" class="profile-form-input" id="profilePhone"
                                           value="@Model.SoDienThoai" readonly>
                                </div>
                                <div class="profile-field-item">
                                    <label for="profileEmail" class="field-label">Địa chỉ Email</label>
                                    <input type="email" class="profile-form-input" id="profileEmail"
                                           value="@Model.Email" readonly>
                                </div>
                                
                                <div class="profile-field-item full-width">
                                    <label for="profileAddress" class="field-label">Địa chỉ lắp đặt / Liên hệ</label>
                                    <input type="text" class="profile-form-input" id="profileAddress"
                                           value="@(Model.DiaChi ?? "")" readonly placeholder="Chưa cập nhật">
                                </div>
                                <div class="profile-field-item">
                                    <label for="profileBirthdate" class="field-label">Ngày sinh</label>
                                    <input type="text" class="profile-form-input" id="profileBirthdate"
                                           value="@(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")"
                                           data-display-value="@(Model.NgaySinh?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")" readonly>
                                </div>
                                <div class="profile-field-item">
                                    <label for="profileJoinDate" class="field-label">
                                        Ngày đăng ký thành viên
                                    </label>
                                    <input type="text" class="profile-form-input" id="profileJoinDate"
                                           value="@(Model.NgayTao?.ToString("dd/MM/yyyy") ?? "--")" readonly>
                                </div>

                            </div>
                        </form>
                    </div>
                </article>
            </div>
        </div>
    </main>

    <!-- FOOTER COMPONENT CONTAINER -->
