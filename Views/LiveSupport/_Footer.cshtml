@model SupportTicketSysterm.ViewModels.LiveSupportViewModel

<div class="chat-footer-pane p-3 bg-white border-top position-relative" style="border-bottom-right-radius: 20px; border-bottom-left-radius: 20px;">
    <!-- File Preview Container -->
    <div class="chat-file-preview-bar mb-2" id="filePreviewBar"></div>

    @if (Model.CanChat)
    {
        <!-- Zalo Desktop Style Input Capsule -->
        <div class="chat-input-capsule d-flex align-items-center gap-2.5 bg-light p-2 border rounded-4 shadow-xs" style="border-radius:28px !important; min-height:56px; border-color:#E2E8F0 !important;">
            <!-- Action Toolbar Buttons -->
            <div class="chat-toolbar-group d-flex align-items-center gap-1.5 flex-shrink-0 ps-1">
                <input type="file" id="hiddenFileUpload" style="display:none;" />
                <input type="file" id="hiddenImageUpload" style="display:none;" accept="image/*" />

                <button type="button" class="input-tool-btn rounded-circle" id="fileUploadBtn" title="Gửi tệp đính kèm 📎">
                    <i class="bi bi-paperclip fs-5 text-secondary"></i>
                </button>
                <button type="button" class="input-tool-btn rounded-circle" id="imageUploadBtn" title="Gửi hình ảnh 🖼️">
                    <i class="bi bi-image fs-5 text-secondary"></i>
                </button>
            </div>

            <!-- Auto Expand Textarea -->
            <textarea class="chat-textarea border-0 bg-transparent flex-grow-1 px-2 py-1" id="chatInputField" 
                      placeholder="Nhập câu hỏi hoặc nội dung hỗ trợ... (Enter để gửi)" 
                      rows="1" maxlength="500" style="font-size:0.92rem; outline:none; resize:none; max-height:120px; line-height:1.45;"></textarea>

            <!-- Zalo Red Circular 52px Send Button with Ripple & Hover Scale -->
            <button type="button" class="chat-send-btn rounded-circle text-white border-0 d-grid place-items-center flex-shrink-0 shadow-xs btn-ripple" id="chatSendBtn" aria-label="Gửi"
                    style="width:52px; height:52px; background: linear-gradient(135deg, #D71920 0%, #E53935 100%); font-size:1.15rem; cursor:pointer; transition: all 0.25s cubic-bezier(0.175, 0.885, 0.32, 1.275);">
                <i class="bi bi-send-fill"></i>
            </button>
        </div>
    }
    else
    {
        var isCancelled = Model.Ticket?.TrangThai == "Đã hủy" || Model.Ticket?.TrangThai == "DaHuy";
        
        <div class="chat-closed-card p-4 text-center rounded-4 position-relative overflow-hidden" 
             style="background: @(isCancelled ? "linear-gradient(135deg, #FEF2F2 0%, #FFF5F5 50%, #FEE2E2 100%)" : "linear-gradient(135deg, #ECFDF5 0%, #F0FDF4 50%, #DCFCE7 100%)"); border: 1px solid @(isCancelled ? "#FECACA" : "#A7F3D0"); box-shadow: 0 10px 25px -5px rgba(@(isCancelled ? "239, 68, 68" : "16, 185, 129"), 0.12), 0 8px 10px -6px rgba(@(isCancelled ? "239, 68, 68" : "16, 185, 129"), 0.08);">
            
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3 shadow-sm position-relative" 
                 style="width: 58px; height: 58px; background: @(isCancelled ? "linear-gradient(135deg, #EF4444 0%, #DC2626 100%)" : "linear-gradient(135deg, #10B981 0%, #059669 100%)"); color: #ffffff;">
                <i class="bi @(isCancelled ? "bi-x-circle-fill" : "bi-check-circle-fill") fs-2"></i>
            </div>
            
            <div>
                <span class="badge rounded-pill px-3 py-1.5 fw-bold mb-2 d-inline-flex align-items-center gap-1.5" 
                      style="font-size: 0.75rem; background: @(isCancelled ? "rgba(239, 68, 68, 0.12)" : "rgba(16, 185, 129, 0.12)"); color: @(isCancelled ? "#DC2626" : "#047857"); border: 1px solid @(isCancelled ? "rgba(239, 68, 68, 0.25)" : "rgba(16, 185, 129, 0.25)");">
                    <i class="bi @(isCancelled ? "bi-x-circle-fill" : "bi-shield-check")"></i>
                    <span>@(isCancelled ? "ĐÃ HỦY PHIẾU" : "ĐÃ HOÀN THÀNH PHIẾU")</span>
                </span>
            </div>

            <h5 class="fw-bold text-dark mb-1.5" style="letter-spacing: -0.2px;">
                @(isCancelled ? "Phiếu hỗ trợ đã bị hủy" : "Phiếu hỗ trợ đã xử lý thành công")
            </h5>
            
            <p class="text-muted small mb-3.5 mx-auto" style="font-size: 0.85rem; max-width: 460px; line-height: 1.55;">
                @(isCancelled 
                    ? "Phiếu hỗ trợ này đã dừng xử lý. Cuộc trò chuyện đã khép lại và không thể gửi thêm tin nhắn." 
                    : "Cuộc trao đổi này đã khép lại an toàn. Cảm ơn bạn đã lựa chọn và đồng hành cùng dịch vụ kỹ thuật Viettel Telecom!")
            </p>

            @if (Model.CurrentUserRole == "Customer")
            {
                <a asp-controller="Ticket" asp-action="TaoPhieu" 
                   class="btn btn-danger rounded-pill fw-bold px-4 py-2.5 shadow-sm text-white d-inline-flex align-items-center gap-2 hover-scale" 
                   style="background: linear-gradient(135deg, #D71920 0%, #E53935 100%); font-size: 0.88rem; border: none; transition: all 0.25s ease;">
                    <i class="bi bi-plus-circle-fill fs-6"></i>
                    <span>Tạo phiếu hỗ trợ mới</span>
                </a>
            }
        </div>
    }
</div>
