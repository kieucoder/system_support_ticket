@{
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
    ViewData["Title"] = "Dịch Vụ Hỗ Trợ Trực Tuyến 24/7 - Viettel Cần Thơ";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/news-detail.css" asp-append-version="true" />
}

<div class="reading-progress-bar"></div>

<div class="news-detail-wrapper">

    <section class="detail-header-section">
        <div class="container">
            <div class="detail-breadcrumb">
                <a asp-controller="Customers" asp-action="TrangChu"><i class="bi bi-house-door-fill me-1"></i> Trang chủ</a>
                <span>></span>
                <a asp-controller="Home" asp-action="TinTuc">Tin tức</a>
                <span>></span>
                <span class="text-dark">Hoạt động CSKH</span>
            </div>

            <h1 class="detail-article-title">
                Viettel Cần Thơ Ra Mắt Đội Kỹ Thuật Lưu Động Phản Ứng Nhanh & Tổng Đài Hỗ Trợ Trực Tuyến 24/7
            </h1>

            <div class="detail-meta-bar">
                <span class="detail-author-badge">
                    <i class="bi bi-headset"></i> Trung Tâm CSKH Viettel
                </span>
                <span class="detail-meta-item"><i class="bi bi-calendar3 text-danger"></i> 12/07/2026</span>
                <span class="detail-meta-item"><i class="bi bi-clock text-danger"></i> 4 phút đọc</span>
                <span class="detail-meta-item"><i class="bi bi-eye text-danger"></i> 1,820 lượt xem</span>
                <span class="badge bg-danger">Thông Báo</span>
            </div>
        </div>
    </section>

    <div class="container py-5">
        <div class="row g-4">

            <div class="col-lg-8 col-12">
                <article class="article-content">

                    <div class="detail-cover-container">
                        <img src="https://images.unsplash.com/photo-1521791136064-7986c2920216?auto=format&fit=crop&q=80&w=1200" alt="Đội hỗ trợ kỹ thuật trực tuyến 24/7" />
                    </div>
                    <p class="detail-cover-caption">Tổng đài viên và kỹ thuật viên lưu động thường trực phục vụ 24/7 kể cả ngày Lễ Tết</p>

                    <p class="lead fw-bold text-dark mb-4">
                        Nhằm đáp ứng nhu cầu kết nối thông suốt của hơn 10.000 khách hàng tại Cần Thơ, Viettel Telecom chính thức đưa vào vận hành <span class="text-highlight">Trung Tâm Hỗ Trợ Kỹ Thuật Trực Tuyến 24/7</span> kết hợp Đội Kỹ Thuật Lưu Động Phản Ứng Nhanh trên toàn bộ 9 quận/huyện.
                    </p>

                    <h2>1. Cam Kết Phục Vụ 24/7 Kể Cả Ngày Lễ Tết</h2>
                    <p>
                        Sự cố mạng viễn thông có thể phát sinh bất kỳ lúc nào. Đội ngũ kỹ thuật viên Viettel luôn duy trì ca trực xoay vòng đêm ngày, cam kết có mặt tại hiện trường xử lý báo hỏng khẩn cấp cho khách hàng cá nhân và doanh nghiệp trong vòng 30 - 60 phút.
                    </p>

                    <h2>2. Các Kênh Tiếp Nhận Hỗ Trợ Kỹ Thuật Chính Thức</h2>
                    <ul>
                        <li><strong>Cổng Web TechSupport:</strong> Tạo phiếu hỗ trợ trực tuyến và tra cứu tiến độ ticket tự động.</li>
                        <li><strong>Trợ Lý AI Gemini ChatBox:</strong> Giải đáp thắc mắc và tự động hướng dẫn khắc phục sự cố tức thì.</li>
                        <li><strong>Tổng Đài 1800 8198:</strong> Tiếp nhận cuộc gọi miễn phí cước 24/7.</li>
                    </ul>

                    <!-- Share Section -->
                    <div class="article-share-section">
                        <span class="share-title"><i class="bi bi-share-fill me-2 text-danger"></i> Chia sẻ thông báo:</span>
                        <div class="share-buttons-list">
                            <a href="#" class="btn-share btn-share-facebook"><i class="bi bi-facebook"></i></a>
                            <a href="#" class="btn-share btn-share-zalo"><i class="bi bi-chat-quote-fill"></i></a>
                            <a href="#" class="btn-share btn-share-email"><i class="bi bi-envelope-fill"></i></a>
                        </div>
                    </div>

                </article>
            </div>

            <!-- SIDEBAR -->
            <div class="col-lg-4 col-12">
                <aside class="news-sidebar">
                    <div class="sidebar-widget">
                        <h4 class="widget-title"><i class="bi bi-fire text-danger me-2"></i> Bài Viết Nổi Bật</h4>
                        <a asp-controller="Home" asp-action="ChiTietTin1" class="text-decoration-none text-dark d-block">
                            <div class="mini-post-item">
                                <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&q=80&w=200" class="mini-post-img" alt="Tạo phiếu" />
                                <div>
                                    <h5 class="mini-post-title">Hướng Dẫn Tạo Phiếu Báo Sự Cố Nhanh</h5>
                                    <span class="mini-post-date"><i class="bi bi-calendar3"></i> 20/07/2026</span>
                                </div>
                            </div>
                        </a>
                    </div>
                </aside>
            </div>

        </div>
    </div>

    <!-- CTA SECTION -->
 

</div>

<partial name="~/Views/Shared/_Footer.cshtml" />

@section Scripts {
    <script src="~/assets/js/news-detail.js" asp-append-version="true"></script>
}
