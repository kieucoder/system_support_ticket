@{
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
    ViewData["Title"] = "Hướng Dẫn Tạo Phiếu Báo Sự Cố Nhanh - TechSupport Viettel Cần Thơ";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/news-detail.css" asp-append-version="true" />
}

<div class="reading-progress-bar"></div>

<div class="news-detail-wrapper">

    <!-- ==========================================
       HEADER & BREADCRUMB
       ========================================== -->
    <section class="detail-header-section">
        <div class="container">
            <div class="detail-breadcrumb">
                <a asp-controller="Customers" asp-action="TrangChu"><i class="bi bi-house-door-fill me-1"></i> Trang chủ</a>
                <span>></span>
                <a asp-controller="Home" asp-action="TinTuc">Tin tức</a>
                <span>></span>
                <span class="text-dark">Hướng dẫn tạo phiếu hỗ trợ</span>
            </div>

            <h1 class="detail-article-title">
                Hướng Dẫn Chi Tiết Tạo Phiếu Báo Sự Cố Kỹ Thuật Nhanh Trực Tuyến Trên Website TechSupport
            </h1>

            <div class="detail-meta-bar">
                <span class="detail-author-badge">
                    <i class="bi bi-person-badge-fill"></i> Ban Kỹ Thuật Viettel
                </span>
                <span class="detail-meta-item"><i class="bi bi-calendar3 text-danger"></i> 20/07/2026</span>
                <span class="detail-meta-item"><i class="bi bi-clock text-danger"></i> 5 phút đọc</span>
                <span class="detail-meta-item"><i class="bi bi-eye text-danger"></i> 2,840 lượt xem</span>
                <span class="badge bg-danger">Hướng Dẫn</span>
            </div>
        </div>
    </section>

    <!-- ==========================================
       ARTICLE CONTENT & SIDEBAR
       ========================================== -->
    <div class="container py-5">
        <div class="row g-4">

            <!-- LEFT COLUMN: ARTICLE CONTENT (Col 8) -->
            <div class="col-lg-8 col-12">
                <article class="article-content">

                    <!-- Cover Image -->
                    <div class="detail-cover-container">
                        <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&q=80&w=1200" alt="Hướng dẫn tạo phiếu hỗ trợ" />
                    </div>
                    <p class="detail-cover-caption">Giao diện tạo phiếu hỗ trợ trực tuyến đơn giản, tự động hóa 100% của Viettel Telecom Cần Thơ</p>

                    <p class="lead fw-bold text-dark mb-4">
                        Trong thời đại chuyển đổi số viễn thông, việc báo hỏng dịch vụ internet cáp quang, truyền hình số hay camera giám sát không còn phụ thuộc vào tổng đài cuộc gọi truyền thống. Hệ thống <span class="text-highlight">TechSupport Viettel</span> mang đến trải nghiệm tiếp nhận sự cố kỹ thuật tự động 24/7, giúp khách hàng khởi tạo ticket chỉ trong 60 giây.
                    </p>

                    <h2>1. Vì Sao Nên Sử Dụng Hệ Thống Tạo Phiếu Trực Tuyến?</h2>
                    <p>
                        Thay vì mất thời gian chờ đợi nhân viên tổng đài nối máy trong giờ cao điểm, cổng tiếp nhận phiếu hỗ trợ kỹ thuật trực tuyến của Viettel Cần Thơ giúp ghi nhận chính xác mã hợp đồng, định vị địa chỉ lắp đặt và phân loại tự động mức độ ưu tiên sự cố.
                    </p>

                    <div class="callout-box">
                        <h5><i class="bi bi-lightning-charge-fill me-2"></i> Lợi Ích Vượt Trội Khi Tạo Ticket Online</h5>
                        <p>
                            • Tiết kiệm 100% cước phí cuộc gọi và thời gian chờ máy.<br />
                            • Tự động kết nối với kỹ thuật viên phụ trách đúng địa bàn phường/xã.<br />
                            • Đính kèm ảnh chụp sự cố thực tế để kỹ thuật chuẩn bị trước vật tư thay thế.<br />
                            • Nhận thông báo xác nhận và mã tra cứu qua tin nhắn Zalo/SMS lập tức.
                        </p>
                    </div>

                    <h2>2. Quy Trình 04 Bước Tạo Phiếu Báo Sự Cố</h2>

                    <h3>Bước 1: Truy cập Cổng Tạo Phiếu Dịch Vụ</h3>
                    <p>
                        Từ trang chủ website TechSupport Viettel, quý khách nhấn chọn nút <strong>"Tạo Phiếu Hỗ Trợ"</strong> hoặc truy cập đường dẫn danh mục dịch vụ. Hệ thống sẽ hiển thị các nhóm dịch vụ chính như Internet Cáp Quang, Truyền Hình Viettel, Camera AI và Dịch vụ Doanh nghiệp.
                    </p>

                    <div class="article-inline-image">
                        <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?auto=format&fit=crop&q=80&w=1000" alt="Chọn danh mục dịch vụ" />
                        <div class="article-inline-caption">Hình 1: Chọn đúng danh mục dịch vụ viễn thông cần gửi yêu cầu xử lý sự cố</div>
                    </div>

                    <h3>Bước 2: Điền Thông Tin Khách Hàng & Địa Chỉ Lắp Đặt</h3>
                    <p>
                        Vui lòng cung cấp chính xác thông tin liên hệ để kỹ thuật viên chủ động gọi điện xác nhận trước khi đến nhà:
                    </p>
                    <ul>
                        <li><strong>Họ và tên người yêu cầu:</strong> Tên chủ hợp đồng hoặc người trực tiếp quản lý thiết bị.</li>
                        <li><strong>Số điện thoại liên hệ:</strong> Số điện thoại nhận tin nhắn SMS/Zalo cập nhật trạng thái phiếu.</li>
                        <li><strong>Mã hợp đồng / Mã đường truyền:</strong> (Nếu có) Ví dụ: <em>CTO_FTTH_123456</em> giúp tra cứu hạ tầng tức thì.</li>
                        <li><strong>Địa chỉ sự cố:</strong> Số nhà, tên đường, phường/xã chính xác tại Cần Thơ.</li>
                    </ul>

                    <h3>Bước 3: Mô Tả Chi Tiết Hiện Trạng Lỗi & Đính Kèm Hình Ảnh</h3>
                    <p>
                        Hãy mô tả ngắn gọn hiện trạng sự cố bạn đang gặp phải. Quý khách có thể chọn nhanh các mẫu lỗi thường gặp như: <em>Modem báo đèn đỏ LOS, Mạng chập chờn giờ cao điểm, Mất tín hiệu truyền hình, Không đăng nhập được ứng dụng...</em>
                    </p>

                    <blockquote class="article-blockquote">
                        <i class="bi bi-quote quote-icon"></i>
                        "Mẹo kỹ thuật: Đính kèm 1 ảnh chụp rõ đèn báo trên thiết bị Modem ONT hoặc màn hình báo lỗi giúp đội ngũ chuyên gia chẩn đoán chính xác 90% nguyên nhân trước khi lên đường."
                    </blockquote>

                    <h3>Bước 4: Xác Nhận & Nhận Mã Ticket Tra Cứu</h3>
                    <p>
                        Nhấn nút <strong>"Gửi Yêu Cầu Hỗ Trợ"</strong>. Hệ thống sẽ tự động cấp một mã ticket có định dạng <span class="text-highlight">HT2026xxxx</span>. Bạn có thể sử dụng mã này hoặc số điện thoại để tra cứu tiến độ xử lý bất cứ lúc nào.
                    </p>

                    <h2>3. Cam Kết Thời Gian Phản Hồi SLA</h2>
                    <p>
                        Viettel Telecom Cần Thơ cam kết duy trì chỉ số SLA nghiêm ngặt cho toàn bộ ticket kỹ thuật tiếp nhận trên hệ thống:
                    </p>
                    <ol>
                        <li><strong>Dưới 15 phút:</strong> Phân công kỹ thuật viên phụ trách địa bàn và gửi SMS xác nhận cho khách hàng.</li>
                        <li><strong>Dưới 2 giờ:</strong> Kỹ thuật viên liên hệ trực tiếp kiểm tra từ xa hoặc hẹn giờ đến tận nơi.</li>
                        <li><strong>Dưới 4 giờ:</strong> Khắc phục triệt để các sự cố cáp quang đứt đứt, suy hao quang hoặc lỗi thiết bị nhà mạng.</li>
                    </ol>

                    <!-- Share Section -->
                    <div class="article-share-section">
