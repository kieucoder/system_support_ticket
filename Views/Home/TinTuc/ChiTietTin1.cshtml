                        </a>
                    </div>

                    <!-- Widget 2: Danh Mục -->
                    <div class="sidebar-widget">
                        <h4 class="widget-title"><i class="bi bi-folder2-open text-danger me-2"></i> Danh Mục</h4>
                        <ul class="sidebar-cat-list">
                            <li class="sidebar-cat-item">
                                <a asp-controller="Home" asp-action="TinTuc" class="text-decoration-none text-dark">Hướng dẫn sử dụng</a>
