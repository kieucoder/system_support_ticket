                                        <span class="related-date"><i class="bi bi-calendar3"></i> 16/07/2026</span>
                                        <h4 class="related-card-title">
                                            <a asp-controller="Home" asp-action="ChiTietTin5" class="text-decoration-none text-dark">
                                                Top 5 Sự Cố Mạng Internet Cáp Quang Thường Gặp Vài Cách Tự Khắc Phục
                                            </a>
                                        </h4>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </article>
            </div>

            <!-- RIGHT COLUMN: SIDEBAR (Col 4) -->
            <div class="col-lg-4 col-12">
                <aside class="news-sidebar">

                    <!-- Widget 1: Bài viết nổi bật -->
                    <div class="sidebar-widget">
                        <h4 class="widget-title"><i class="bi bi-fire text-danger me-2"></i> Bài Viết Nổi Bật</h4>
                        
