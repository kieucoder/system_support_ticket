@{
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
    ViewData["Title"] = "Thông Báo Lịch Nâng Cấp Hạ Tầng GPON - Viettel Cần Thơ";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/news-detail.css" asp-append-version="true" />
}

<div class="reading-progress-bar"></div>

<div class="news-detail-wrapper">

    <section class="detail-header-section">
        <div class="container">
            <div class="detail-breadcrumb">
                <a asp-controller="Customers" asp-action="TrangChu"><i class="bi bi-house-door-fill me-1"></i> Trang chủ</a>
                <span>></span>
                <a asp-controller="Home" asp-action="TinTuc">Tin tức</a>
                <span>></span>
                <span class="text-dark">Thông báo nâng cấp hệ thống</span>
            </div>

            <h1 class="detail-article-title">
                Thông Báo Lịch Nâng Cấp Kỹ Thuật Hạ Tầng Cáp Quang GPON Khu Vực Ninh Kiều & Bình Thủy
            </h1>

            <div class="detail-meta-bar">
                <span class="detail-author-badge">
                    <i class="bi bi-gear-wide-connected"></i> Trung Tâm Mạng Viễn Thông
                </span>
                <span class="detail-meta-item"><i class="bi bi-calendar3 text-danger"></i> 18/07/2026</span>
                <span class="detail-meta-item"><i class="bi bi-clock text-danger"></i> 3 phút đọc</span>
                <span class="detail-meta-item"><i class="bi bi-eye text-danger"></i> 1,980 lượt xem</span>
                <span class="badge bg-warning text-dark">Bảo Trì</span>
            </div>
        </div>
    </section>

    <div class="container py-5">
        <div class="row g-4">

            <div class="col-lg-8 col-12">
                <article class="article-content">

                    <div class="detail-cover-container">
                        <img src="https://images.unsplash.com/photo-1544197150-b99a580bb7a8?auto=format&fit=crop&q=80&w=1200" alt="Nâng cấp hạ tầng viễn thông" />
                    </div>
                    <p class="detail-cover-caption">Đội ngũ kỹ thuật viên Viettel triển khai chuyển đổi tủ cáp quang thế hệ mới đêm 23/07/2026</p>

                    <p class="lead fw-bold text-dark mb-4">
                        Nhằm nâng cao dung lượng đường truyền băng thông rộng và sẵn sàng cho hệ sinh thái Wi-Fi 6 siêu tốc, Viettel Telecom Cần Thơ xin trân trọng thông báo lịch chuyển đổi và nâng cấp thiết bị quang định kỳ khu vực <span class="text-highlight">Quận Ninh Kiều & Quận Bình Thủy</span>.
                    </p>

                    <h2>1. Kế Hoạch & Thời Gian Thi Công Chi Tiết</h2>
                    <p>
                        Công tác nâng cấp được thực hiện vào khung giờ đêm thấp điểm để hạn chế tối đa ảnh hưởng đến sinh hoạt và hoạt động kinh doanh của quý khách:
                    </p>

                    <div class="callout-box">
                        <h5><i class="bi bi-clock-history me-2"></i> Khung Giờ Thực Hiện Nâng Cấp</h5>
                        <p>
                            • <strong>Thời gian bắt đầu:</strong> 00:30 ngày 23/07/2026 (Đêm thứ Ba).<br />
                            • <strong>Thời gian hoàn tất dự kiến:</strong> 04:30 ngày 23/07/2026 (Sáng thứ Tư).<br />
                            • <strong>Khu vực ảnh hưởng:</strong> Các phường An Khánh, Xuân Khánh, Tân An (Ninh Kiều) và Trà Nóc (Bình Thủy).
                        </p>
                    </div>

                    <h2>2. Các Dịch Vụ Tạm Thời Gián Đoạn Đơn Lẻ</h2>
                    <p>
                        Trong quá trình kỹ thuật viên tiến hành chuyển cáp sang tủ ODF thế hệ mới, các dịch vụ sau đây sẽ xuất hiện tình trạng gián đoạn tín hiệu chập chờn khoảng 15 - 30 phút:
                    </p>
                    <ul>
                        <li>Dịch vụ Internet Cáp Quang FTTH cá nhân và doanh nghiệp.</li>
                        <li>Dịch vụ Truyền hình số TV360 Viettel.</li>
                        <li>Hệ thống Camera Cloud Viettel và dịch vụ IP Static.</li>
                    </ul>

                    <h2>3. Hướng Dẫn Sau Khi Nâng Cấp Hoàn Tất</h2>
                    <p>
                        Sau 04:30 sáng ngày 23/07/2026, tín hiệu đường truyền sẽ tự động khôi phục. Trong trường hợp Modem nhà bạn vẫn báo đèn đỏ hoặc không truy cập được mạng:
                    </p>
                    <ol>
                        <li>Hãy rút phích cắm nguồn điện Modem ONT, chờ 60 giây và cắm điện trở lại.</li>
                        <li>Nếu vẫn chưa có tín hiệu, hãy truy cập ứng dụng hoặc tạo phiếu hỗ trợ trên website TechSupport để kỹ thuật viên đến hỗ trợ xử lý tức thì.</li>
                    </ol>

                    <blockquote class="article-blockquote">
                        <i class="bi bi-quote quote-icon"></i>
                        "Viettel Telecom chân thành xin lỗi vì sự gián đoạn tạm thời này và trân trọng cảm ơn sự cảm thông của Quý khách hàng."
                    </blockquote>

                    <!-- Share Section -->
                    <div class="article-share-section">
                        <span class="share-title"><i class="bi bi-share-fill me-2 text-danger"></i> Chia sẻ thông báo này:</span>
                        <div class="share-buttons-list">
                            <a href="#" class="btn-share btn-share-facebook"><i class="bi bi-facebook"></i></a>
                            <a href="#" class="btn-share btn-share-zalo"><i class="bi bi-chat-quote-fill"></i></a>
                            <a href="#" class="btn-share btn-share-email"><i class="bi bi-envelope-fill"></i></a>
                        </div>
                    </div>

                </article>
            </div>

            <!-- SIDEBAR -->
            <div class="col-lg-4 col-12">
                <aside class="news-sidebar">
                    <div class="sidebar-widget">
                        <h4 class="widget-title"><i class="bi bi-fire text-danger me-2"></i> Bài Viết Nổi Bật</h4>
                        <a asp-controller="Home" asp-action="ChiTietTin1" class="text-decoration-none text-dark d-block">
                            <div class="mini-post-item">
                                <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&q=80&w=200" class="mini-post-img" alt="Tạo phiếu" />
                                <div>
                                    <h5 class="mini-post-title">Hướng Dẫn Tạo Phiếu Báo Sự Cố Nhanh</h5>
                                    <span class="mini-post-date"><i class="bi bi-calendar3"></i> 20/07/2026</span>
                                </div>
                            </div>
                        </a>
                    </div>
                </aside>
            </div>

        </div>
    </div>


</div>

<partial name="~/Views/Shared/_Footer.cshtml" />

@section Scripts {
    <script src="~/assets/js/news-detail.js" asp-append-version="true"></script>
}
