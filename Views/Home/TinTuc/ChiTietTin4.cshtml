@{
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
    ViewData["Title"] = "Ứng Dụng Gemini AI Trong Phân Loại Ticket 24/7 - Viettel Cần Thơ";
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/news-detail.css" asp-append-version="true" />
}

<div class="reading-progress-bar"></div>

<div class="news-detail-wrapper">

    <section class="detail-header-section">
        <div class="container">
            <div class="detail-breadcrumb">
                <a asp-controller="Customers" asp-action="TrangChu"><i class="bi bi-house-door-fill me-1"></i> Trang chủ</a>
                <span>></span>
                <a asp-controller="Home" asp-action="TinTuc">Tin tức</a>
                <span>></span>
                <span class="text-dark">Ứng dụng trí tuệ nhân tạo AI</span>
            </div>

            <h1 class="detail-article-title">
                Viettel Cần Thơ Tích Hợp Trợ Lý Ảo Gemini AI Về Quản Lý & Chẩn Đoán Phiếu Hỗ Trợ Kỹ Thuật 24/7
            </h1>

            <div class="detail-meta-bar">
                <span class="detail-author-badge">
                    <i class="bi bi-cpu-fill"></i> Viettel AI Lab & Ban Kỹ Thuật
                </span>
                <span class="detail-meta-item"><i class="bi bi-calendar3 text-danger"></i> 21/07/2026</span>
                <span class="detail-meta-item"><i class="bi bi-clock text-danger"></i> 7 phút đọc</span>
                <span class="detail-meta-item"><i class="bi bi-eye text-danger"></i> 3,420 lượt xem</span>
                <span class="badge bg-danger">Công Nghệ</span>
            </div>
        </div>
    </section>

    <div class="container py-5">
        <div class="row g-4">

            <div class="col-lg-8 col-12">
                <article class="article-content">

                    <div class="detail-cover-container">
                        <img src="https://images.unsplash.com/photo-1519389950473-47ba0277781c?auto=format&fit=crop&q=80&w=1200" alt="Ứng dụng Gemini AI trong kỹ thuật" />
                    </div>
                    <p class="detail-cover-caption">Mô hình AI Gemini hỗ trợ phân tích ngôn ngữ tự nhiên và tự động gợi ý giải pháp xử lý sự cố</p>

                    <p class="lead fw-bold text-dark mb-4">
                        Đánh dấu mốc quan trọng trong chiến lược chuyển đổi số dịch vụ CSKH viễn thông: Hệ thống <span class="text-highlight">TechSupport Viettel Cần Thơ</span> chính thức tích hợp thành công mô hình ngôn ngữ lớn Google Gemini AI, mang đến khả năng phản hồi thông minh, chẩn đoán lỗi tự động và phân loại ticket siêu tốc 24/7.
                    </p>

                    <h2>1. Trợ Lý AI Gemini Giải Quyết Bài Toán Đa Kênh Ra Sao?</h2>
                    <p>
                        Trước đây, quá trình tiếp nhận báo hỏng qua tổng đài yêu cầu nhân viên nhập thủ công nội dung lỗi, xác định phân phân vùng địa lý và điều phối kỹ thuật viên. Quá trình này tiêu tốn trung bình từ 10 - 15 phút.
                    </p>
                    <p>
                        Với sự xuất hiện của trợ lý ảo Gemini AI tích hợp trực tiếp trên ChatBox website, toàn bộ quy trình đã được tự động hóa hoàn toàn nhờ các tính năng ưu việt:
                    </p>
                    <ul>
                        <li><strong>Hiểu ngôn ngữ tự nhiên tiếng Việt:</strong> Nhận diện chính xác các cách diễn đạt sự cố khác nhau của người dân miền Tây như <em>"mạng rùa", "rớt mạng", "đèn modem chớp đỏ", "tivi mất hình"...</em></li>
                        <li><strong>Chẩn đoán lỗi kỹ thuật tự động:</strong> Phân tích hình ảnh đèn ONT cáp quang do khách gửi để phát hiện lỗi đứt sợi quang (LOS) hay lỗi mất IP (PON).</li>
                        <li><strong>Gợi ý khắc phục tại chỗ:</strong> Hướng dẫn khách hàng thực hiện các thao tác xử lý sơ bộ trong khi chờ kỹ thuật viên di chuyển.</li>
                    </ul>

                    <div class="callout-box">
                        <h5><i class="bi bi-graph-up-arrow me-2"></i> Kết Quả Thực Tế Đạt Được</h5>
                        <p>
                            • Rút ngắn 60% thời gian xử lý ban đầu từ 15 phút xuống chỉ còn dưới 2 phút.<br />
                            • Phân loại chính xác 98% mức độ ưu tiên của ticket sự cố.<br />
                            • Giảm 40% số lượng ticket lặp nhờ khả năng tự hướng dẫn khách khắc phục lỗi đơn giản.
                        </p>
                    </div>

                    <h2>2. Quy Trình Tương Tác Của Trợ Lý Ảo Trên Giao Diện ChatBox</h2>
                    <p>
                        Ngay khi khách hàng nhấp vào biểu tượng ChatBox tích hợp Gemini AI ở góc màn hình, trợ lý sẽ chào mừng và sẵn sàng hỗ trợ giải đáp:
                    </p>

                    <div class="article-inline-image">
                        <img src="https://images.unsplash.com/photo-1677442136019-21780efad99a?auto=format&fit=crop&q=80&w=1000" alt="Giao diện Chatbox AI" />
                        <div class="article-inline-caption">Hình 1: Chatbox tích hợp Gemini AI sẵn sàng chẩn đoán lỗi và tạo phiếu tự động</div>
                    </div>

                    <blockquote class="article-blockquote">
                        <i class="bi bi-quote quote-icon"></i>
                        "Chúng tôi không hướng tới thay thế con người, mà dùng AI làm đòn bẩy đắc lực giúp kỹ thuật viên có đầy đủ thông tin chuẩn xác nhất trước khi tiếp cận hiện trường." - Đại diện Viettel AI Lab chia sẻ.
                    </blockquote>

                    <h2>3. Định Hướng Nâng Cấp Công Nghệ AI Trong Tương Lai</h2>
                    <p>
                        Trong phiên bản tiếp theo, Viettel Cần Thơ dự kiến tích hợp mô hình dự báo sự cố hạ tầng chủ động (Predictive Maintenance). Hệ thống AI sẽ tự động phân tích dữ liệu chỉ số suy hao quang đường truyền để cảnh báo nguy cơ đứt cáp trước khi khách hàng nhận thấy sự cố.
                    </p>

                    <!-- Share Section -->
                    <div class="article-share-section">
                        <span class="share-title"><i class="bi bi-share-fill me-2 text-danger"></i> Chia sẻ bài viết này:</span>
                        <div class="share-buttons-list">
                            <a href="#" class="btn-share btn-share-facebook"><i class="bi bi-facebook"></i></a>
                            <a href="#" class="btn-share btn-share-zalo"><i class="bi bi-chat-quote-fill"></i></a>
                            <a href="#" class="btn-share btn-share-linkedin"><i class="bi bi-linkedin"></i></a>
                            <a href="#" class="btn-share btn-share-email"><i class="bi bi-envelope-fill"></i></a>
                        </div>
                    </div>

                </article>
            </div>

            <!-- SIDEBAR -->
            <div class="col-lg-4 col-12">
                <aside class="news-sidebar">
                    <div class="sidebar-widget">
                        <h4 class="widget-title"><i class="bi bi-fire text-danger me-2"></i> Bài Viết Nổi Bật</h4>
                        <a asp-controller="Home" asp-action="ChiTietTin1" class="text-decoration-none text-dark d-block">
                            <div class="mini-post-item">
                                <img src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&q=80&w=200" class="mini-post-img" alt="Tạo phiếu" />
                                <div>
                                    <h5 class="mini-post-title">Hướng Dẫn Tạo Phiếu Báo Sự Cố Nhanh</h5>
                                    <span class="mini-post-date"><i class="bi bi-calendar3"></i> 20/07/2026</span>
                                </div>
                            </div>
                        </a>
                    </div>
                </aside>
            </div>

        </div>
    </div>

    

</div>

<partial name="~/Views/Shared/_Footer.cshtml" />

@section Scripts {
    <script src="~/assets/js/news-detail.js" asp-append-version="true"></script>
}
