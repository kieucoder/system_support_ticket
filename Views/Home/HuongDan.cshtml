@{
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
    ViewData["Title"] = "Trung tâm Hướng dẫn khách hàng - TechSupport Viettel";
}

@section Styles {
    <!-- AOS Animation CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css">
    <!-- Page Specific CSS -->
    <link rel="stylesheet" href="~/assets/css/huong-dan.css" asp-append-version="true">
}

<div class="lookup-page-main" style="background-color: var(--viettel-gray-light, #f8f9fa);">
    <!-- ========== 1. BREADCRUMB HERO (Synchronized with LienHe & PhieuCuaToi) ========== -->
    <section class="hero-section" aria-label="Trung tâm hướng dẫn khách hàng">
        <div class="container hero-content">
            <div class="row align-items-center g-5">
                <!-- Left Column: Text, Badge, CTA & Quick Stats -->
                <div class="col-lg-7 col-12 text-start hero-text-col animate-fade-up">
                    
                    <!-- Breadcrumbs -->
                    <nav aria-label="breadcrumb" class="hero-breadcrumb">
                        <ol class="breadcrumb m-0" itemscope itemtype="https://schema.org/BreadcrumbList">
                            <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
                                <a asp-controller="Customers" asp-action="TrangChu" itemprop="item" class="text-decoration-none d-inline-flex align-items-center">
                                    <i class="fa-solid fa-house-door-fill me-1"></i>
                                    <span itemprop="name">Trang chủ</span>
                                </a>
                                <meta itemprop="position" content="1" />
                            </li>
                            <li class="breadcrumb-item active" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem" aria-current="page">
                                <span itemprop="name">Hướng dẫn sử dụng</span>
                                <meta itemprop="position" content="2" />
                            </li>
                        </ol>
                    </nav>

                    <!-- Badge -->
                    <span class="hero-badge">
                        <i class="bi bi-question-circle me-1"></i> Trung tâm hướng dẫn khách hàng
                    </span>

                    <!-- Title -->
                    <h1 class="hero-title text-uppercase">Trung Tâm <span class="text-primary">Hướng Dẫn</span></h1>

                    <!-- Description -->
                    <p class="hero-desc">
                        Tìm hiểu cách sử dụng hệ thống hỗ trợ kỹ thuật TechSupport, tạo phiếu hỗ trợ, theo dõi tiến độ xử lý và trao đổi với nhân viên hỗ trợ một cách nhanh chóng.
                    </p>

                    <!-- CTA Buttons -->
                    <div class="hero-cta-buttons d-flex flex-wrap gap-3 mt-4">
                        <a asp-controller="Ticket" asp-action="ChonDMDichVu" class="btn btn-hero-create px-4 py-2">
                            <i class="bi bi-plus-circle me-1"></i> Tạo Phiếu Mới
                        </a>
                        <a asp-controller="Ticket" asp-action="TraCuuPhieu" class="btn btn-hero-contact px-4 py-2">
                            <i class="bi bi-search me-1"></i> Tra Cứu Phiếu
                        </a>
                    </div>

                    <!-- Quick Stats -->
                    <div class="lk-hero-stats d-flex flex-wrap gap-3 mt-4">
                        <div class="lk-hero-stat-item">
                            <span class="lk-hero-stat-num" style="color:#D71920">6+</span>
                            <span class="lk-hero-stat-label">Chủ đề hướng dẫn</span>
                        </div>
                        <div class="lk-hero-stat-sep"></div>
                        <div class="lk-hero-stat-item">
                            <span class="lk-hero-stat-num" style="color:#3B82F6">24/7</span>
                            <span class="lk-hero-stat-label">Hỗ trợ trực tuyến</span>
                        </div>
                        <div class="lk-hero-stat-sep"></div>
                        <div class="lk-hero-stat-item">
                            <span class="lk-hero-stat-num" style="color:#10B981">100%</span>
                            <span class="lk-hero-stat-label">Miễn phí tư vấn</span>
                        </div>
                    </div>
                </div>

                <!-- Right Column: SVG Illustration -->
                <div class="col-lg-5 col-12 hero-banner-wrapper animate-fade-up delay-1 text-center text-lg-end">
                    <svg class="hero-banner-svg float-svg" viewBox="0 0 500 400" xmlns="http://www.w3.org/2000/svg" aria-label="Help desk vector banner">
                        <defs>
                            <linearGradient id="gradRed" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#D71920" />
                                <stop offset="100%" stop-color="#ff758c" />
                            </linearGradient>
                        </defs>
                        <!-- Circle shape -->
                        <circle cx="250" cy="200" r="160" fill="url(#gradRed)" opacity="0.1" />
                        <circle cx="150" cy="100" r="40" fill="#D71920" opacity="0.1" />
                        <!-- Headset Support Rep illustration -->
                        <rect x="150" y="160" width="200" height="180" rx="30" fill="#1f2937" stroke="rgba(255,255,255,0.08)" stroke-width="3" />
                        <rect x="170" y="200" width="160" height="120" rx="12" fill="#111827" />
                        <circle cx="250" cy="245" r="24" fill="url(#gradRed)" />
                        <!-- Screen layout mockup -->
                        <rect x="185" y="215" width="130" height="5" rx="2.5" fill="#ffffff" opacity="0.2" />
                        <rect x="185" y="228" width="100" height="5" rx="2.5" fill="#ffffff" opacity="0.1" />
                        <circle cx="215" cy="285" r="5" fill="#10b981" />
                        <rect x="226" y="282" width="60" height="6" rx="3" fill="#ffffff" opacity="0.3" />
                        <!-- Floating helper gears -->
                        <g fill="#D71920" opacity="0.6">
                            <circle cx="390" cy="120" r="15" />
                            <rect x="385" y="100" width="10" height="40" rx="3" transform="rotate(30 390 120)" />
                            <rect x="385" y="100" width="10" height="40" rx="3" transform="rotate(120 390 120)" />
                        </g>
                    </svg>
                </div>
            </div>
        </div>
    </section>

    <!-- ========== 2. SEARCH FAQS HIGHLIGHTS ========== -->
    <section class="py-0">
        <div class="container">
            <div class="search-wrapper mx-auto">
                <div class="search-card">
                    <form class="needs-validation" novalidate>
                        <div class="search-input-group">
                            <i class="bi bi-magnifying-glass search-icon"></i>
                            <input type="text" id="heroSearchInput" class="form-control search-input" placeholder="Bạn cần hỗ trợ điều gì?" required>
                            <button type="submit" class="btn btn-search">Tìm kiếm</button>
                        </div>
                    </form>
                    <div class="d-flex flex-wrap align-items-center gap-2 mt-3">
                        <span class="search-tags-label me-2">Gợi ý tìm nhanh:</span>
                        <a href="#guide-create" class="search-tag-link">Cách tạo phiếu hỗ trợ</a>
                        <a href="#guide-lookup" class="search-tag-link">Cách tra cứu phiếu</a>
                        <a href="#guide-chat" class="search-tag-link">Cách trao đổi với nhân viên</a>
                        <a href="#guide-appointment" class="search-tag-link">Cách đặt lịch hỗ trợ</a>
                        <a href="#guide-rating" class="search-tag-link">Cách đánh giá dịch vụ</a>
                        <a href="#guide-attachment" class="search-tag-link">Cách gửi file đính kèm</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ========== 3. HELP GUIDE CATEGORIES (6 CARDS) ========== -->
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-5" data-aos="fade-up">
                <h2 class="fw-bold text-dark fs-3">DANH MỤC HƯỚNG DẪN</h2>
                <p class="text-muted small">Chọn chủ đề bạn muốn tìm hiểu bên dưới để đi nhanh đến chi tiết</p>
            </div>
            <div class="row g-4">
                <!-- Card 1 -->
                <div class="col-lg-4 col-md-6 col-12" data-aos="fade-up">
                    <a href="#guide-create" class="text-decoration-none category-card-link">
                        <div class="card glass-card p-4 h-100">
                            <div class="category-icon-box mb-3">
                                <i class="bi bi-ticket-perforated-fill"></i>
                            </div>
                            <h3 class="category-title">Tạo phiếu hỗ trợ</h3>
                            <p class="category-desc">Tìm hiểu quy trình đăng ký báo hỏng thiết bị, yêu cầu lắp đặt wifi và các dịch vụ kỹ thuật.</p>
                        </div>
                    </a>
                </div>
                <!-- Card 2 -->
                <div class="col-lg-4 col-md-6 col-12" data-aos="fade-up" data-aos-delay="50">
                    <a href="#guide-lookup" class="text-decoration-none category-card-link">
                        <div class="card glass-card p-4 h-100">
                            <div class="category-icon-box mb-3">
                                <i class="bi bi-search"></i>
                            </div>
                            <h3 class="category-title">Tra cứu phiếu</h3>
                            <p class="category-desc">Theo dõi tiến trình xử lý, thời gian dự kiến kỹ thuật viên hoàn thành sự cố của bạn.</p>
                        </div>
                    </a>
                </div>
                <!-- Card 3 -->
                <div class="col-lg-4 col-md-6 col-12" data-aos="fade-up" data-aos-delay="100">
                    <a href="#guide-chat" class="text-decoration-none category-card-link">
                        <div class="card glass-card p-4 h-100">
                            <div class="category-icon-box mb-3">
                                <i class="bi bi-chat-dots-fill"></i>
                            </div>
                            <h3 class="category-title">Trao đổi với nhân viên</h3>
                            <p class="category-desc">Nhắn tin trực tiếp với nhân viên kỹ thuật phụ trách phiếu hỗ trợ để phản hồi sự cố.</p>
                        </div>
                    </a>
                </div>
                <!-- Card 4 -->
                <div class="col-lg-4 col-md-6 col-12" data-aos="fade-up" data-aos-delay="150">
                    <a href="#guide-appointment" class="text-decoration-none category-card-link">
                        <div class="card glass-card p-4 h-100">
                            <div class="category-icon-box mb-3">
                                <i class="bi bi-calendar2-check-fill"></i>
                            </div>
                            <h3 class="category-title">Đặt lịch hỗ trợ</h3>
                            <p class="category-desc">Hướng dẫn hẹn thời gian cụ thể để kỹ thuật viên ghé nhà kiểm tra trực tiếp đường truyền.</p>
                        </div>
                    </a>
                </div>
                <!-- Card 5 -->
                <div class="col-lg-4 col-md-6 col-12" data-aos="fade-up" data-aos-delay="200">
                    <a href="#guide-rating" class="text-decoration-none category-card-link">
                        <div class="card glass-card p-4 h-100">
                            <div class="category-icon-box mb-3">
                                <i class="bi bi-star-fill"></i>
                            </div>
                            <h3 class="category-title">Đánh giá dịch vụ</h3>
                            <p class="category-desc">Gửi phản hồi đánh giá sao đối với chất lượng xử lý sự cố và thái độ kỹ thuật viên.</p>
                        </div>
                    </a>
                </div>
                <!-- Card 6 -->
                <div class="col-lg-4 col-md-6 col-12" data-aos="fade-up" data-aos-delay="250">
                    <a href="#guide-account" class="text-decoration-none category-card-link">
                        <div class="card glass-card p-4 h-100">
                            <div class="category-icon-box mb-3">
                                <i class="bi bi-person-gear"></i>
                            </div>
                            <h3 class="category-title">Tài khoản khách hàng</h3>
                            <p class="category-desc">Quản lý hồ sơ cá nhân, cập nhật thông tin liên lạc và bảo mật mật khẩu tài khoản.</p>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- ========== 4. DETAIL GUIDE CONTENT BLOCKS ========== -->
    <section class="py-4">
        <div class="container">

            <!-- 4.1 HƯỚNG DẪN TẠO PHIẾU HỖ TRỢ -->
            <div class="card glass-card p-4 mb-5" id="guide-create" data-aos="fade-up">
                <h3 class="guide-section-title mb-4"><i class="fa-solid fa-ticket text-danger me-2"></i>HƯỚNG DẪN TẠO PHIẾU HỖ TRỢ KỸ THUẬT</h3>
                <p class="text-muted">Khi gặp sự cố kỹ thuật về đường truyền hoặc dịch vụ, khách hàng thực hiện các bước sau để đăng ký phiếu:</p>

                <div class="step-timeline-container">
                    <!-- Step 1 -->
                    <div class="step-timeline-item">
                        <div class="step-number-node">1</div>
                        <div class="step-card">
                            <h5 class="fw-bold mb-1">Đăng nhập tài khoản</h5>
                            <p class="text-muted small mb-0">Truy cập hệ thống TechSupport và đăng nhập bằng tài khoản MyViettel hoặc Số điện thoại đăng ký gói mạng.</p>
                        </div>
                    </div>

                    <!-- Step 2 -->
                    <div class="step-timeline-item">
                        <div class="step-number-node">2</div>
                        <div class="step-card">
                            <h5 class="fw-bold mb-1">Chọn Tạo phiếu hỗ trợ</h5>
                            <p class="text-muted small mb-0">Tại thanh Menu chính hoặc Trang chủ, nhấp chọn nút <a asp-controller="Ticket" asp-action="ChonDMDichVu" class="text-danger fw-bold text-decoration-none"><i class="fa-solid fa-plus-circle me-1"></i>Tạo phiếu hỗ trợ</a>.</p>
                        </div>
                    </div>

                    <!-- Step 3 -->
                    <div class="step-timeline-item">
                        <div class="step-number-node">3</div>
                        <div class="step-card">
                            <h5 class="fw-bold mb-2">Chọn dịch vụ kỹ thuật</h5>
                            <p class="text-muted small mb-3">Lựa chọn dịch vụ Viettel mà bạn đang gặp sự cố. Dữ liệu dịch vụ bao gồm:</p>
                            <div class="row g-2">
                                <div class="col-sm-6 col-12">
                                    <div class="p-2 border rounded bg-light small"><i class="bi bi-wifi me-2 text-danger"></i>Internet Cáp Quang FTTH</div>
                                </div>
                                <div class="col-sm-6 col-12">
                                    <div class="p-2 border rounded bg-light small"><i class="bi bi-tv me-2 text-danger"></i>Combo Internet + TV360</div>
                                </div>
                                <div class="col-sm-6 col-12">
                                    <div class="p-2 border rounded bg-light small"><i class="bi bi-video me-2 text-danger"></i>Camera Giám Sát Home Camera</div>
                                </div>
                                <div class="col-sm-6 col-12">
                                    <div class="p-2 border rounded bg-light small"><i class="bi bi-network-wired me-2 text-danger"></i>Mesh Wifi & LAN Doanh nghiệp</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 4 -->
                    <div class="step-timeline-item">
                        <div class="step-number-node">4</div>
                        <div class="step-card">
                            <h5 class="fw-bold mb-1">Nhập tiêu đề và nội dung mô tả lỗi</h5>
                            <p class="text-muted small mb-0">Mô tả rõ ràng hiện trạng sự cố (Ví dụ: Modem nhấp nháy đèn đỏ, đầu thu không tải được hình, v.v.) để kỹ thuật viên nắm rõ.</p>
                        </div>
                    </div>

                    <!-- Step 5 -->
                    <div class="step-timeline-item">
                        <div class="step-number-node">5</div>
                        <div class="step-card">
                            <h5 class="fw-bold mb-1">Đính kèm file hình ảnh/tài liệu (Nếu có)</h5>
                            <p class="text-muted small mb-0">Tải lên hình ảnh thiết bị báo lỗi hoặc tài liệu liên quan giúp kỹ thuật viên chẩn đoán lỗi nhanh hơn (hỗ trợ JPG, PNG, PDF, DOCX, XLSX).</p>
                        </div>
                    </div>

                    <!-- Step 6 -->
                    <div class="step-timeline-item">
                        <div class="step-number-node">6</div>
                        <div class="step-card">
                            <h5 class="fw-bold mb-1">Gửi phiếu hỗ trợ</h5>
                            <p class="text-muted small mb-0">Xác nhận lại thông tin liên lạc và nhấp nút "Gửi phiếu" để hoàn tất đăng ký sự cố lên hệ thống điều hành kỹ thuật, đồng thời hệ thống sẽ tự động gửi thông báo xác nhận đồng bộ qua tin nhắn SMS và Email của bạn.</p>
                        </div>
                    </div>

                    <!-- Step 7 -->
                    <div class="step-timeline-item">
                        <div class="step-number-node">7</div>
                        <div class="step-card">
                            <h5 class="fw-bold mb-2">Nhận mã phiếu hỗ trợ</h5>
                            <p class="text-muted small mb-2">Hệ thống sẽ lập tức phản hồi mã phiếu hỗ trợ kỹ thuật dạng:</p>
                            <span class="font-monospace fw-bold text-danger bg-danger bg-opacity-10 border border-danger border-opacity-20 px-3 py-1 rounded" style="font-size:0.9rem;">HT202600001</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 4.2 HƯỚNG DẪN TRA CỨU PHIẾU HỖ TRỢ -->
            <div class="card glass-card p-4 mb-5" id="guide-lookup" data-aos="fade-up">
                <h3 class="guide-section-title mb-4"><i class="fa-solid fa-search text-danger me-2"></i>HƯỚNG DẪN TRA CỨU PHIẾU HỖ TRỢ</h3>
                <p class="text-muted">Khách hàng có thể tự tra cứu tiến trình xử lý phiếu sự cố kỹ thuật của mình theo các cách thức sau:</p>

                <!-- Methods of lookup -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4 col-12">
                        <div class="p-3 border rounded-3 bg-light text-center height-100">
                            <i class="bi bi-barcode fs-3 text-danger mb-2"></i>
                            <h6 class="fw-bold mb-1">Tra cứu bằng Mã phiếu</h6>
                            <p class="text-muted small mb-0">Nhập chính xác mã phiếu hỗ trợ (Ví dụ: HT202600001) để lấy thông tin tức thời.</p>
                        </div>
                    </div>
                    <div class="col-md-4 col-12">
                        <div class="p-3 border rounded-3 bg-light text-center height-100">
                            <i class="fa-solid fa-phone fs-3 text-danger mb-2"></i>
                            <h6 class="fw-bold mb-1">Tra cứu bằng Số điện thoại</h6>
                            <p class="text-muted small mb-0">Xem danh sách các phiếu hỗ trợ phát sinh từ số điện thoại liên kết của bạn.</p>
                        </div>
                    </div>
                    <div class="col-md-4 col-12">
                        <div class="p-3 border rounded-3 bg-light text-center height-100">
                            <i class="fa-solid fa-envelope fs-3 text-danger mb-2"></i>
                            <h6 class="fw-bold mb-1">Tra cứu bằng Email</h6>
                            <p class="text-muted small mb-0">Nhập email đã đăng ký thông tin hợp đồng internet để tra cứu lịch sử sự cố.</p>
                        </div>
                    </div>
                </div>

                <!-- Status explanations -->
                <h5 class="fw-bold text-dark-emphasis mb-3"><i class="fa-solid fa-circle-info me-2 text-primary"></i>Các trạng thái xử lý phiếu trên hệ thống</h5>
                <div class="row g-3">
                    <!-- Status 1 -->
                    <div class="col-lg-25 col-md-4 col-6">
                        <div class="status-representation-card">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="status-bullet-dot waiting"></span>
                                <strong class="small text-dark-emphasis">Chờ xử lý</strong>
                            </div>
                            <p class="text-muted fs-8 mb-0">Phiếu hỗ trợ đã được tạo và đang nằm trong hàng đợi điều phối kỹ thuật viên phụ trách.</p>
                        </div>
                    </div>
                    <!-- Status 2 -->
                    <div class="col-lg-25 col-md-4 col-6">
                        <div class="status-representation-card">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="status-bullet-dot processing"></span>
                                <strong class="small text-primary">Đang xử lý</strong>
                            </div>
                            <p class="text-muted fs-8 mb-0">Kỹ thuật viên đã tiếp nhận thông tin và đang tiến hành khắc phục sự cố tại trạm hoặc ghé nhà.</p>
                        </div>
                    </div>
                    <!-- Status 3 -->
                    <div class="col-lg-25 col-md-4 col-6">
                        <div class="status-representation-card">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="status-bullet-dot feedback"></span>
                                <strong class="small text-warning">Chờ phản hồi</strong>
                            </div>
                            <p class="text-muted fs-8 mb-0">Nhân viên cần khách hàng xác minh đường truyền hoặc phản hồi phản ánh bổ sung.</p>
                        </div>
                    </div>
                    <!-- Status 4 -->
                    <div class="col-lg-25 col-md-6 col-6">
                        <div class="status-representation-card">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="status-bullet-dot completed"></span>
                                <strong class="small text-success">Hoàn thành</strong>
                            </div>
                            <p class="text-muted fs-8 mb-0">Sự cố đã được khắc phục hoàn tất. Đường truyền internet hoạt động bình thường trở lại.</p>
                        </div>
                    </div>
                    <!-- Status 5 -->
                    <div class="col-lg-25 col-md-6 col-12">
                        <div class="status-representation-card">
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="status-bullet-dot cancelled"></span>
                                <strong class="small text-danger">Đã hủy</strong>
                            </div>
