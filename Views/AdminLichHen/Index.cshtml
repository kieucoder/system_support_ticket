                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small">Chọn kỹ thuật viên <span class="text-danger">*</span></label>
                        <select name="IdNhanVien" id="confirmIdNhanVien" class="form-select vt-form-select" required asp-items="@Model.NhanVienList">
                            <option value="">-- Chọn kỹ thuật viên --</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small">Ghi chú phân công (nếu có)</label>
                        <textarea name="GhiChu" class="form-control rounded-3" rows="2" placeholder="Nhập ghi chú cho KTV..."></textarea>
                    </div>
                </div>
                <div class="modal-footer vt-modal-footer">
                    <button type="button" class="vt-btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="vt-btn-primary bg-success"><i class="fa-solid fa-check me-1"></i> Xác nhận & Phân công</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL 2: TỪ CHỐI -->
