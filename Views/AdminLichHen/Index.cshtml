                    <!-- CỘT PHẢI: Thông tin lịch hẹn & Kỹ thuật viên -->
                    <div class="col-md-6">
                        <div class="bg-white shadow-sm h-100 border vt-compact-card">
                            <h6 class="fw-bold text-primary mb-2 border-bottom pb-1" style="font-size: 13.5px;">
                                <i class="fa-solid fa-clock me-1"></i>Thông Tin Lịch Hẹn & KTV
                            </h6>
                            <div class="vt-compact-field">
                                <span class="text-muted vt-compact-label d-block">Kỹ thuật viên phụ trách:</span>
                                <strong class="text-dark vt-compact-val" id="detailTenNhanVien">—</strong>
                            </div>
                            <div class="vt-compact-field">
                                <span class="text-muted vt-compact-label d-block">Ngày hẹn:</span>
                                <span class="badge bg-danger text-white px-2 py-0.5" style="font-size: 12.5px;" id="detailNgayHen">—</span>
                            </div>
                            <div class="vt-compact-field">
                                <span class="text-muted vt-compact-label d-block">Giờ hẹn (Khung giờ):</span>
                                <span class="fw-bold text-dark vt-compact-val" id="detailKhungGio">—</span>
                            </div>
                            <div class="vt-compact-field">
                                <span class="text-muted vt-compact-label d-block">Địa chỉ hỗ trợ:</span>
                                <span class="text-dark small fw-semibold vt-compact-val" id="detailDiaDiemKhachHang">—</span>
                            </div>
                            <div class="vt-compact-field">
                                <span class="text-muted vt-compact-label d-block">Trạng thái:</span>
                                <span class="vt-status-pill badge bg-danger text-white px-2.5 py-0.5" style="font-size: 12px;" id="detailTrangThaiBadge">Chờ xác nhận</span>
                            </div>
                            <div class="vt-compact-field">
                                <span class="text-muted vt-compact-label d-block">Ghi chú:</span>
                                <div class="small text-muted fst-italic p-1.5 bg-light rounded vt-compact-textarea" style="font-size: 12.5px; overflow-y: auto;" id="detailGhiChu">Không có ghi chú thêm.</div>
                            </div>
                            <div class="vt-compact-field mb-0">
                                <span class="text-muted vt-compact-label d-block">File đính kèm:</span>
                                <div id="detailFilesContainer" class="small text-muted" style="font-size: 12.5px;">Không có file đính kèm.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer: Chỉ có nút Đóng -->
            <div class="modal-footer bg-white border-0 justify-content-end">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL POPUP 2: CHỈNH SỬA / CẬP NHẬT LỊCH HẸN -->
<div class="modal fade modal-vt-custom" id="editLichHenModal" tabindex="-1" aria-labelledby="editLichHenModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg overflow-hidden" style="border-radius: 14px; background-color: #ffffff;">
            <form asp-controller="AdminLichHen" asp-action="Edit" method="post" id="editLichHenFormModal">
                @Html.AntiForgeryToken()
                <input type="hidden" name="IdLichHen" id="editModalIdLichHen" />
                <input type="hidden" name="IdPhieu" id="editModalIdPhieu" />

                <!-- Header Viettel Red #E60012 -->
                <div class="modal-header border-0 text-white position-relative" style="background: linear-gradient(135deg, #E60012 0%, #B00F15 100%);">
                    <div class="d-flex align-items-center gap-2">
                        <div class="rounded-circle bg-white text-danger d-flex align-items-center justify-content-center shadow-sm vt-header-icon">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </div>
                        <div>
                            <h5 class="modal-title text-white m-0" id="editLichHenModalLabel">Chỉnh sửa lịch hẹn</h5>
                            <div class="small text-white-50" style="font-size: 0.75rem;">Mã phiếu hỗ trợ: <strong id="editModalMaPhieuText" class="text-white">...</strong></div>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <!-- Modal Body (Chia 2 cột) -->
                <div class="modal-body bg-light">
                    <!-- Alert Thông báo Lỗi / Xung Đột -->
                    <div id="editModalConflictAlertBanner" class="alert alert-danger d-none mb-2 border-0 shadow-sm rounded-3 py-1.5 px-3" role="alert">
                        <div class="d-flex align-items-center">
                            <i class="fa-solid fa-triangle-exclamation me-2 fs-5"></i>
                            <div class="small fw-bold" style="font-size: 12.5px;" id="editModalConflictBannerDesc">Kỹ thuật viên đã có lịch hẹn trong khoảng thời gian này. Vui lòng chọn nhân viên khác hoặc đổi thời gian.</div>
                        </div>
                    </div>

                    <div class="row g-2">
                        <!-- CỘT TRÁI: Thông tin phiếu READONLY -->
                        <div class="col-md-6">
                            <div class="bg-white shadow-sm h-100 border vt-compact-card">
                                <h6 class="fw-bold text-secondary mb-2 border-bottom pb-1" style="font-size: 13.5px;">
                                    <i class="fa-solid fa-lock me-1"></i>Thông Tin Cố Định (Readonly)
                                </h6>
                                <div class="vt-compact-field">
                                    <label class="form-label text-muted vt-compact-label">Mã lịch hẹn</label>
                                    <input type="text" class="form-control bg-light border-0 fw-bold text-dark" id="editDisplayIdLichHen" readonly value="—" />
                                </div>
                                <div class="vt-compact-field">
                                    <label class="form-label text-muted vt-compact-label">Mã phiếu hỗ trợ</label>
                                    <input type="text" class="form-control bg-light border-0 fw-bold text-danger" id="editDisplayMaPhieu" readonly value="—" />
                                </div>
                                <div class="vt-compact-field">
                                    <label class="form-label text-muted vt-compact-label">Khách hàng</label>
                                    <input type="text" class="form-control bg-light border-0 fw-semibold text-dark" id="editDisplayKhachHang" readonly value="—" />
                                </div>
                                <div class="vt-compact-field">
                                    <label class="form-label text-muted vt-compact-label">Danh mục</label>
                                    <input type="text" class="form-control bg-light border-0 text-dark" id="editDisplayDanhMuc" readonly value="—" />
                                </div>
                                <div class="vt-compact-field mb-0">
                                    <label class="form-label text-muted vt-compact-label">Dịch vụ</label>
                                    <input type="text" class="form-control bg-light border-0 text-dark" id="editDisplayDichVu" readonly value="—" />
                                </div>
                            </div>
                        </div>

                        <!-- CỘT PHẢI: Thông tin CHO PHÉP CHỈNH SỬA -->
                        <div class="col-md-6">
                            <div class="bg-white shadow-sm h-100 border vt-compact-card">
                                <h6 class="fw-bold text-danger mb-2 border-bottom pb-1" style="font-size: 13.5px;">
                                    <i class="fa-solid fa-sliders me-1"></i>Thông Tin Chỉnh Sửa
                                </h6>

                                <!-- KTV -->
                                <div class="vt-compact-field">
                                    <label class="form-label text-dark vt-compact-label">
                                        Kỹ Thuật Viên Phụ Trách <span class="text-danger">*</span>
                                    </label>
                                    <select name="IdNhanVien" class="form-select bg-white border text-dark" id="editModalStaffInput" asp-items="@Model.NhanVienList" required>
                                        <option value="">-- Chọn kỹ thuật viên --</option>
                                    </select>
                                </div>

                                <!-- Ngày hẹn -->
                                <div class="vt-compact-field">
                                    <label class="form-label text-dark vt-compact-label">
                                        Ngày Hẹn <span class="text-danger">*</span>
                                    </label>
                                    <input type="date" name="NgayHen" class="form-control bg-white border text-dark" id="editModalInputNgayHen" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                                </div>

                                <!-- Giờ hẹn -->
                                <div class="row g-1 vt-compact-field">
                                    <div class="col-6">
                                        <label class="form-label text-dark vt-compact-label">
                                            Giờ Bắt Đầu <span class="text-danger">*</span>
                                        </label>
                                        <input type="time" name="GioBatDau" class="form-control bg-white border text-dark" id="editModalInputGioBatDau" required />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label text-dark vt-compact-label">
                                            Giờ Kết Thúc <span class="text-danger">*</span>
                                        </label>
                                        <input type="time" name="GioKetThuc" class="form-control bg-white border text-dark" id="editModalInputGioKetThuc" required />
                                    </div>
                                </div>

                                <!-- Địa chỉ hỗ trợ -->
                                <div class="vt-compact-field">
                                    <label class="form-label text-dark vt-compact-label">
                                        Địa Chỉ Hỗ Trợ <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" name="DiaDiem" class="form-control bg-white border text-dark" id="editModalInputDiaDiem" placeholder="Nhập địa chỉ..." required />
                                </div>

                                <!-- Ghi chú -->
                                <div class="vt-compact-field mb-0">
                                    <label class="form-label text-dark vt-compact-label">Ghi Chú Admin</label>
                                    <textarea name="GhiChu" class="form-control bg-white border text-dark vt-compact-textarea" id="editModalGhiChu" rows="2" placeholder="Nhập ghi chú..."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer bg-white border-0 justify-content-end gap-2">
                    <button type="button" class="btn btn-light text-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger text-white shadow-sm" style="background-color:#E60012; border-color:#E60012;">
                        <i class="fa-solid fa-floppy-disk me-1"></i> Cập Nhật
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- TOAST NOTIFICATION CONTAINER -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">
    <div id="vtSuccessToast" class="toast align-items-center text-white bg-success border-0 rounded-3 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body font-weight-semibold" id="vtSuccessToastMsg">
                <i class="fa-solid fa-circle-check me-2"></i>Cập nhật lịch hẹn thành công.
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>
<!-- MODAL 0: TẠO LỊCH HẸN TRỰC TIẾP (POPUP HỆ THỐNG) -->
<div class="modal fade" id="createLichHenModal" tabindex="-1" aria-labelledby="createLichHenModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content vt-modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <form asp-controller="AdminLichHen" asp-action="Create" method="post" id="createLichHenFormModal">
                @Html.AntiForgeryToken()

                <!-- Modal Header -->
                <div class="modal-header border-0 text-white p-4 position-relative" style="background: linear-gradient(135deg, #D71920 0%, #B00F15 100%);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-white text-danger d-flex align-items-center justify-content-center shadow-sm" style="width: 46px; height: 46px; font-size: 1.25rem;">
                            <i class="fa-solid fa-calendar-plus"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold text-white m-0" id="createLichHenModalLabel">Tạo Lịch Hẹn Hỗ Trợ Kỹ Thuật</h5>
                            <div class="small text-white-50 mt-0.5">Đặt lịch hẹn hỗ trợ trực tiếp hoặc trực tuyến cho phiếu yêu cầu</div>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <!-- Modal Body -->
                <div class="modal-body p-4 bg-light">
                    <!-- 1. Chọn phiếu hỗ trợ -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small mb-1">
                            Chọn Phiếu Hỗ Trợ Kỹ Thuật <span class="text-danger">*</span>
                        </label>
                        @if (Model.PhieuList != null && Model.PhieuList.Any())
                        {
                            <select name="IdPhieu" class="form-select bg-white border-0 py-2.5 shadow-sm rounded-3 fw-bold text-dark" id="modalSelectPhieuInput" required asp-items="@Model.PhieuList">
                                <option value="">-- Chọn phiếu hỗ trợ chưa có lịch hẹn --</option>
                            </select>
                        }
                        else
                        {
                            <div class="alert alert-warning border-0 rounded-3 mb-0 small">
                                <i class="fa-solid fa-circle-info me-2"></i>Hiện tại tất cả các phiếu hỗ trợ đang xử lý đều đã có lịch hẹn hoặc không có phiếu khả dụng.
                            </div>
                        }
                    </div>

                    <!-- 2. Kỹ thuật viên -->
                    <div class="mb-3">
                        <label class="form-label fw-bold text-dark small mb-1">
                            Phân Công Kỹ Thuật Viên Phụ Trách (Tùy chọn)
                        </label>
                        <select name="IdNhanVien" class="form-select bg-white border-0 py-2.5 shadow-sm rounded-3 text-dark" id="modalSelectStaffInput" asp-items="@Model.NhanVienList">
                            <option value="">-- Để trống nếu chưa phân công (Trạng thái sẽ là Chờ xác nhận) --</option>
                        </select>
                        <div class="form-text text-muted small mt-1">
                            <i class="fa-solid fa-circle-info me-1 text-primary"></i>Nếu chọn KTV, lịch hẹn sẽ được tự động chuyển sang trạng thái <strong>Đã xác nhận</strong>.
                        </div>
                    </div>

                    <!-- Conflict alert -->
                    <div id="modalConflictAlertBanner" class="alert alert-warning d-none mb-3 border-0 shadow-sm rounded-3" role="alert">
                        <div class="d-flex align-items-center">
                            <i class="fa-solid fa-triangle-exclamation me-2 fs-5"></i>
                            <div>
                                <div class="fw-bold small" id="modalConflictBannerTitle">Cảnh báo xung đột lịch làm việc</div>
                                <div class="small" id="modalConflictBannerDesc">KTV đã có lịch hẹn trùng khung giờ này.</div>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Ngày & Giờ hẹn -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-dark small mb-1">
                                Ngày Hẹn <span class="text-danger">*</span>
                            </label>
                            <input type="date" name="NgayHen" class="form-control bg-white border-0 py-2.5 shadow-sm rounded-3 text-dark" id="modalInputNgayHen" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-dark small mb-1">
                                Giờ Bắt Đầu <span class="text-danger">*</span>
                            </label>
                            <input type="time" name="GioBatDau" class="form-control bg-white border-0 py-2.5 shadow-sm rounded-3 text-dark" id="modalInputGioBatDau" value="08:00" required />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-dark small mb-1">
                                Giờ Kết Thúc <span class="text-danger">*</span>
                            </label>
                            <input type="time" name="GioKetThuc" class="form-control bg-white border-0 py-2.5 shadow-sm rounded-3 text-dark" id="modalInputGioKetThuc" value="10:00" required />
                        </div>
                    </div>

                    <!-- 4. Hình thức & Địa điểm -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold text-dark small mb-1">
                                Hình Thức Hỗ Trợ <span class="text-danger">*</span>
                            </label>
                            <select name="HinhThuc" class="form-select bg-white border-0 py-2.5 shadow-sm rounded-3 text-dark" id="modalSelectHinhThuc">
                                <option value="TrucTiep">Trực tiếp (Tại nhà/Cơ quan KH)</option>
                                <option value="TrucTuyen">Trực tuyến (Online/Remote)</option>
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-bold text-dark small mb-1">
                                Địa Điểm Hỗ Trợ <span class="text-danger">*</span>
                            </label>
                            <input type="text" name="DiaDiem" class="form-control bg-white border-0 py-2.5 shadow-sm rounded-3 text-dark" id="modalInputDiaDiem" placeholder="Nhập địa chỉ nhà hoặc địa điểm cần KTV đến hỗ trợ..." required />
                        </div>
                    </div>

                    <!-- 5. Ghi chú -->
                    <div class="mb-0">
                        <label class="form-label fw-bold text-dark small mb-1">Ghi Chú Admin / Phụ Trách</label>
                        <textarea name="GhiChu" class="form-control bg-white border-0 shadow-sm rounded-3 text-dark" rows="2" placeholder="Ghi chú thiết bị, vật tư hoặc yêu cầu đặc biệt cho KTV..."></textarea>
                    </div>
                </div>

                <!-- Modal Footer -->
                <div class="modal-footer vt-modal-footer bg-white border-0 p-3 justify-content-end gap-2">
                    <button type="button" class="btn btn-light px-4 py-2 text-secondary fw-bold rounded-pill" data-bs-dismiss="modal">
                        Hủy bỏ
                    </button>
                    <button type="submit" class="btn btn-danger px-4 py-2 fw-bold text-white rounded-pill shadow-sm" style="background-color:#D71920; border-color:#D71920;">
                        <i class="fa-solid fa-plus me-1"></i> Tạo Lịch Hẹn Mới
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL 1: XÁC NHẬN & PHÂN CÔNG -->
