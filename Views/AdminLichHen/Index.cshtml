                            </div>
                            <div class="vt-compact-field">
                                <span class="text-muted vt-compact-label d-block">Dịch vụ:</span>
                                <span class="fw-semibold text-dark vt-compact-val" id="detailTenDichVu">—</span>
                            </div>
                            <div class="vt-compact-field mb-0">
                                <span class="text-muted vt-compact-label d-block">Ngày tạo phiếu:</span>
                                <span class="text-muted small" style="font-size: 12.5px;" id="detailNgayTao">—</span>
