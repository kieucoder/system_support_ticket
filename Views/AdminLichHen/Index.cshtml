</div>

@section Scripts {
    <script src="~/assets/js/admin/lichhen.js" asp-append-version="true"></script>
    <script>
        function openDetailsModal(idLichHen) {
            const modal = bootstrap.Modal.getOrCreateInstance('#detailsLichHenModal');
            document.getElementById('detailIdLichHen').textContent = '#' + idLichHen;
            document.getElementById('detailMaPhieuText').textContent = '...';
            document.getElementById('detailMaPhieuTitle').textContent = 'PHT...';
            document.getElementById('detailTenKhachHang').textContent = 'Đang tải...';
            modal.show();

            fetch(`/Admin/LichHen/GetJson/${idLichHen}`)
                .then(res => {
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    document.getElementById('detailIdLichHen').textContent = '#' + data.idLichHen;
                    document.getElementById('detailMaPhieuText').textContent = data.maPhieu;
                    document.getElementById('detailMaPhieuTitle').textContent = data.maPhieu;
                    document.getElementById('detailTenKhachHang').textContent = data.tenKhachHang;

                    const phoneElem = document.getElementById('detailSoDienThoaiKhachHang');
                    phoneElem.textContent = data.soDienThoaiKhachHang;
                    phoneElem.href = 'tel:' + data.soDienThoaiKhachHang;

                    document.getElementById('detailTenDanhMuc').textContent = data.tenDanhMuc || 'Hỗ trợ kỹ thuật';
                    document.getElementById('detailTenDichVu').textContent = data.tenDichVu;
                    document.getElementById('detailNgayTao').textContent = data.ngayTaoFormatted || '—';

                    document.getElementById('detailTenNhanVien').textContent = data.tenNhanVien + (data.soDienThoaiNhanVien ? ` (${data.soDienThoaiNhanVien})` : '');
                    document.getElementById('detailNgayHen').textContent = data.ngayHenFormatted;
                    document.getElementById('detailKhungGio').textContent = (data.gioBatDau || '--') + ' - ' + (data.gioKetThuc || '--');
                    document.getElementById('detailDiaDiemKhachHang').textContent = data.diaDiem;
                    document.getElementById('detailTrangThaiBadge').textContent = data.trangThaiTitle;
                    document.getElementById('detailGhiChu').textContent = data.ghiChu || 'Không có ghi chú thêm.';

                    const filesContainer = document.getElementById('detailFilesContainer');
                    if (data.files && data.files.length > 0) {
                        filesContainer.innerHTML = data.files.map(f => `<a href="${f.duongDan}" target="_blank" class="d-inline-block text-primary text-decoration-none me-2 mb-1"><i class="fa-solid fa-paperclip me-1"></i>${f.tenFile}</a>`).join('');
                    } else {
                        filesContainer.innerHTML = '<span class="text-muted fst-italic">Không có file đính kèm.</span>';
                    }
                })
                .catch(err => {
                    console.error('Lỗi khi tải chi tiết lịch hẹn:', err);
                    document.getElementById('detailTenKhachHang').textContent = 'Không thể tải dữ liệu.';
                });
        }

        function openEditModal(idLichHen) {
            const modal = bootstrap.Modal.getOrCreateInstance('#editLichHenModal');
            const conflictAlert = document.getElementById('editModalConflictAlertBanner');
            if (conflictAlert) conflictAlert.classList.add('d-none');
            modal.show();

            fetch(`/Admin/LichHen/GetJson/${idLichHen}`)
                .then(res => {
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    document.getElementById('editModalIdLichHen').value = data.idLichHen;
                    document.getElementById('editModalIdPhieu').value = data.idPhieu;

                    document.getElementById('editModalMaPhieuText').textContent = data.maPhieu;
                    document.getElementById('editDisplayIdLichHen').value = '#' + data.idLichHen;
                    document.getElementById('editDisplayMaPhieu').value = data.maPhieu;
                    document.getElementById('editDisplayKhachHang').value = data.tenKhachHang;
                    document.getElementById('editDisplayDanhMuc').value = data.tenDanhMuc || 'Hỗ trợ kỹ thuật';
                    document.getElementById('editDisplayDichVu').value = data.tenDichVu;

                    if (document.getElementById('editModalStaffInput')) {
                        document.getElementById('editModalStaffInput').value = data.idNhanVien || '';
                    }
                    document.getElementById('editModalInputNgayHen').value = data.ngayHen || '';
                    document.getElementById('editModalInputGioBatDau').value = data.gioBatDau || '';
                    document.getElementById('editModalInputGioKetThuc').value = data.gioKetThuc || '';
                    document.getElementById('editModalInputDiaDiem').value = data.diaDiem || '';
                    document.getElementById('editModalGhiChu').value = data.ghiChu || '';
                })
                .catch(err => {
                    console.error('Lỗi khi tải dữ liệu chỉnh sửa:', err);
                });
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Đăng ký AJAX submit cho Form Cập Nhật Lịch Hẹn
            const editForm = document.getElementById('editLichHenFormModal');
            if (editForm) {
                editForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    const idLichHen = document.getElementById('editModalIdLichHen').value;
                    const formData = new FormData(editForm);
                    const conflictAlert = document.getElementById('editModalConflictAlertBanner');
                    const conflictDesc = document.getElementById('editModalConflictBannerDesc');

                    fetch(`/Admin/LichHen/Edit/${idLichHen}`, {
                        method: 'POST',
                        body: formData,
                        headers: {
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            const modal = bootstrap.Modal.getInstance(document.getElementById('editLichHenModal'));
                            if (modal) modal.hide();

                            // Hiển thị Toast thông báo thành công
                            const toastElem = document.getElementById('vtSuccessToast');
                            const toastMsg = document.getElementById('vtSuccessToastMsg');
                            if (toastElem && toastMsg) {
                                toastMsg.innerHTML = `<i class="fa-solid fa-circle-check me-2"></i>${data.message || 'Cập nhật lịch hẹn thành công.'}`;
                                const toast = bootstrap.Toast.getOrCreateInstance(toastElem);
                                toast.show();
                            }

                            // Cập nhật lại giao diện không cần reload F5
                            setTimeout(() => {
                                location.reload();
                            }, 800);
                        } else {
                            if (conflictAlert && conflictDesc) {
                                conflictDesc.textContent = data.message || 'Kỹ thuật viên đã có lịch hẹn trong khoảng thời gian này. Vui lòng chọn nhân viên khác hoặc đổi thời gian.';
                                conflictAlert.classList.remove('d-none');
                            } else {
                                alert(data.message);
                            }
                        }
                    })
                    .catch(err => {
                        console.error('Error submitting edit form:', err);
                        alert('Có lỗi xảy ra khi lưu dữ liệu.');
                    });
                });
            }

            const modalStaffSelect = document.getElementById('modalSelectStaffInput');
            const modalNgayHenInput = document.getElementById('modalInputNgayHen');
            const modalGioBatDauInput = document.getElementById('modalInputGioBatDau');
            const modalGioKetThucInput = document.getElementById('modalInputGioKetThuc');
            const modalHinhThucSelect = document.getElementById('modalSelectHinhThuc');
            const modalConflictBanner = document.getElementById('modalConflictAlertBanner');
            const modalConflictTitle = document.getElementById('modalConflictBannerTitle');
            const modalConflictDesc = document.getElementById('modalConflictBannerDesc');

            function checkModalConflict() {
                const staffId = modalStaffSelect ? modalStaffSelect.value : '';
                const ngayHen = modalNgayHenInput ? modalNgayHenInput.value : '';
                const gioBatDau = modalGioBatDauInput ? modalGioBatDauInput.value : '';
                const gioKetThuc = modalGioKetThucInput ? modalGioKetThucInput.value : '';
                const hinhThuc = modalHinhThucSelect ? modalHinhThucSelect.value : 'TrucTiep';

                if (!staffId || !ngayHen || !gioBatDau || !gioKetThuc || gioBatDau >= gioKetThuc) {
                    if (modalConflictBanner) modalConflictBanner.classList.add('d-none');
                    return;
                }

                const startDateTimeStr = `${ngayHen}T${gioBatDau}:00`;
                const endDateTimeStr = `${ngayHen}T${gioKetThuc}:00`;

                fetch(`/Admin/LichHen/CheckConflict?idNhanVien=${staffId}&start=${encodeURIComponent(startDateTimeStr)}&end=${encodeURIComponent(endDateTimeStr)}&hinhThuc=${hinhThuc}`)
                    .then(res => res.json())
                    .then(data => {
                        if (!data.isAvailable) {
                            if (modalConflictTitle) modalConflictTitle.textContent = 'Cảnh báo xung đột lịch làm việc KTV';
                            if (modalConflictDesc) modalConflictDesc.textContent = `${data.message} (${data.reasons ? data.reasons.join('; ') : ''})`;
                            if (modalConflictBanner) modalConflictBanner.classList.remove('d-none');
                        } else {
                            if (modalConflictBanner) modalConflictBanner.classList.add('d-none');
                        }
                    })
                    .catch(() => {
                        if (modalConflictBanner) modalConflictBanner.classList.add('d-none');
                    });
            }

            if (modalStaffSelect) modalStaffSelect.addEventListener('change', checkModalConflict);
            if (modalNgayHenInput) modalNgayHenInput.addEventListener('change', checkModalConflict);
            if (modalGioBatDauInput) modalGioBatDauInput.addEventListener('change', checkModalConflict);
            if (modalGioKetThucInput) modalGioKetThucInput.addEventListener('change', checkModalConflict);
            if (modalHinhThucSelect) modalHinhThucSelect.addEventListener('change', checkModalConflict);
        });
    </script>
}
