                            </div>
                            <div class="vt-compact-field">
                                <span class="text-muted vt-compact-label d-block">Khách hàng:</span>
                                <strong class="text-dark vt-compact-val" id="detailTenKhachHang">—</strong>
                            </div>
                            <div class="vt-compact-field">
                                <span class="text-muted vt-compact-label d-block">Số điện thoại:</span>
