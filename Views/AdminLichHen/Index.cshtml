<!-- MODAL 4: HOÀN THÀNH LỊCH HẸN -->
<div class="modal fade" id="completeModal" tabindex="-1" aria-labelledby="completeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content vt-modal-content">
            <form asp-controller="AdminLichHen" asp-action="Complete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="idLichHen" id="completeIdLichHen" />

                <div class="modal-header bg-success text-white border-0 p-4 text-center d-flex flex-column align-items-center">
                    <div class="rounded-circle bg-white text-success d-flex align-items-center justify-content-center shadow mb-2" style="width: 56px; height: 56px;">
                        <i class="fa-solid fa-circle-check fs-2"></i>
                    </div>
                    <h5 class="modal-title fw-bold m-0" id="completeModalLabel">Hoàn thành buổi lịch hẹn</h5>
                </div>
                <div class="modal-body p-4 text-center bg-light">
                    <p class="text-muted small mb-0">Buổi hỗ trợ kỹ thuật cho phiếu <strong id="completeMaPhieu" class="text-primary"></strong> sẽ được đánh dấu hoàn thành và đồng bộ trạng thái phiếu.</p>
                </div>
                <div class="modal-footer vt-modal-footer justify-content-center gap-2">
