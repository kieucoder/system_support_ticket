@model SupportTicketSysterm.Models.NhanVienLichHenListViewModel
@{
    ViewData["Title"] = "Lịch Hẹn Của Tôi - Viettel TechSupport Kỹ Thuật Viên";
    Layout = "~/Views/Shared/_LayoutStaff.cshtml";
    var todayDate = DateOnly.FromDateTime(DateTime.Today);
}

@section Styles {
    <link rel="stylesheet" href="~/assets/css/admin/lichhen.css" asp-append-version="true" />
    <style>
        .bg-purple { background-color: #8B5CF6 !important; }
        .vt-badge-reschedule { background-color: #EDE9FE; color: #6D28D9; border: 1px solid #C4B5FD; }
    </style>
}

<div class="container-fluid py-3">
    <!-- ==========================================
       1. HEADER SECTION
       ========================================== -->
    <div class="vt-admin-header d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="vt-admin-header-title text-danger">
                <i class="bi bi-calendar2-check"></i> Lịch hẹn kỹ thuật của tôi
            </h1>
            <p class="vt-admin-header-subtitle text-muted">
                Theo dõi, quản lý công việc và gửi yêu cầu điều phối lịch hẹn hỗ trợ kỹ thuật cá nhân.
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("Index", "NhanVienLichHen")" class="vt-btn-secondary">
                <i class="fa-solid fa-rotate me-1"></i> Làm mới
            </a>
        </div>
    </div>

    <!-- NOTIFICATION ALERTS -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="alert" style="background-color: #F0FDF4; border-left: 4px solid #10B981 !important;">
            <i class="fa-solid fa-circle-check me-2 fs-5 align-middle text-success"></i>
            <span class="fw-semibold text-dark">@TempData["SuccessMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 rounded-4 shadow-sm mb-4" role="alert" style="background-color: #FEF2F2; border-left: 4px solid #EF4444 !important;">
            <i class="fa-solid fa-triangle-exclamation me-2 fs-5 align-middle text-danger"></i>
            <span class="fw-semibold text-dark">@TempData["ErrorMessage"]</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- ==========================================
       2. KPI METRIC CARDS (4 CARDS)
       ========================================== -->
    <div class="row g-3 mb-4">
        <!-- Card 1: Tổng lịch của tôi -->
        <div class="col-md-3 col-6">
            <a href="@Url.Action("Index", "NhanVienLichHen")" class="vt-kpi-card vt-kpi-total text-decoration-none d-block @(string.IsNullOrEmpty(Model.Filter.TrangThai) ? "active" : "")">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="vt-kpi-info-title">Tổng lịch của tôi</div>
                        <div class="vt-kpi-info-val">@Model.TotalMyAppointments</div>
                    </div>
                    <div class="vt-kpi-icon">
                        <i class="fa-solid fa-calendar-days"></i>
                    </div>
                </div>
            </a>
        </div>

        <!-- Card 2: Chờ duyệt -->
        <div class="col-md-3 col-6">
            <a href="@Url.Action("Index", "NhanVienLichHen", new { TrangThai = "ChoDuyet" })" class="vt-kpi-card vt-kpi-pending text-decoration-none d-block @(Model.Filter.TrangThai == "ChoDuyet" ? "active" : "")">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="vt-kpi-info-title">Chờ duyệt</div>
                        <div class="vt-kpi-info-val">@Model.PendingCount</div>
                    </div>
                    <div class="vt-kpi-icon">
                        <i class="fa-solid fa-clock-rotate-left"></i>
                    </div>
                </div>
            </a>
        </div>

        <!-- Card 3: Đã xác nhận -->
        <div class="col-md-3 col-6">
            <a href="@Url.Action("Index", "NhanVienLichHen", new { TrangThai = "DaXacNhan" })" class="vt-kpi-card vt-kpi-confirmed text-decoration-none d-block @(Model.Filter.TrangThai == "DaXacNhan" ? "active" : "")">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="vt-kpi-info-title">Đã xác nhận</div>
                        <div class="vt-kpi-info-val">@Model.ConfirmedCount</div>
                    </div>
                    <div class="vt-kpi-icon">
                        <i class="fa-solid fa-user-check"></i>
                    </div>
                </div>
            </a>
        </div>

        <!-- Card 4: Đã hủy -->
        <div class="col-md-3 col-6">
            <a href="@Url.Action("Index", "NhanVienLichHen", new { TrangThai = "DaHuy" })" class="vt-kpi-card vt-kpi-cancelled text-decoration-none d-block @(Model.Filter.TrangThai == "DaHuy" ? "active" : "")">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="vt-kpi-info-title">Đã hủy</div>
                        <div class="vt-kpi-info-val">@Model.CancelledCount</div>
                    </div>
                    <div class="vt-kpi-icon">
                        <i class="fa-solid fa-calendar-xmark"></i>
                    </div>
                </div>
            </a>
        </div>
    </div>

    <!-- ==========================================
       3. FILTER & SEARCH PANEL
       ========================================== -->
    <div class="vt-filter-card mb-4">
        <form method="get" asp-controller="NhanVienLichHen" asp-action="Index" id="nhanVienLichHenFilterForm" class="row g-3 align-items-end">
            <!-- Tìm kiếm từ khóa -->
            <div class="col-md-4">
                <label class="vt-filter-label" for="txtTuKhoa">Tìm kiếm từ khóa</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0" style="border-radius: 10px 0 0 10px;"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" id="txtTuKhoa" name="TuKhoa" value="@Model.Filter.TuKhoa" class="form-control vt-form-control border-start-0" placeholder="Mã phiếu, tên KH, SĐT..." style="border-radius: 0 10px 10px 0 !important;" />
                </div>
            </div>

            <!-- Trạng thái -->
            <div class="col-md-3 col-6">
                <label class="vt-filter-label" for="selectTrangThai">Trạng thái</label>
                <select id="selectTrangThai" name="TrangThai" class="form-select vt-form-select">
                    <option value="all">-- Tất cả trạng thái --</option>
                    <option value="ChoDuyet" selected="@(Model.Filter.TrangThai == "ChoDuyet")">Chờ duyệt</option>
                    <option value="DaXacNhan" selected="@(Model.Filter.TrangThai == "DaXacNhan")">Đã xác nhận</option>
                    <option value="DangThucHien" selected="@(Model.Filter.TrangThai == "DangThucHien")">Đang thực hiện</option>
                    <option value="HoanThanh" selected="@(Model.Filter.TrangThai == "HoanThanh")">Hoàn thành</option>
                    <option value="ChoXacNhanDoi" selected="@(Model.Filter.TrangThai == "ChoXacNhanDoi")">Chờ xác nhận đổi</option>
                    <option value="DaHuy" selected="@(Model.Filter.TrangThai == "DaHuy")">Đã hủy / Từ chối</option>
                </select>
            </div>

            <!-- Từ ngày -->
            <div class="col-md-2 col-6">
                <label class="vt-filter-label" for="txtTuNgay">Từ ngày</label>
                <input type="date" id="txtTuNgay" name="TuNgay" value="@(Model.Filter.TuNgay?.ToString("yyyy-MM-dd"))" class="form-control vt-form-control" />
            </div>

            <!-- Đến ngày -->
            <div class="col-md-2 col-6">
                <label class="vt-filter-label" for="txtDenNgay">Đến ngày</label>
                <input type="date" id="txtDenNgay" name="DenNgay" value="@(Model.Filter.DenNgay?.ToString("yyyy-MM-dd"))" class="form-control vt-form-control" />
            </div>

            <!-- Action buttons -->
            <div class="col-md-1 col-12 d-flex justify-content-end gap-2">
                <button type="submit" class="vt-btn-primary w-100">
                    <i class="fa-solid fa-filter"></i> Lọc
                </button>
            </div>
        </form>
    </div>

    <!-- ==========================================
       4. DATATABLE LIST
       ========================================== -->
    <div class="vt-table-card">
        <div class="vt-table-header-title p-3 border-bottom d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0">
                <i class="bi bi-list-task text-danger me-2"></i>Danh sách lịch hẹn cá nhân (@Model.TotalItems kết quả)
            </h6>
        </div>

        @if (!Model.Items.Any())
        {
            <div class="vt-empty-state text-center py-5">
                <div class="vt-empty-illustration mb-3" style="font-size: 3rem; color: #ccc;">
                    <i class="bi bi-calendar-x"></i>
                </div>
                <h5 class="vt-empty-title">Không tìm thấy lịch hẹn nào</h5>
                <p class="text-muted small mb-0">Bạn chưa được phân công lịch hẹn hoặc không có kết quả phù hợp với điều kiện lọc.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="vt-datatable table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4" style="width: 60px;">STT</th>
                            <th>Mã Lịch Hẹn & Phiếu</th>
                            <th>Khách Hàng</th>
                            <th>Thời Gian Hẹn</th>
                            <th>Địa Điểm Hỗ Trợ</th>
                            <th class="text-center">Trạng Thái</th>
                            <th class="text-center pe-4" style="min-width: 150px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int stt = (Model.PageIndex - 1) * Model.PageSize + 1; }
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-muted">@stt</td>
                                <!-- Mã lịch hẹn & phiếu -->
                                <td>
                                    <span class="badge bg-secondary mb-1">@item.MaLichHen</span>
                                    <div class="fw-bold text-danger">@item.MaPhieu</div>
                                    <div class="small text-truncate" style="max-width: 200px;" title="@item.TieuDePhieu">@item.TieuDePhieu</div>
                                </td>

                                <!-- Khách hàng -->
                                <td>
                                    <div class="fw-bold text-dark">@item.TenKhachHang</div>
                                    @if (!string.IsNullOrEmpty(item.SoDienThoaiKhachHang))
                                    {
                                        <div class="small text-muted"><i class="fa-solid fa-phone me-1"></i>@item.SoDienThoaiKhachHang</div>
                                    }
                                </td>

                                <!-- Thời gian -->
                                <td>
                                    <div class="fw-semibold text-dark">
                                        <i class="bi bi-calendar-event text-danger me-1"></i>@(item.NgayHen?.ToString("dd/MM/yyyy") ?? "--")
                                    </div>
                                    <div class="small text-muted">
                                        <i class="bi bi-clock me-1"></i>@(item.GioBatDau?.ToString(@"hh\:mm") ?? "--") - @(item.GioKetThuc?.ToString(@"hh\:mm") ?? "--")
                                    </div>
                                </td>

                                <!-- Địa điểm -->
                                <td>
                                    <div class="small text-dark text-truncate" style="max-width: 220px;" title="@item.DiaDiem">
                                        <i class="fa-solid fa-location-dot text-danger me-1"></i>@(string.IsNullOrEmpty(item.DiaDiem) ? "Tại chỗ" : item.DiaDiem)
                                    </div>
                                    <span class="badge bg-light text-secondary border mt-1" style="font-size: 0.7rem;">@item.HinhThuc</span>
                                </td>

                                <!-- Trạng thái -->
                                <td class="text-center">
                                    <span class="badge @item.TrangThaiBadgeClass px-3 py-2 rounded-pill">
                                        @item.TrangThaiTitle
                                    </span>
                                </td>

                                <!-- Thao tác -->
                                <td class="text-center pe-4">
                                    <div class="d-flex align-items-center justify-content-center gap-1">
                                        <!-- 1. Xem chi tiết -->
                                        <button type="button" class="btn btn-sm btn-outline-primary rounded-circle" onclick="openStaffDetailModal(@item.IdLichHen)" title="Xem chi tiết" data-bs-toggle="tooltip">
                                            <i class="fa-solid fa-eye"></i>
                                        </button>

                                        <!-- 2. Yêu cầu đổi lịch (chỉ hiển thị khi đủ điều kiện) -->
                                        @if (item.CanRequestReschedule)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-warning rounded-circle" onclick="openRescheduleModal(@item.IdLichHen, '@item.MaLichHen', '@(item.NgayHen?.ToString("yyyy-MM-dd"))', '@(item.GioBatDau?.ToString(@"hh\:mm"))', '@(item.GioKetThuc?.ToString(@"hh\:mm"))', '@System.Text.Encodings.Web.JavaScriptEncoder.Default.Encode(item.DiaDiem ?? "")')" title="Yêu cầu đổi lịch" data-bs-toggle="tooltip">
                                                <i class="fa-solid fa-calendar-week"></i>
                                            </button>
                                        }

                                        <!-- 3. Hủy lịch (chỉ hiển thị khi đủ điều kiện) -->
                                        @if (item.CanCancel)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-circle" onclick="openStaffCancelModal(@item.IdLichHen, '@item.MaLichHen')" title="Hủy lịch hẹn" data-bs-toggle="tooltip">
                                                <i class="fa-solid fa-ban"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                            stt++;
                        }
                    </tbody>
                </table>
            </div>

            <!-- PAGINATION FOOTER -->
            @if (Model.TotalPages > 1)
            {
                <div class="p-3 bg-light d-flex align-items-center justify-content-between border-top">
                    <div class="small text-muted">
                        Hiển thị <b>@((Model.PageIndex - 1) * Model.PageSize + 1)</b> - <b>@(Math.Min(Model.PageIndex * Model.PageSize, Model.TotalItems))</b> trên <b>@Model.TotalItems</b> lịch hẹn
                    </div>
                    <nav>
                        <ul class="pagination pagination-sm m-0">
                            <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", "NhanVienLichHen", new { Page = Model.PageIndex - 1, TuKhoa = Model.Filter.TuKhoa, TrangThai = Model.Filter.TrangThai })">
                                    <i class="fa-solid fa-chevron-left"></i>
                                </a>
                            </li>
                            @for (int p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                                    <a class="page-link" href="@Url.Action("Index", "NhanVienLichHen", new { Page = p, TuKhoa = Model.Filter.TuKhoa, TrangThai = Model.Filter.TrangThai })">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Url.Action("Index", "NhanVienLichHen", new { Page = Model.PageIndex + 1, TuKhoa = Model.Filter.TuKhoa, TrangThai = Model.Filter.TrangThai })">
                                    <i class="fa-solid fa-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>

<!-- ==========================================
   MODAL POPUPS
   ========================================== -->
<!-- MODAL 1: CHI TIẾT LỊCH HẸN -->
<div class="modal fade" id="staffDetailModal" tabindex="-1" aria-labelledby="staffDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-danger text-white border-0 p-3">
                <h5 class="modal-title fw-bold m-0" id="staffDetailModalLabel">
                    <i class="fa-solid fa-circle-info me-2"></i>Chi tiết Lịch hẹn & Phiếu hỗ trợ
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="staffDetailModalBody">
                <div class="text-center py-4">
                    <div class="spinner-border text-danger" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light border-0">
                <button type="button" class="btn btn-secondary px-4 rounded-3" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL 2: YÊU CẦU ĐỔI LỊCH -->
<div class="modal fade" id="rescheduleModal" tabindex="-1" aria-labelledby="rescheduleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form id="rescheduleForm" asp-controller="NhanVienLichHen" asp-action="YeuCauDoiLich" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="LichHenId" id="rescheduleLichHenId" />

                <div class="modal-header bg-warning text-dark border-0 p-3">
                    <h5 class="modal-title fw-bold m-0" id="rescheduleModalLabel">
                        <i class="fa-solid fa-calendar-day me-2"></i>Gửi yêu cầu đổi lịch hẹn
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Thông tin lịch hiện tại (Read-only) -->
                    <div class="p-3 bg-light rounded-3 mb-3 border">
                        <div class="small text-muted fw-bold mb-1">LỊCH HẸN HIỆN TẠI (<span id="rescheduleMaLichHen" class="text-primary"></span>)</div>
                        <div class="small text-dark" id="rescheduleOldInfo">--</div>
                    </div>

                    <!-- Ngày mới đề xuất -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Ngày mới đề xuất <span class="text-danger">*</span></label>
                        <input type="date" name="NgayMoi" id="rescheduleNgayMoi" class="form-control rounded-3" required />
                    </div>

                    <!-- Khung giờ mới -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold small">Giờ bắt đầu mới <span class="text-danger">*</span></label>
                            <input type="time" name="GioBatDauMoi" id="rescheduleGioBatDauMoi" class="form-control rounded-3" value="08:00" required />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold small">Giờ kết thúc mới <span class="text-danger">*</span></label>
                            <input type="time" name="GioKetThucMoi" id="rescheduleGioKetThucMoi" class="form-control rounded-3" value="10:00" required />
                        </div>
                    </div>

                    <!-- Địa điểm mới -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Địa điểm hỗ trợ mới <span class="text-danger">*</span></label>
                        <input type="text" name="DiaDiemMoi" id="rescheduleDiaDiemMoi" class="form-control rounded-3" required placeholder="Nhập địa điểm mới..." />
                    </div>

                    <!-- Lý do đổi lịch (bắt buộc) -->
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Lý do đổi lịch <span class="text-danger">*</span></label>
                        <textarea name="LyDo" class="form-control rounded-3" rows="3" required placeholder="Nhập chi tiết lý do đề xuất đổi lịch..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-secondary px-3 rounded-3" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-warning px-4 rounded-3 fw-bold"><i class="fa-solid fa-paper-plane me-1"></i> Gửi yêu cầu đổi lịch</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- MODAL 3: HỦY LỊCH HẸN -->
<div class="modal fade" id="staffCancelModal" tabindex="-1" aria-labelledby="staffCancelModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <form id="staffCancelForm" asp-controller="NhanVienLichHen" asp-action="HuyLichHen" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="LichHenId" id="cancelLichHenId" />

                <div class="modal-header bg-danger text-white border-0 p-3">
                    <h5 class="modal-title fw-bold m-0" id="staffCancelModalLabel">
                        <i class="fa-solid fa-ban me-2"></i>Hủy lịch hẹn
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">Xác nhận hủy lịch hẹn <strong id="cancelMaLichHen" class="text-danger"></strong>. Khách hàng và Admin sẽ nhận được thông báo ngay lập tức.</p>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Lý do hủy lịch <span class="text-danger">*</span></label>
                        <textarea name="LyDo" class="form-control rounded-3" rows="3" required placeholder="Vui lòng nhập lý do hủy lịch hẹn..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-secondary px-3 rounded-3" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger px-4 rounded-3 fw-bold"><i class="fa-solid fa-trash me-1"></i> Xác nhận hủy</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Bootstrap Tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            tooltipTriggerList.map(function (el) { return new bootstrap.Tooltip(el); });

            // AJAX submit cho Modal Yêu cầu đổi lịch
            const rescheduleForm = document.getElementById('rescheduleForm');
            if (rescheduleForm) {
                rescheduleForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    submitFormAjax(this, 'rescheduleModal');
                });
            }

            // AJAX submit cho Modal Hủy lịch
            const staffCancelForm = document.getElementById('staffCancelForm');
            if (staffCancelForm) {
                staffCancelForm.addEventListener('submit', function (e) {
                    e.preventDefault();
                    submitFormAjax(this, 'staffCancelModal');
                });
            }
        });

        function submitFormAjax(form, modalId) {
            const formData = new FormData(form);
            const submitBtn = form.querySelector('button[type="submit"]');
            if (submitBtn) submitBtn.disabled = true;

            fetch(form.action, {
                method: 'POST',
                body: formData,
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            })
            .then(res => res.json())
            .then(data => {
                const modalEl = document.getElementById(modalId);
                if (modalEl && bootstrap.Modal) {
                    const instance = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                    instance.hide();
                }

                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công!',
                        text: data.message || 'Thao tác thành công.',
                        timer: 2000,
                        showConfirmButton: false
                    }).then(() => window.location.reload());
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: data.message || 'Có lỗi xảy ra, vui lòng thử lại.'
                    });
                }
            })
            .catch(err => {
                Swal.fire({ icon: 'error', title: 'Lỗi kết nối', text: 'Không thể kết nối đến máy chủ.' });
            })
            .finally(() => {
                if (submitBtn) submitBtn.disabled = false;
            });
        }

        function openStaffDetailModal(id) {
            const modalEl = document.getElementById('staffDetailModal');
            const bodyEl = document.getElementById('staffDetailModalBody');
            bodyEl.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-danger" role="status"></div></div>';

            const modalInstance = new bootstrap.Modal(modalEl);
            modalInstance.show();

            fetch('/NhanVien/LichHen/GetDetail/' + id)
                .then(res => res.json())
                .then(res => {
                    if (!res.success) {
                        bodyEl.innerHTML = '<div class="alert alert-danger mb-0">' + res.message + '</div>';
                        return;
                    }
                    const d = res.data;
                    let historyHtml = '';
                    if (d.lichSuChanges && d.lichSuChanges.length > 0) {
                        historyHtml = d.lichSuChanges.map(h => `
                            <div class="border-start border-2 border-primary ps-3 pb-2 mb-2">
                                <div class="small fw-bold text-dark">${h.nguoiThucHien} <span class="text-muted fw-normal">(${new Date(h.thoiGian).toLocaleString('vi-VN')})</span></div>
                                <div class="small text-primary">${h.hanHDong}</div>
                                <div class="small text-muted">${h.noiDung}</div>
                            </div>
                        `).join('');
                    } else {
                        historyHtml = '<div class="small text-muted">Chưa ghi nhận lịch sử thay đổi.</div>';
                    }

                    bodyEl.innerHTML = `
                        <div class="row g-3">
                            <div class="col-md-6 border-end">
                                <h6 class="fw-bold text-danger border-bottom pb-2 mb-3"><i class="fa-solid fa-calendar-check me-1"></i>Thông Tin Lịch Hẹn</h6>
                                <div class="mb-2"><span class="text-muted small d-block">Mã Lịch Hẹn:</span><strong class="text-dark">${d.maLichHen}</strong></div>
                                <div class="mb-2"><span class="text-muted small d-block">Thời Gian Hẹn:</span><span class="fw-bold text-danger">${d.ngayHen || '--'} (${d.gioBatDau || '--'} - ${d.gioKetThuc || '--'})</span></div>
                                <div class="mb-2"><span class="text-muted small d-block">Hình Thức:</span><span class="badge bg-light text-dark border">${d.hinhThuc}</span></div>
                                <div class="mb-2"><span class="text-muted small d-block">Địa Điểm:</span><span class="text-dark">${d.diaDiem || 'Tại chỗ'}</span></div>
                                <div class="mb-2"><span class="text-muted small d-block">Trạng Thái:</span><span class="badge ${d.trangThaiBadgeClass}">${d.trangThaiTitle}</span></div>
                                ${d.ghiChu ? `<div class="mb-2"><span class="text-muted small d-block">Ghi Chú:</span><span class="text-dark">${d.ghiChu}</span></div>` : ''}
                                ${d.lyDo ? `<div class="mb-2"><span class="text-muted small d-block">Lý Do / Ghi Chú Đổi/Hủy:</span><span class="text-danger">${d.lyDo}</span></div>` : ''}
                            </div>
                            <div class="col-md-6">
                                <h6 class="fw-bold text-danger border-bottom pb-2 mb-3"><i class="fa-solid fa-user me-1"></i>Thông Tin Khách Hàng & Phiếu</h6>
                                <div class="mb-2"><span class="text-muted small d-block">Khách Hàng:</span><strong class="text-dark">${d.tenKhachHang}</strong></div>
                                <div class="mb-2"><span class="text-muted small d-block">Số Điện Thoại:</span><span>${d.soDienThoaiKhachHang || 'Chưa cập nhật'}</span></div>
                                <div class="mb-2"><span class="text-muted small d-block">Email:</span><span>${d.emailKhachHang || '—'}</span></div>
                                <div class="mb-2"><span class="text-muted small d-block">Phiếu Hỗ Trợ:</span><strong class="text-primary">${d.maPhieu}</strong> - ${d.tieuDePhieu}</div>
                                <div class="mb-2"><span class="text-muted small d-block">Dịch Vụ:</span><span>${d.tenDichVu}</span></div>
                            </div>
                            <div class="col-12 mt-3 pt-3 border-top">
                                <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-clock-rotate-left me-1"></i>Lịch Sử Thay Đổi</h6>
                                ${historyHtml}
                            </div>
                        </div>
                    `;
                })
                .catch(err => {
                    bodyEl.innerHTML = '<div class="alert alert-danger mb-0">Lỗi nạp dữ liệu chi tiết.</div>';
                });
        }

        function openRescheduleModal(id, maLH, ngayHen, gioBD, gioKT, diaDiem) {
            document.getElementById('rescheduleLichHenId').value = id;
            document.getElementById('rescheduleMaLichHen').innerText = maLH;
            document.getElementById('rescheduleOldInfo').innerHTML = `Ngày: <strong>${ngayHen}</strong> (${gioBD} - ${gioKT}) | Địa điểm: <strong>${diaDiem}</strong>`;
            document.getElementById('rescheduleDiaDiemMoi').value = diaDiem;

            const modal = new bootstrap.Modal(document.getElementById('rescheduleModal'));
            modal.show();
        }

        function openStaffCancelModal(id, maLH) {
            document.getElementById('cancelLichHenId').value = id;
            document.getElementById('cancelMaLichHen').innerText = maLH;

            const modal = new bootstrap.Modal(document.getElementById('staffCancelModal'));
            modal.show();
        }
    </script>
}
