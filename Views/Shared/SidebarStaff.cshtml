@using Microsoft.AspNetCore.Http
@using System.Security.Claims
@using SupportTicketSysterm.Data
@inject TechSupportContext DbContext
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var userIdStr = User.FindFirstValue(ClaimTypes.NameIdentifier) 
                    ?? User.FindFirstValue("UserId") 
                    ?? Context.Session?.GetInt32("UserId")?.ToString();

    string hoTen = Context.Session?.GetString("HoTen") ?? User.FindFirstValue("HoTen") ?? User.FindFirstValue(ClaimTypes.Name) ?? User.Identity?.Name ?? "";
    string vaiTro = Context.Session?.GetString("Role") ?? Context.Session?.GetString("VaiTro") ?? User.FindFirstValue(ClaimTypes.Role) ?? User.FindFirstValue("VaiTro") ?? "";

    if (int.TryParse(userIdStr, out int nhanVienId) && nhanVienId > 0)
    {
        var staffDb = DbContext.NhanViens.FirstOrDefault(x => x.IdNhanVien == nhanVienId);
        if (staffDb != null)
        {
            if (string.IsNullOrEmpty(hoTen)) hoTen = staffDb.HoTen?.Trim() ?? "";
            if (string.IsNullOrEmpty(vaiTro)) vaiTro = staffDb.VaiTro?.Trim() ?? "";
        }
    }

    if (string.IsNullOrEmpty(hoTen)) hoTen = "Nhân viên";
    if (string.IsNullOrEmpty(vaiTro)) vaiTro = "NhanVien";

    bool isAdmin = vaiTro.Equals("Admin", StringComparison.OrdinalIgnoreCase) || vaiTro.Equals("Quản trị viên", StringComparison.OrdinalIgnoreCase);
    var vaiTroVn = isAdmin ? "Quản trị viên" : "Nhân viên hỗ trợ";
}

<!-- ============================================================
     ADMIN SIDEBAR COMPONENT — TechSupport Viettel
     ============================================================ -->
<aside class="admin-sidebar offcanvas-lg offcanvas-start" tabindex="-1" id="adminSidebar" aria-labelledby="adminSidebarLabel">

    <!-- Offcanvas Header (Mobile/Tablet only) -->
    <div class="offcanvas-header d-lg-none border-bottom py-3 px-4" style="background-color: #111827; border-bottom-color: rgba(255,255,255,0.07) !important;">
        <div class="d-flex align-items-center">
            <i class="fa-solid fa-headset me-2 fs-4" style="color: #EE0033;"></i>
            <div>
                <span class="fw-bold fs-6" style="color: #FFFFFF;" id="adminSidebarLabel">@hoTen</span>
                <small class="d-block" style="font-size: 0.65rem; font-weight: 500; letter-spacing: 0.5px; color: rgba(255,255,255,0.5);">@vaiTroVn</small>
            </div>
        </div>
        <button type="button" class="btn-close btn-close-white text-reset" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

    <!-- Sidebar Brand Logo (Desktop only) -->
    <a asp-controller="Staff" asp-action="Dashboard" class="sidebar-brand d-none d-lg-flex">
        <i class="fa-solid fa-headset"></i>
        <span>
            TechSupport <small style="display:block;font-size:0.65rem;font-weight:400;letter-spacing:1px;color:rgba(255,255,255,0.5);">
                VIETTEL ADMIN
            </small>
        </span>
    </a>

    <!-- Sidebar Menu -->
    <nav aria-label="Primary navigation">
        <ul class="sidebar-menu">

            <li class="sidebar-section-label">TỔNG QUAN</li>
            <li class="sidebar-item @(currentController.Equals("Staff", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("Dashboard", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <a asp-controller="Staff" asp-action="Dashboard" class="sidebar-link">
                    <i class="fa-solid fa-gauge-high"></i>
                    <span>Dashboard</span>
                </a>
            </li>

            <li class="sidebar-section-label">QUẢN LÝ</li>

            @if (isAdmin)
            {
                <!-- Quản lý Danh mục (Admin) -->
                <li class="sidebar-item @(currentController.Equals("Staff", StringComparison.OrdinalIgnoreCase) && (currentAction.Equals("QuanLyDanhMuc", StringComparison.OrdinalIgnoreCase) || currentAction.Equals("DanhSachDanhMuc", StringComparison.OrdinalIgnoreCase)) ? "active" : "")">
                    <a asp-controller="Staff" asp-action="QuanLyDanhMuc" class="sidebar-link">
                        <i class="fa-solid fa-layer-group"></i>
                        <span>Quản lý Danh mục</span>
                    </a>
                </li>

                <!-- Quản lý Dịch vụ (Admin) -->
                <li class="sidebar-item @(currentController.Equals("Staff", StringComparison.OrdinalIgnoreCase) && (currentAction.Equals("QuanLyDichVu", StringComparison.OrdinalIgnoreCase) || currentAction.Equals("DanhSachDichVu", StringComparison.OrdinalIgnoreCase)) ? "active" : "")">
                    <a asp-controller="Staff" asp-action="QuanLyDichVu" class="sidebar-link">
                        <i class="fa-solid fa-network-wired"></i>
                        <span>Quản lý Dịch vụ</span>
                    </a>
                </li>
            }

            <!-- Quản lý Phiếu hỗ trợ (Admin & Nhân viên) -->
            <li class="sidebar-item @((currentController.Equals("Staff", StringComparison.OrdinalIgnoreCase) && (currentAction.Equals("QuanLyPhieuHoTro", StringComparison.OrdinalIgnoreCase) || currentAction.Equals("QuanLyPhieu", StringComparison.OrdinalIgnoreCase) || currentAction.Equals("ChiTietPhieuHoTro", StringComparison.OrdinalIgnoreCase))) || currentController.Equals("Ticket", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <a asp-controller="Staff" asp-action="QuanLyPhieuHoTro" class="sidebar-link">
                    <i class="fa-solid fa-ticket"></i>
                    <span>Quản lý Phiếu hỗ trợ</span>
                </a>
            </li>

            <!-- Quản lý Lịch hẹn (Admin & Nhân viên) -->
            <li class="sidebar-item @(currentController.Equals("AdminLichHen", StringComparison.OrdinalIgnoreCase) || currentController.Equals("NhanVienLichHen", StringComparison.OrdinalIgnoreCase) || currentController.Equals("StaffLichHen", StringComparison.OrdinalIgnoreCase) || (currentController.Equals("Staff", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("QuanLyLichHen", StringComparison.OrdinalIgnoreCase)) ? "active" : "")">
                @if (isAdmin)
                {
                    <a href="/Admin/LichHen/Index" class="sidebar-link">
                        <i class="fa-solid fa-calendar-days"></i>
                        <span>Quản lý Lịch hẹn</span>
                    </a>
                }
                else
                {
                    <a asp-controller="Staff" asp-action="QuanLyLichHen" class="sidebar-link">
                        <i class="fa-solid fa-calendar-days"></i>
                        <span>Quản lý Lịch hẹn</span>
                    </a>
                }
            </li>

            <!-- Quản lý Khách hàng (Admin & Nhân viên) -->
            <li class="sidebar-item @(currentController.Equals("Staff", StringComparison.OrdinalIgnoreCase) && (currentAction.Equals("QuanLyKH", StringComparison.OrdinalIgnoreCase) || currentAction.Equals("DanhSachKhachHang", StringComparison.OrdinalIgnoreCase) || currentAction.Equals("ChiTietKH", StringComparison.OrdinalIgnoreCase)) ? "active" : "")">
                <a asp-controller="Staff" asp-action="QuanLyKH" class="sidebar-link">
                    <i class="fa-solid fa-users"></i>
                    <span>Quản lý Khách hàng</span>
                </a>
            </li>

            @if (isAdmin)
            {
                <!-- Quản lý Nhân viên (Admin) -->
                <li class="sidebar-item @(currentController.Equals("Staff", StringComparison.OrdinalIgnoreCase) && (currentAction.Equals("QuanLyNhanVien", StringComparison.OrdinalIgnoreCase) || currentAction.Equals("ChiTietNhanVien", StringComparison.OrdinalIgnoreCase)) ? "active" : "")">
                    <a asp-controller="Staff" asp-action="QuanLyNhanVien" class="sidebar-link">
                        <i class="fa-solid fa-users-gear"></i>
                        <span>Quản lý Nhân viên</span>
                    </a>
                </li>
            }

            <!-- Phản hồi đánh giá (Admin & Nhân viên) -->
            <li class="sidebar-item @(currentController.Equals("Staff", StringComparison.OrdinalIgnoreCase) && (currentAction.Equals("DanhSachDanhGia", StringComparison.OrdinalIgnoreCase) || currentAction.Equals("DanhGiaKhachHang", StringComparison.OrdinalIgnoreCase)) || currentController.Equals("DanhGia", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <a asp-controller="Staff" asp-action="DanhSachDanhGia" class="sidebar-link">
                    <i class="fa-solid fa-star"></i>
                    <span>Phản hồi đánh giá</span>
                </a>
            </li>

            <!-- Hỗ trợ trực tuyến (Admin & Nhân viên) -->
            <li class="sidebar-item @(currentController.Equals("Chat", StringComparison.OrdinalIgnoreCase) || currentController.Equals("LiveSupport", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <a asp-controller="Chat" asp-action="Index" class="sidebar-link">
                    <i class="fa-solid fa-comments"></i>
                    <span>Hỗ trợ trực tuyến</span>
                </a>
            </li>

            @if (isAdmin)
            {
                <!-- Thống kê báo cáo (Admin) -->
                <li class="sidebar-item @(currentController.Equals("Staff", StringComparison.OrdinalIgnoreCase) && (currentAction.Equals("ThongKeBaoCao", StringComparison.OrdinalIgnoreCase) || currentAction.Equals("BaoCaoThongKe", StringComparison.OrdinalIgnoreCase)) ? "active" : "")">
                    <a asp-controller="Staff" asp-action="ThongKeBaoCao" class="sidebar-link">
                        <i class="fa-solid fa-chart-line"></i>
                        <span>Thống kê báo cáo</span>
                    </a>
                </li>
            }

            <li class="sidebar-section-label">TÀI KHOẢN</li>
            <li class="sidebar-item @(currentController.Equals("Staff", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("TaiKhoanNhanVien", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <a asp-controller="Staff" asp-action="TaiKhoanNhanVien" class="sidebar-link">
                    <i class="fa-solid fa-id-card"></i>
                    <span>Thông tin cá nhân</span>
                </a>
            </li>
            <li class="sidebar-item @(currentController.Equals("Staff", StringComparison.OrdinalIgnoreCase) && currentAction.Equals("DoiMatKhau", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <a asp-controller="Staff" asp-action="DoiMatKhau" class="sidebar-link">
                    <i class="fa-solid fa-key"></i>
                    <span>Đổi mật khẩu</span>
                </a>
            </li>
        </ul>
    </nav>
</aside>
